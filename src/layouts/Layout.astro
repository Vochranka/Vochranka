---
import "../styles/global.css";
import { SITE_CONFIG } from "@/data/siteConfig";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = SITE_CONFIG.metaTitle,
  description = SITE_CONFIG.metaDescription,
} = Astro.props;
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Google Fonts: Inter Tight & Plus Jakarta Sans with full Czech/Latin-Extended support -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,100..900;1,100..900&family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&display=swap&subset=latin,latin-ext"
      rel="stylesheet"
    />
  </head>
  <body
    class="flex min-h-screen flex-col bg-canvas text-ink antialiased selection:bg-accent selection:text-white"
  >
    <slot />
  </body>
</html>
