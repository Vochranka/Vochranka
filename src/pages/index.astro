---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import StatsBar from "../components/StatsBar.astro";
import ProductShowcase from "../components/ProductShowcase.astro";
import AlwaysWithinReach from "../components/AlwaysWithinReach.astro";
import Placement from "../components/Placement.astro";
import Installation from "../components/Installation.astro";
import Pricing from "../components/Pricing.astro";
import OrderForm from "../components/OrderForm.astro";
import Faq from "../components/Faq.astro";
import Footer from "../components/Footer.astro";
import MobileStickyBar from "../components/MobileStickyBar.astro";
---

<Layout>
  <!-- Global Sticky / Fixed Navigation -->
  <Navbar />

  <!-- Main Landing Page Content matching the mock-up -->
  <main class="w-full overflow-x-hidden">
    <!-- 1. Hero: OBTĚŽOVAL VÁS NĚKDO V ORDINACI? (s rotujícím místem) -->
    <Hero />

    <!-- 2. Stats Bar: 2 s | 24/7 | 14 dní -->
    <StatsBar />

    <!-- 3. OKAMŽITÁ POMOC NA JEDNO STISKNUTÍ -->
    <ProductShowcase />

    <!-- 4. VŽDY NA DOSAH (Panoramic dark section) -->
    <AlwaysWithinReach />

    <!-- 5. Nespočet možností kam tlačítko umístit (Staggered photo cards) -->
    <Placement />

    <!-- 6. Zapojit / Přicvaknout / Otestovat & OBJEDNAT SADU -->
    <Installation />

    <!-- 7. Ceník + Kontakt -->
    <section
      id="cenik"
      class="bg-white select-none py-16 sm:py-24 lg:py-28 px-6 sm:px-[5.5%] border-t border-line/60"
      aria-label="Ceník a kontakt"
    >
      <div class="max-w-7xl mx-auto relative">
        <div
          class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-0 items-start"
        >
          <Pricing />
          <OrderForm />
        </div>

        <!-- Svislá dělicí čára přesně uprostřed -->
        <div
          class="hidden lg:block absolute left-1/2 top-0 bottom-0 w-px bg-line -translate-x-1/2"
          aria-hidden="true"
        >
        </div>
      </div>
    </section>

    <!-- 9. Často kladené otázky (Minimalist accordion) -->
    <Faq />
  </main>

  <!-- 10. Footer -->
  <Footer />

  <!-- 11. Mobile Sticky Bottom CTA Bar -->
  <MobileStickyBar />
</Layout>
