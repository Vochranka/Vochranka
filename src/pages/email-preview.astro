---
// src/pages/email-preview.astro - Náhled a správa šablony e-mailu pro Vochranku
---

<!DOCTYPE html>
<html lang="cs" class="h-full bg-[#1A1614] text-[#EBE6E2]">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Náhled e-mailové šablony | Vochranka</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter+Tight:wght@600;700;800&display=swap" rel="stylesheet" />
  <style>
    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    }
    .custom-scrollbar::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: #231E1B;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #443B36;
      border-radius: 3px;
    }
  </style>
</head>
<body class="h-full flex flex-col overflow-hidden">

  <!-- Top Bar -->
  <header class="h-16 shrink-0 bg-[#241D19] border-b border-[#3B322C] px-4 sm:px-6 flex items-center justify-between z-20">
    <div class="flex items-center gap-3">
      <a href="/" class="flex items-center gap-2 text-white font-extrabold tracking-wider text-sm sm:text-base hover:opacity-80 transition-opacity">
        <span class="w-2.5 h-2.5 rounded-full bg-[#A2623A]"></span>
        VOCHRANKA
      </a>
      <span class="text-[#6D635C] text-sm">/</span>
      <h1 class="text-xs sm:text-sm font-semibold text-[#D5CFC9]">E-mailová šablona (Follow-up)</h1>
      <span class="hidden md:inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-[#A2623A]/20 text-[#D8936A] border border-[#A2623A]/30">
        Responzivní HTML
      </span>
    </div>

    <!-- View Switcher & Action Buttons -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Device Switcher -->
      <div class="flex items-center bg-[#181412] p-1 rounded-lg border border-[#382F2A]">
        <button id="btn-desktop" type="button" class="px-2.5 sm:px-3 py-1 rounded text-xs font-semibold bg-[#A2623A] text-white shadow transition-all flex items-center gap-1.5" title="Zobrazit jako Desktop (600px)">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/></svg>
          <span class="hidden sm:inline">Desktop</span>
        </button>
        <button id="btn-mobile" type="button" class="px-2.5 sm:px-3 py-1 rounded text-xs font-semibold text-[#A69E98] hover:text-white transition-all flex items-center gap-1.5" title="Zobrazit jako Mobil (375px)">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="14" height="20" x="5" y="2" rx="2"/><line x1="12" x2="12.01" y1="18" y2="18"/></svg>
          <span class="hidden sm:inline">Mobil</span>
        </button>
      </div>

      <!-- Copy HTML Button -->
      <button id="btn-copy-html" type="button" class="px-3.5 py-1.5 rounded-lg text-xs font-bold bg-[#A2623A] hover:bg-[#8B5330] text-white transition-all shadow-md flex items-center gap-1.5 cursor-pointer active:scale-95">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
        <span id="copy-html-text">Kopírovat HTML</span>
      </button>

      <!-- Copy Plain Text Button -->
      <button id="btn-copy-text" type="button" class="hidden sm:flex px-3 py-1.5 rounded-lg text-xs font-semibold bg-[#2E2520] hover:bg-[#3D322B] text-[#D5CFC9] hover:text-white border border-[#443831] transition-all items-center gap-1.5 cursor-pointer">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        <span id="copy-text-text">Čistý text</span>
      </button>

      <!-- Open in new tab -->
      <a href="/email/email-template.html" target="_blank" class="p-1.5 rounded-lg text-[#A69E98] hover:text-white hover:bg-[#2E2520] transition-colors" title="Otevřít čisté HTML v novém okně">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
      </a>
    </div>
  </header>

  <!-- Main Content Layout (Sidebar details + Live Iframe Preview) -->
  <div class="flex-1 flex flex-col lg:flex-row overflow-hidden">
    
    <!-- Left Sidebar: Email Metadata, Subject Variations & Tips -->
    <aside class="w-full lg:w-96 shrink-0 bg-[#1E1916] border-b lg:border-b-0 lg:border-r border-[#332A24] p-5 overflow-y-auto custom-scrollbar flex flex-col gap-6">
      
      <!-- Subject Line Selector -->
      <div>
        <label class="block text-[11px] font-bold uppercase tracking-wider text-[#9E948C] mb-2">
          Doporučené předměty e-mailu:
        </label>
        <div class="flex flex-col gap-2">
          <!-- Subject 1 -->
          <div class="subject-card p-3 rounded-xl bg-[#28211C] border border-[#3D332C] hover:border-[#A2623A]/50 transition-colors cursor-pointer group" data-subject="Navázání na náš rozhovor – bezpečí při práci (Vochranka)">
            <div class="flex items-center justify-between text-xs text-[#D8936A] font-semibold mb-1">
              <span>Varianta 1 (Doporučeno)</span>
              <span class="text-[10px] opacity-0 group-hover:opacity-100 transition-opacity text-[#A69E98]">Kopírovat</span>
            </div>
            <p class="text-xs text-white font-medium leading-snug">
              Navázání na náš rozhovor – bezpečí při práci (Vochranka)
            </p>
          </div>

          <!-- Subject 2 -->
          <div class="subject-card p-3 rounded-xl bg-[#28211C] border border-[#3D332C] hover:border-[#A2623A]/50 transition-colors cursor-pointer group" data-subject="Bezpečnější pocit při každé směně – Vochranka">
            <div class="flex items-center justify-between text-xs text-[#9E948C] font-semibold mb-1">
              <span>Varianta 2 (Brandová)</span>
              <span class="text-[10px] opacity-0 group-hover:opacity-100 transition-opacity text-[#A69E98]">Kopírovat</span>
            </div>
            <p class="text-xs text-[#D5CFC9] font-medium leading-snug">
              Bezpečnější pocit při každé směně – Vochranka
            </p>
          </div>

          <!-- Subject 3 -->
          <div class="subject-card p-3 rounded-xl bg-[#28211C] border border-[#3D332C] hover:border-[#A2623A]/50 transition-colors cursor-pointer group" data-subject="K našemu krátkému povídání o bezpečnosti ve vašem provozu">
            <div class="flex items-center justify-between text-xs text-[#9E948C] font-semibold mb-1">
              <span>Varianta 3 (Provozovna)</span>
              <span class="text-[10px] opacity-0 group-hover:opacity-100 transition-opacity text-[#A69E98]">Kopírovat</span>
            </div>
            <p class="text-xs text-[#D5CFC9] font-medium leading-snug">
              K našemu krátkému povídání o bezpečnosti ve vašem provozu
            </p>
          </div>
        </div>
      </div>

      <!-- Preheader snippet -->
      <div>
        <label class="block text-[11px] font-bold uppercase tracking-wider text-[#9E948C] mb-1.5">
          Náhledový text (Preheader v inboxu):
        </label>
        <div class="p-2.5 rounded-lg bg-[#241D19] border border-[#352B25] text-xs text-[#A69E98] leading-relaxed">
          Diskrétní tlačítko, odstrašující siréna a nouzová SMS blízkým do 2 vteřin. Bez vrtání a kabelů.
        </div>
      </div>

      <!-- Key Specs Checklist -->
      <div class="pt-2 border-t border-[#332A24]">
        <label class="block text-[11px] font-bold uppercase tracking-wider text-[#9E948C] mb-2.5">
          Vlastnosti šablony:
        </label>
        <ul class="text-xs space-y-2 text-[#C0B8B2]">
          <li class="flex items-start gap-2">
            <span class="text-[#A2623A] font-bold">✓</span>
            <span>Tabulkový layout (100% kompatibilita Outlook, Apple Mail, Gmail)</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-[#A2623A] font-bold">✓</span>
            <span>Plně responzivní na mobilech (stohování sloupců & touch CTA)</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-[#A2623A] font-bold">✓</span>
            <span>Optimalizované obrázky (celkem &lt; 90 kB, rychlé načítání)</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-[#A2623A] font-bold">✓</span>
            <span>VML tlačítko pro zachování zaoblení a barvy v Outlooku</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-[#A2623A] font-bold">✓</span>
            <span>Autentický osobní podpis Chiheba s kontaktem</span>
          </li>
        </ul>
      </div>

      <!-- Quick Tips for Sending -->
      <div class="p-3.5 rounded-xl bg-[#28211C] border border-[#3B322C] text-xs text-[#A69E98] space-y-1.5">
        <strong class="text-white block font-semibold">Tip k odesílání:</strong>
        <p class="leading-relaxed">
          Pro 1-on-1 zprávy přímo z vašeho e-mailu můžete použít tlačítko <strong>„Čistý text“</strong>. Pro hromadné odesílání (Ecomail, Mailchimp, Brevo) vložte zkopírované <strong>HTML</strong>.
        </p>
      </div>

    </aside>

    <!-- Right Area: Interactive Preview Frame -->
    <main class="flex-1 bg-[#14100E] p-4 sm:p-8 flex items-center justify-center overflow-auto custom-scrollbar">
      
      <!-- Frame Container with smooth transition -->
      <div id="preview-wrapper" class="w-full max-w-[620px] h-[92vh] max-h-[880px] bg-white rounded-2xl shadow-2xl overflow-hidden transition-all duration-300 border border-[#3D332C]/60 flex flex-col">
        
        <!-- Browser / Device Mockup Bar -->
        <div class="h-8 bg-[#2A211D] px-4 flex items-center justify-between shrink-0 border-b border-[#3B322C]">
          <div class="flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 rounded-full bg-[#FF5F56]/80"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-[#FFBD2E]/80"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-[#27C93F]/80"></span>
          </div>
          <span id="frame-size-label" class="text-[10px] font-mono text-[#8C847E]">
            600px &times; 100% (Desktop)
          </span>
          <div class="w-10"></div>
        </div>

        <!-- The actual email rendered in an iframe -->
        <iframe
          id="email-frame"
          src="/email/email-standalone.html"
          class="w-full flex-1 border-0 bg-[#F4F3F0]"
          title="Náhled e-mailu Vochranka"
        ></iframe>

      </div>

    </main>

  </div>

  <!-- Notification Toast -->
  <div id="toast" class="fixed bottom-6 right-6 z-50 transform translate-y-16 opacity-0 pointer-events-none transition-all duration-200 bg-[#A2623A] text-white px-4 py-2.5 rounded-xl font-medium text-xs shadow-xl flex items-center gap-2">
    <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
    <span id="toast-message">Zkopírováno do schránky</span>
  </div>

  <script>
    // Elements
    const btnDesktop = document.getElementById("btn-desktop");
    const btnMobile = document.getElementById("btn-mobile");
    const previewWrapper = document.getElementById("preview-wrapper");
    const frameSizeLabel = document.getElementById("frame-size-label");
    const btnCopyHtml = document.getElementById("btn-copy-html");
    const btnCopyText = document.getElementById("btn-copy-text");
    const copyHtmlText = document.getElementById("copy-html-text");
    const copyTextText = document.getElementById("copy-text-text");
    const toast = document.getElementById("toast");
    const toastMessage = document.getElementById("toast-message");
    const subjectCards = document.querySelectorAll(".subject-card");

    function showToast(msg: string) {
      if (!toast || !toastMessage) return;
      toastMessage.textContent = msg;
      toast.classList.remove("translate-y-16", "opacity-0", "pointer-events-none");
      setTimeout(() => {
        toast.classList.add("translate-y-16", "opacity-0", "pointer-events-none");
      }, 2500);
    }

    // Toggle Desktop / Mobile view
    btnDesktop?.addEventListener("click", () => {
      if (!previewWrapper || !frameSizeLabel || !btnDesktop || !btnMobile) return;
      previewWrapper.className = "w-full max-w-[620px] h-[92vh] max-h-[880px] bg-white rounded-2xl shadow-2xl overflow-hidden transition-all duration-300 border border-[#3D332C]/60 flex flex-col";
      frameSizeLabel.textContent = "600px × 100% (Desktop)";
      btnDesktop.className = "px-2.5 sm:px-3 py-1 rounded text-xs font-semibold bg-[#A2623A] text-white shadow transition-all flex items-center gap-1.5";
      btnMobile.className = "px-2.5 sm:px-3 py-1 rounded text-xs font-semibold text-[#A69E98] hover:text-white transition-all flex items-center gap-1.5";
    });

    btnMobile?.addEventListener("click", () => {
      if (!previewWrapper || !frameSizeLabel || !btnDesktop || !btnMobile) return;
      previewWrapper.className = "w-full max-w-[390px] h-[92vh] max-h-[840px] bg-white rounded-2xl shadow-2xl overflow-hidden transition-all duration-300 border border-[#3D332C]/60 flex flex-col";
      frameSizeLabel.textContent = "375px × 100% (Mobil)";
      btnMobile.className = "px-2.5 sm:px-3 py-1 rounded text-xs font-semibold bg-[#A2623A] text-white shadow transition-all flex items-center gap-1.5";
      btnDesktop.className = "px-2.5 sm:px-3 py-1 rounded text-xs font-semibold text-[#A69E98] hover:text-white transition-all flex items-center gap-1.5";
    });

    // Copy Raw HTML
    btnCopyHtml?.addEventListener("click", async () => {
      try {
        const response = await fetch("/email/email-template.html");
        const html = await response.text();
        await navigator.clipboard.writeText(html);
        if (copyHtmlText) copyHtmlText.textContent = "Zkopírováno!";
        showToast("HTML šablona zkopírována do schránky!");
        setTimeout(() => {
          if (copyHtmlText) copyHtmlText.textContent = "Kopírovat HTML";
        }, 2000);
      } catch (err) {
        showToast("Nepodařilo se zkopírovat HTML.");
      }
    });

    // Copy Plain Text
    btnCopyText?.addEventListener("click", async () => {
      try {
        const response = await fetch("/email/email-plain-text.txt");
        const text = await response.text();
        await navigator.clipboard.writeText(text);
        if (copyTextText) copyTextText.textContent = "Zkopírováno!";
        showToast("Čistý text zkopírován do schránky!");
        setTimeout(() => {
          if (copyTextText) copyTextText.textContent = "Čistý text";
        }, 2000);
      } catch (err) {
        showToast("Nepodařilo se zkopírovat text.");
      }
    });

    // Click on subject line copies to clipboard
    subjectCards.forEach((card) => {
      card.addEventListener("click", async () => {
        const subject = card.getAttribute("data-subject");
        if (subject) {
          await navigator.clipboard.writeText(subject);
          showToast(`Předmět zkopírován: „${subject.substring(0, 32)}…“`);
        }
      });
    });
  </script>
</body>
</html>
