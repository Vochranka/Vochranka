---
// src/components/PlugAndPlay.astro

const installSteps = [
  {
    num: "1",
    title: "Zapojit",
    desc: "Zasunete sirénu a bránu do zásuvky. Okamžitě se spáruje se systémem.",
    image: "/step1-zapojit.jpg",
    alt: "Zapojení sirény do zásuvky",
  },
  {
    num: "2",
    title: "Přicvaknout",
    desc: "Nalepíte destičku pod stůl. Tlačítko na ní drží silným magnetem.",
    image: "/step2-umistit.jpg",
    alt: "Umístění tísňového tlačítka pod stůl či lehátko",
  },
  {
    num: "3",
    title: "Otestovat",
    desc: "Dvojklikem otestujete sirénu i doručení SMS vybraným kontaktům.",
    image: "/step3-otestovat.jpg",
    alt: "Otestování sirény a přijetí zkušební SMS na telefonu",
  },
];
---

<section
  id="instalace"
  class="pt-20 pb-8 bg-zinc-50 relative"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- 1. Header sekce: Rychlost instalace -->
    <div class="max-w-3xl mx-auto text-center mb-16">
      <div class="inline-flex items-center">
        <span
          class="text-xs font-mono tracking-[0.2em] text-zinc-400 uppercase font-medium block mb-3"
        >
          INSTALACE BĚHEM 2 MINUT
        </span>
      </div>
      <h2
        class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-zinc-950"
      >
        Žádné vrtání, žádné kabely. <br />
      </h2>
      <p
        class="text-base sm:text-lg text-zinc-600 mt-4 leading-relaxed max-w-2xl mx-auto"
      >
        K instalaci nepotřebujete nářadí, techniky ani složité nastavování.
        <span class="font-bold"
          >Vše dodáváme připravené k okamžitému provozu.</span
        >
      </p>
    </div>

    <!-- 2. 3 KROKY INSTALACE (Fotka nahoře + popis dole) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      {
        installSteps.map((step) => (
          <div class="rounded-3xl bg-white border border-zinc-200/90 shadow-sm overflow-hidden flex flex-col hover:border-zinc-300 hover:shadow-md transition-all duration-300 group">
            <!-- Nahoře: Fotka kroku (čistá bez pilulky) -->
            <div class="relative w-full aspect-[4/3] bg-zinc-100 overflow-hidden">
              <img
                src={step.image}
                alt={step.alt}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                loading="lazy"
              />
            </div>

            <!-- Dole: Popis -->
            <div class="p-6 sm:p-7 flex flex-col justify-between flex-1">
              <div>
                <span class="text-[11px] font-mono font-semibold tracking-wider text-zinc-400 block mb-1">
                  KROK 0{step.num}
                </span>
                <h3 class="text-xl font-bold tracking-tight text-zinc-950 mb-2">
                  {step.title}
                </h3>
                <p class="text-sm text-zinc-600 leading-relaxed">
                  {step.desc}
                </p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- 3. VARIABILITA UCHYCENÍ -->
<section class="py-14 bg-zinc-50/70 border-t border-zinc-200/70 relative">
  <div class="max-w-6xl mx-auto px-6">
    
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-end mb-10">
      <div class="md:col-span-7">
        <span class="text-[11px] font-mono uppercase tracking-[0.18em] text-zinc-400 font-semibold mb-2 block">
          Variabilita uchycení
        </span>
        <h3 class="text-2xl md:text-3xl font-bold tracking-tight text-zinc-950">
          Drží pevně. Zůstává stále mobilní.
        </h3>
      </div>
      <div class="md:col-span-5">
        <p class="text-xs text-zinc-600 leading-relaxed">
          3M páskou nalepíte pouze tenkou kovovou destičku. Samotné tlačítko na ní drží silným magnetem a můžete ho kdykoliv vzít s sebou.
        </p>
      </div>
    </div>

    <div class="pt-8 border-t border-zinc-200/70 grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-zinc-200/70">
      
      <!-- 01 -->
      <div class="py-5 md:py-0 md:pr-8">
        <span class="text-[11px] font-mono font-medium text-zinc-400 tracking-wider uppercase block mb-1">
          01 / Pult & stůl
        </span>
        <h4 class="text-base font-bold tracking-tight text-zinc-900 mb-1.5">Skryté pod hranou desky</h4>
        <p class="text-xs text-zinc-600 leading-relaxed">
          Kovová destička ze spodní strany stolu. Tlačítko na ni magneticky přicvaknete — zvenčí zcela neviditelné, pro vaši ruku přirozeně dostupné.
        </p>
      </div>

      <!-- 02 -->
      <div class="py-5 md:py-0 md:px-8">
        <span class="text-[11px] font-mono font-medium text-zinc-400 tracking-wider uppercase block mb-1">
          02 / Lehátko & vozík
        </span>
        <h4 class="text-base font-bold tracking-tight text-zinc-900 mb-1.5">Přímo na kovový rám</h4>
        <p class="text-xs text-zinc-600 leading-relaxed">
          Bez vrtání a lepidla. Silný neodymový magnet okamžitě přilne k noze stolu, rámu lehátka nebo manipulačnímu vozíku.
        </p>
      </div>

      <!-- 03 -->
      <div class="py-5 md:py-0 md:pl-8">
        <span class="text-[11px] font-mono font-medium text-zinc-400 tracking-wider uppercase block mb-1">
          03 / Pohyb po prostoru
        </span>
        <h4 class="text-base font-bold tracking-tight text-zinc-900 mb-1.5">V kapse u sebe</h4>
        <p class="text-xs text-zinc-600 leading-relaxed">
          Při vítání klienta nebo přebírání zboží tlačítko bleskově sejmete z magnetu. S váhou 28 g o něm v zástěře ani nevíte.
        </p>
      </div>

    </div>

  </div>
</section>
