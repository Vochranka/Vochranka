---
// src/components/PlugAndPlay.astro

const installSteps = [
  {
    num: "1",
    dotClass: "bg-[#f97316]", // Vibrant orange
    title: "Zapojit",
    lines: ["Zasuňte sirénu a bránu do zásuvky.", "Spárují se samy."],
    desktopClass: "",
  },
  {
    num: "2",
    dotClass: "bg-[#fbb03b]", // Warm amber / peach
    title: "Přicvaknout",
    lines: ["Tlačítko drží pod stolem magnetem,", "nebo na tenké destičce."],
    desktopClass: "md:mt-20 lg:mt-24 md:mx-auto",
  },
  {
    num: "3",
    dotClass: "bg-[#86efac]", // Mint green
    title: "Otestovat",
    lines: ["Dvojklikem vyzkoušíte sirénu i", "doručení SMS."],
    desktopClass: "md:mt-0 md:ml-auto md:translate-x-6 lg:translate-x-12",
  },
];

const placementItems = [
  {
    num: "01",
    leftMeta: "MASÉRSKÝ STŮL",
    rightMeta: "MAGNETICKÉ UCHYCENÍ",
    title: "Schované. Přesto vždy na dosah.",
    desc: "Tlačítko drží magneticky přímo na kovovém rámu lehátka. Během masáže ho najdete poslepu, bez jediného nápadného pohybu.",
    image: "/button-under-table.jpg",
    alt: "Tísňové tlačítko magneticky přichycené pod masérským stolem",
  },
  {
    num: "02",
    leftMeta: "V KAPSE",
    rightMeta: "4,5 CM • 28 G",
    title: "Bezpečí se pohybuje s vámi.",
    desc: "Má jen 4,5 cm a váží 28 gramů. V kapse zástěry nebo kalhot o něm nevíte — dokud ho nepotřebujete.",
    image: "/button-pocket.jpg",
    alt: "Diskrétní nošení tísňového tlačítka v kapse",
  },
  {
    num: "03",
    leftMeta: "RECEPCE",
    rightMeta: "3M DESTIČKA + MAGNET",
    title: "Pro klienta neviditelné.",
    desc: "Pod hranu recepce přilepíte tenkou kovovou destičku. Tlačítko na ní drží magnetem a můžete ho kdykoliv zase vzít s sebou.",
    image: "/button-under-reception.jpg",
    alt: "Umístění tísňového tlačítka pod deskou recepce na 3M destičku",
  },
];
---

<!-- 1. INSTALACE / ŽÁDNÉ VRTÁNÍ -->
<section
  id="instalace"
  class="pt-16 pb-20 sm:pt-20 sm:pb-28 md:pt-28 md:pb-36 bg-white relative overflow-hidden"
>
  <!-- Horní rohová světle žlutá záře navazující ze sekce Využití -->
  <div
    class="absolute -top-20 -left-20 sm:-top-24 sm:-left-24 w-60 h-60 sm:w-72 sm:h-72 md:w-80 md:h-80 rounded-full bg-gradient-to-br from-amber-400/25 via-yellow-300/15 to-transparent blur-[60px] sm:blur-[70px] md:blur-[80px] pointer-events-none"
    aria-hidden="true"
  ></div>
  <div
    class="absolute -top-20 -right-20 sm:-top-24 sm:-right-24 w-60 h-60 sm:w-72 sm:h-72 md:w-80 md:h-80 rounded-full bg-gradient-to-bl from-amber-400/25 via-yellow-300/15 to-transparent blur-[60px] sm:blur-[70px] md:blur-[80px] pointer-events-none"
    aria-hidden="true"
  ></div>

  <!-- Spodní rohová zelená záře navazující do sekce Variabilita -->
  <div
    class="absolute -bottom-20 -left-20 sm:-bottom-24 sm:-left-24 w-60 h-60 sm:w-72 sm:h-72 md:w-80 md:h-80 rounded-full bg-gradient-to-tr from-emerald-400/25 via-emerald-300/10 to-transparent blur-[60px] sm:blur-[70px] md:blur-[80px] pointer-events-none"
    aria-hidden="true"
  ></div>
  <div
    class="absolute -bottom-20 -right-20 sm:-bottom-24 sm:-right-24 w-60 h-60 sm:w-72 sm:h-72 md:w-80 md:h-80 rounded-full bg-gradient-to-tl from-emerald-400/25 via-emerald-300/10 to-transparent blur-[60px] sm:blur-[70px] md:blur-[80px] pointer-events-none"
    aria-hidden="true"
  ></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Header sekce podle grafického návrhu -->
    <div id="install-heading-wrap" class="max-w-3xl mx-auto text-center mb-16 sm:mb-20 md:mb-28 cursor-pointer select-none group/heading">
      <h2
        class="text-4xl sm:text-5xl md:text-6xl lg:text-[4.25rem] font-extrabold tracking-tight font-display leading-[1.08]"
      >
        <span class="block text-zinc-950">
          Žádné <span class="relative inline-block">
            vrtání.
            <span
              class="strike-line absolute left-[-4px] right-[-6px] top-[56%] -translate-y-1/2 h-[3.5px] sm:h-[4.5px] md:h-[5.5px] bg-[#ef4444] rounded-full -rotate-[1deg] pointer-events-none origin-left scale-x-100 transition-transform duration-500 ease-out"
              data-strike="1"
            ></span>
          </span>
        </span>
        <span class="block text-zinc-400 mt-1 sm:mt-2">
          Žádné <span class="relative inline-block">
            kabely.
            <span
              class="strike-line absolute left-[-4px] right-[-6px] top-[56%] -translate-y-1/2 h-[3.5px] sm:h-[4.5px] md:h-[5.5px] bg-[#ef4444] rounded-full -rotate-[1deg] pointer-events-none origin-left scale-x-100 transition-transform duration-500 ease-out"
              data-strike="2"
            ></span>
          </span>
        </span>
      </h2>
      <p
        class="text-base sm:text-lg md:text-xl text-zinc-600 mt-6 sm:mt-8 font-normal leading-relaxed max-w-xl mx-auto"
      >
        Instalace zabere 2 minuty a nepotřebujete žádné nářadí.
      </p>
    </div>

    <!-- 3 kroky vlnovky / timeline (Přicvaknout uprostřed, Zapojit posunuto vpravo) -->
    <div class="relative max-w-5xl mx-auto px-4 sm:px-6">
      <!-- Desktop křivky (propojovací čárkované linie s plynulým postupným ztmavováním) -->
      <svg
        class="hidden md:block absolute inset-0 w-full h-full pointer-events-none overflow-visible"
        viewBox="0 0 1000 240"
        preserveAspectRatio="none"
        fill="none"
        aria-hidden="true"
      >
        <defs>
          <!-- 1. křivka: ze světlé stříbřitě šedé (Zapojit) do středně šedé (Přicvaknout) -->
          <linearGradient id="dash-grad-1" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#cbd5e1" />
            <stop offset="50%" stop-color="#94a3b8" />
            <stop offset="100%" stop-color="#64748b" />
          </linearGradient>

          <!-- 2. křivka: ze středně šedé (Přicvaknout) plynule navazuje do tmavého grafitu (Otestovat) -->
          <linearGradient id="dash-grad-2" x1="0%" y1="100%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#64748b" />
            <stop offset="50%" stop-color="#475569" />
            <stop offset="100%" stop-color="#0f172a" />
          </linearGradient>
        </defs>

        <!-- Křivka z kroku 1 dolů do kroku 2 -->
        <path
          d="M 265 50 C 315 50, 355 65, 370 80"
          stroke="url(#dash-grad-1)"
          stroke-width="1.75"
          stroke-dasharray="4 4"
          vector-effect="non-scaling-stroke"
        />
        <!-- Křivka z kroku 2 nahoru do kroku 3 -->
        <path
          d="M 630 160 C 685 160, 745 110, 780 45"
          stroke="url(#dash-grad-2)"
          stroke-width="1.75"
          stroke-dasharray="4 4"
          vector-effect="non-scaling-stroke"
        />
      </svg>

      <!-- Desktop: 3 sloupce rozprostřené do šířky se střídavým odsazením -->
      <div class="hidden md:grid md:grid-cols-3 gap-8 md:gap-12 lg:gap-16 relative z-10 items-start">
        {
          installSteps.map((step) => (
            <div class={`flex flex-col items-start ${step.desktopClass}`}>
              <!-- Tečka -->
              <div class={`w-3.5 h-3.5 rounded-full ${step.dotClass} mb-4 shadow-sm`} />

              <!-- Název -->
              <h3 class="text-2xl lg:text-[1.7rem] font-bold text-zinc-950 font-display mb-2.5 tracking-tight">
                {step.title}
              </h3>

              <!-- Popis s přesným zalamováním -->
              <p class="text-sm lg:text-base text-zinc-600 leading-relaxed">
                {step.lines.map((line, i) => (
                  <span>
                    {line}
                    {i < step.lines.length - 1 && <br />}
                  </span>
                ))}
              </p>
            </div>
          ))
        }
      </div>

      <!-- Mobilní verze: plynulý vertikální tok s vlnitými spojnicemi -->
      <div class="md:hidden flex flex-col space-y-2 max-w-sm mx-auto px-4">
        <!-- Krok 1 -->
        <div class="flex flex-col items-start pl-6">
          <div class="w-3.5 h-3.5 rounded-full bg-[#f97316] mb-3 shadow-sm" />
          <h3 class="text-xl font-bold text-zinc-950 font-display mb-1.5 tracking-tight">
            Zapojit
          </h3>
          <p class="text-sm text-zinc-600 leading-relaxed">
            Zasuňte sirénu a bránu do zásuvky.<br />Spárují se samy.
          </p>
        </div>

        <!-- Propojovací křivka 1 -> 2 (ze světlé do středně šedé) -->
        <div class="py-1 pl-4">
          <svg class="w-8 h-12 text-zinc-400" viewBox="0 0 32 48" fill="none">
            <defs>
              <linearGradient id="mob-dash-1" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#cbd5e1" />
                <stop offset="100%" stop-color="#64748b" />
              </linearGradient>
            </defs>
            <path
              d="M 4 2 C 4 24, 28 24, 28 46"
              stroke="url(#mob-dash-1)"
              stroke-width="1.75"
              stroke-dasharray="4 4"
              fill="none"
            />
          </svg>
        </div>

        <!-- Krok 2 -->
        <div class="flex flex-col items-start pl-6">
          <div class="w-3.5 h-3.5 rounded-full bg-[#fbb03b] mb-3 shadow-sm" />
          <h3 class="text-xl font-bold text-zinc-950 font-display mb-1.5 tracking-tight">
            Přicvaknout
          </h3>
          <p class="text-sm text-zinc-600 leading-relaxed">
            Tlačítko drží pod stolem magnetem,<br />nebo na tenké destičce.
          </p>
        </div>

        <!-- Propojovací křivka 2 -> 3 (ze středně šedé do tmavé) -->
        <div class="py-1 pl-10">
          <svg class="w-8 h-12 text-zinc-400" viewBox="0 0 32 48" fill="none">
            <defs>
              <linearGradient id="mob-dash-2" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#64748b" />
                <stop offset="100%" stop-color="#0f172a" />
              </linearGradient>
            </defs>
            <path
              d="M 28 2 C 28 24, 4 24, 4 46"
              stroke="url(#mob-dash-2)"
              stroke-width="1.75"
              stroke-dasharray="4 4"
              fill="none"
            />
          </svg>
        </div>

        <!-- Krok 3 -->
        <div class="flex flex-col items-start">
          <div class="w-3.5 h-3.5 rounded-full bg-[#86efac] mb-3 shadow-sm" />
          <h3 class="text-xl font-bold text-zinc-950 font-display mb-1.5 tracking-tight">
            Otestovat
          </h3>
          <p class="text-sm text-zinc-600 leading-relaxed">
            Dvojklikem vyzkoušíte sirénu i<br />doručení SMS.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 2. VARIABILITA UCHYCENÍ -->
<section
  id="variabilita"
  class="pt-16 pb-20 sm:pt-20 sm:pb-28 md:pt-28 md:pb-36 bg-white border-t border-zinc-200/70 relative overflow-hidden"
>
  <!-- Rohová zelená záře -->
  <div
    class="absolute -top-20 -left-20 sm:-top-24 sm:-left-24 w-60 h-60 sm:w-72 sm:h-72 md:w-80 md:h-80 rounded-full bg-gradient-to-br from-emerald-400/25 via-emerald-300/10 to-transparent blur-[60px] sm:blur-[70px] md:blur-[80px] pointer-events-none"
    aria-hidden="true"
  ></div>
  <div
    class="absolute -top-20 -right-20 sm:-top-24 sm:-right-24 w-60 h-60 sm:w-72 sm:h-72 md:w-80 md:h-80 rounded-full bg-gradient-to-bl from-emerald-400/25 via-emerald-300/10 to-transparent blur-[60px] sm:blur-[70px] md:blur-[80px] pointer-events-none"
    aria-hidden="true"
  ></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Hlavička sekce -->
    <div class="max-w-3xl mx-auto text-center mb-12 sm:mb-16 md:mb-20">
      <h2
        class="text-3xl sm:text-4xl md:text-5xl lg:text-[3.25rem] font-extrabold tracking-tight text-zinc-950 font-display leading-[1.12]"
      >
        Vždy tam, kam<br class="hidden sm:inline" /> přirozeně sáhnete.
      </h2>
      <p
        class="text-sm sm:text-base md:text-lg text-zinc-600 mt-4 leading-relaxed max-w-2xl mx-auto"
      >
        Na kov drží samo. Jinam nalepíte tenkou destičku. Umístění můžete
        kdykoliv změnit podle toho, kde se právě cítíte nejjistěji.
      </p>
    </div>

    <!-- 3 KARTY: na mobilu 3 sloupce na 1 obrazovku, na desktopu prostorné karty s možností zvětšení -->
    <div class="grid grid-cols-3 gap-2 sm:gap-4 md:gap-8 items-start">
      {
        placementItems.map((item, index) => (
          <div
            class={`flex flex-col group cursor-pointer select-none ${index === 1 ? 'mt-4 sm:mt-8 md:mt-12 lg:mt-16' : ''}`}
            data-placement-card={index}
            tabindex="0"
            role="button"
            aria-label={`Zobrazit detail pro ${item.title}`}
          >
            <!-- Text nad fotkou -->
            <div class="pb-2.5 sm:pb-3.5 md:pb-5 flex flex-col flex-1">
              <!-- Nadpis -->
              <h3 class="text-xs sm:text-base md:text-2xl font-bold tracking-tight text-zinc-950 mb-1 md:mb-2.5 leading-snug line-clamp-2 md:line-clamp-none">
                {item.title}
              </h3>

              <!-- Popis: na mobilu čitelný kompaktní text, na desktopu plný -->
              <p class="text-[10px] sm:text-xs md:text-sm text-zinc-600 leading-snug sm:leading-relaxed line-clamp-2 md:line-clamp-none">
                {item.desc}
              </p>

              <!-- Mobilní nápověda pro zvětšení -->
              <span class="md:hidden text-[9px] sm:text-[10px] font-medium text-zinc-400 mt-1 inline-flex items-center gap-0.5 group-hover:text-zinc-950 transition-colors">
                <span>Zvětšit detail</span>
                <span class="text-zinc-500">&rarr;</span>
              </span>
            </div>

            <!-- Obrázek -->
            <div class="relative w-full aspect-[3/4] sm:aspect-[4/5] rounded-xl sm:rounded-2xl md:rounded-[2rem] overflow-hidden bg-zinc-100 shadow-sm group-hover:shadow-md transition-all duration-500">
              <!-- Jemná ikonka lupy / zvětšení v rohu fotky -->
              <div class="absolute bottom-1.5 right-1.5 sm:bottom-2.5 sm:right-2.5 z-10 w-5 h-5 sm:w-7 sm:h-7 rounded-full bg-black/60 backdrop-blur-md text-white flex items-center justify-center opacity-85 group-hover:opacity-100 group-hover:scale-110 transition-all shadow-sm">
                <svg class="w-2.5 h-2.5 sm:w-3.5 sm:h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                  <line x1="11" y1="8" x2="11" y2="14"></line>
                  <line x1="8" y1="11" x2="14" y2="11"></line>
                </svg>
              </div>

              <!-- Fotka -->
              <img
                src={item.image}
                alt={item.alt}
                class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out"
                loading="lazy"
              />
            </div>
          </div>
        ))
      }
    </div>

  </div>

  <!-- Spodní rohová světle žlutá záře navazující do sekce FAQ -->
  <div
    class="absolute -bottom-20 -left-20 sm:-bottom-24 sm:-left-24 w-60 h-60 sm:w-72 sm:h-72 md:w-80 md:h-80 rounded-full bg-gradient-to-tr from-amber-400/25 via-yellow-300/15 to-transparent blur-[60px] sm:blur-[70px] md:blur-[80px] pointer-events-none"
    aria-hidden="true"
  ></div>
  <div
    class="absolute -bottom-20 -right-20 sm:-bottom-24 sm:-right-24 w-60 h-60 sm:w-72 sm:h-72 md:w-80 md:h-80 rounded-full bg-gradient-to-tl from-amber-400/25 via-yellow-300/15 to-transparent blur-[60px] sm:blur-[70px] md:blur-[80px] pointer-events-none"
    aria-hidden="true"
  ></div>
</section>

<!-- MODAL / LIGHTBOX PRO ZVĚTŠENÍ NA KLIKNUTÍ -->
<div
  id="placement-modal"
  class="fixed inset-0 z-50 bg-zinc-950/80 backdrop-blur-md hidden opacity-0 transition-opacity duration-300 flex items-center justify-center p-4 sm:p-6"
  role="dialog"
  aria-modal="true"
  aria-label="Detail umístění tlačítka"
>
  <!-- Vnitřní karta modalu -->
  <div
    id="placement-modal-card"
    class="relative w-full max-w-lg bg-white rounded-3xl overflow-hidden shadow-2xl transform scale-95 transition-transform duration-300 max-h-[92vh] flex flex-col"
  >
    <!-- Tlačítko zavřít ✕ -->
    <button
      type="button"
      id="placement-modal-close"
      class="absolute top-3.5 right-3.5 z-30 w-9 h-9 rounded-full bg-zinc-950/70 hover:bg-zinc-950 text-white flex items-center justify-center transition-all cursor-pointer backdrop-blur-sm shadow-md"
      aria-label="Zavřít detail"
    >
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <!-- Tlačítko předchozí v modalu -->
    <button
      type="button"
      id="placement-modal-prev"
      class="absolute left-3 top-[38%] -translate-y-1/2 z-30 w-10 h-10 rounded-full bg-white/95 hover:bg-zinc-950 text-zinc-800 hover:text-white border border-zinc-200 shadow-md flex items-center justify-center transition-all cursor-pointer"
      aria-label="Předchozí možnost"
    >
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>

    <!-- Tlačítko další v modalu -->
    <button
      type="button"
      id="placement-modal-next"
      class="absolute right-3 top-[38%] -translate-y-1/2 z-30 w-10 h-10 rounded-full bg-white/95 hover:bg-zinc-950 text-zinc-800 hover:text-white border border-zinc-200 shadow-md flex items-center justify-center transition-all cursor-pointer"
      aria-label="Další možnost"
    >
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>

    <!-- Velká fotka -->
    <div class="relative w-full aspect-[4/3] bg-zinc-100 shrink-0 overflow-hidden">
      <img
        id="modal-img"
        src=""
        alt=""
        class="w-full h-full object-cover"
      />
      <!-- Číslo v rohu -->
      <div
        id="modal-badge"
        class="absolute top-4 left-4 z-10 w-9 h-9 rounded-full bg-zinc-950 text-white font-mono text-xs font-bold flex items-center justify-center shadow-md"
      >
        01
      </div>
    </div>

    <!-- Text detailu -->
    <div class="p-5 sm:p-7 flex flex-col overflow-y-auto">
      <div class="flex items-center gap-2.5 mb-2">
        <span
          id="modal-left-meta"
          class="text-xs font-mono tracking-widest text-zinc-400 uppercase font-semibold shrink-0"
        ></span>
        <span class="h-px bg-zinc-200/90 flex-1 min-w-[20px]"></span>
        <span
          id="modal-right-meta"
          class="text-xs font-mono tracking-widest text-zinc-400 uppercase font-semibold shrink-0"
        ></span>
      </div>

      <h3
        id="modal-title"
        class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-950 mb-2 leading-snug"
      ></h3>

      <p
        id="modal-desc"
        class="text-sm sm:text-base text-zinc-600 leading-relaxed"
      ></p>
    </div>
  </div>
</div>

<style>
  /* Jemné tečkované oddělovače (drobné technické tečky) */
  section {
    --dot: #a1a1aa;
    --dots: radial-gradient(circle, var(--dot) 0.75px, transparent 1.1px);
  }

  .dots-t {
    background-image: var(--dots);
    background-size: 8px 3px;
    background-repeat: repeat-x;
    background-position: top left;
  }

  .dots-b {
    background-image: var(--dots);
    background-size: 8px 3px;
    background-repeat: repeat-x;
    background-position: bottom left;
  }
</style>

<script define:vars={{ placementItems }}>
  function initPlacementModal() {
    const modal = document.getElementById("placement-modal");
    const modalCard = document.getElementById("placement-modal-card");
    const closeBtn = document.getElementById("placement-modal-close");
    const prevBtn = document.getElementById("placement-modal-prev");
    const nextBtn = document.getElementById("placement-modal-next");
    const modalImg = document.getElementById("modal-img");
    const modalBadge = document.getElementById("modal-badge");
    const modalLeftMeta = document.getElementById("modal-left-meta");
    const modalRightMeta = document.getElementById("modal-right-meta");
    const modalTitle = document.getElementById("modal-title");
    const modalDesc = document.getElementById("modal-desc");
    const cards = document.querySelectorAll("[data-placement-card]");

    if (!modal) return;

    let currentIndex = 0;

    function renderModal(index) {
      const item = placementItems[index];
      if (!item) return;
      currentIndex = index;

      if (modalImg) {
        modalImg.src = item.image;
        modalImg.alt = item.alt;
      }
      if (modalBadge) modalBadge.textContent = item.num;
      if (modalLeftMeta) modalLeftMeta.textContent = item.leftMeta;
      if (modalRightMeta) modalRightMeta.textContent = item.rightMeta;
      if (modalTitle) modalTitle.textContent = item.title;
      if (modalDesc) modalDesc.textContent = item.desc;
    }

    function openModal(index) {
      renderModal(index);
      modal.classList.remove("hidden");
      document.body.style.overflow = "hidden";
      setTimeout(() => {
        modal.classList.remove("opacity-0");
        modalCard?.classList.remove("scale-95");
        modalCard?.classList.add("scale-100");
      }, 10);
    }

    function closeModal() {
      modal.classList.add("opacity-0");
      modalCard?.classList.remove("scale-100");
      modalCard?.classList.add("scale-95");
      setTimeout(() => {
        modal.classList.add("hidden");
        document.body.style.overflow = "";
      }, 250);
    }

    cards.forEach((card, i) => {
      card.addEventListener("click", () => openModal(i));
      card.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          openModal(i);
        }
      });
    });

    closeBtn?.addEventListener("click", closeModal);
    modal.addEventListener("click", (e) => {
      if (e.target === modal) closeModal();
    });

    prevBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      const prevIdx = (currentIndex - 1 + placementItems.length) % placementItems.length;
      renderModal(prevIdx);
    });

    nextBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      const nextIdx = (currentIndex + 1) % placementItems.length;
      renderModal(nextIdx);
    });

    document.addEventListener("keydown", (e) => {
      if (modal.classList.contains("hidden")) return;
      if (e.key === "Escape") closeModal();
      if (e.key === "ArrowLeft") {
        const prevIdx = (currentIndex - 1 + placementItems.length) % placementItems.length;
        renderModal(prevIdx);
      }
      if (e.key === "ArrowRight") {
        const nextIdx = (currentIndex + 1) % placementItems.length;
        renderModal(nextIdx);
      }
    });

    // Touch swipe support in modal
    let touchStartX = 0;
    modalCard?.addEventListener("touchstart", (e) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    modalCard?.addEventListener("touchend", (e) => {
      const diff = touchStartX - e.changedTouches[0].screenX;
      if (Math.abs(diff) > 40) {
        if (diff > 0) {
          const nextIdx = (currentIndex + 1) % placementItems.length;
          renderModal(nextIdx);
        } else {
          const prevIdx = (currentIndex - 1 + placementItems.length) % placementItems.length;
          renderModal(prevIdx);
        }
      }
    }, { passive: true });
  }

  function initStrikeAnimation() {
    const headingWrap = document.getElementById("install-heading-wrap");
    const section = document.getElementById("instalace");
    const strikes = document.querySelectorAll(".strike-line");

    if (!strikes.length) return;

    let isAnimating = false;
    let timer1 = null;
    let timer2 = null;

    function playStrikeAnimation() {
      if (isAnimating) return;
      isAnimating = true;

      clearTimeout(timer1);
      clearTimeout(timer2);

      // Okamžitý reset do výchozího stavu bez přechodové animace
      strikes.forEach((strike) => {
        strike.style.transition = "none";
        strike.classList.remove("scale-x-100");
        strike.classList.add("scale-x-0");
      });

      // Vynucení reflow pro aplikaci nulové šířky před opětovným zapnutím transition
      if (headingWrap) void headingWrap.offsetWidth;

      // Znovupovolení plynulé CSS transition
      strikes.forEach((strike) => {
        strike.style.transition = "";
      });

      // 1. škrtnutí: vrtání.
      timer1 = setTimeout(() => {
        const s1 = document.querySelector('.strike-line[data-strike="1"]');
        if (s1) {
          s1.classList.remove("scale-x-0");
          s1.classList.add("scale-x-100");
        }
      }, 50);

      // 2. škrtnutí: kabely.
      timer2 = setTimeout(() => {
        const s2 = document.querySelector('.strike-line[data-strike="2"]');
        if (s2) {
          s2.classList.remove("scale-x-0");
          s2.classList.add("scale-x-100");
        }
      }, 260);

      // Odemknutí po dokončení tahu pro další najetí myší
      setTimeout(() => {
        isAnimating = false;
      }, 650);
    }

    // Spuštění při prvním nascrollování do sekce
    if (section) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              playStrikeAnimation();
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15 }
      );
      observer.observe(section);
    }

    // Přehrání při každém najetí myší na Žádné vrtání / Žádné kabely
    if (headingWrap) {
      headingWrap.addEventListener("mouseenter", () => {
        playStrikeAnimation();
      });

      // Přehrání i na kliknutí / tapnutí (pro mobilní telefony)
      headingWrap.addEventListener("click", () => {
        isAnimating = false;
        playStrikeAnimation();
      });

      const h2 = headingWrap.querySelector("h2");
      if (h2) {
        h2.addEventListener("mouseenter", () => {
          playStrikeAnimation();
        });
      }
    }
  }

  initPlacementModal();
  initStrikeAnimation();
  document.addEventListener("astro:page-load", () => {
    initPlacementModal();
    initStrikeAnimation();
  });
</script>
