---
// src/components/PlugAndPlay.astro

const installSteps = [
  {
    num: "1",
    title: "Zapojit",
    desc: "Zasunete sirénu a bránu do zásuvky. Okamžitě se spáruje se systémem.",
    image: "/step1-zapojit.jpg",
    alt: "Zapojení sirény do zásuvky",
  },
  {
    num: "2",
    title: "Přicvaknout",
    desc: "Nalepíte destičku pod stůl. Tlačítko na ní drží silným magnetem.",
    image: "/step2-umistit.jpg",
    alt: "Umístění tísňového tlačítka pod stůl či lehátko",
  },
  {
    num: "3",
    title: "Otestovat",
    desc: "Dvojklikem otestujete sirénu i doručení SMS vybraným kontaktům.",
    image: "/step3-otestovat.jpg",
    alt: "Otestování sirény a přijetí zkušební SMS na telefonu",
  },
];

const placementItems = [
  {
    num: "01",
    leftMeta: "MASÉRSKÝ STŮL",
    rightMeta: "MAGNETICKÉ UCHYCENÍ",
    title: "Schované. Přesto vždy na dosah.",
    desc: "Tlačítko drží magneticky přímo na kovovém rámu lehátka. Během masáže ho najdete poslepu, bez jediného nápadného pohybu.",
    image: "/button-under-table.jpg",
    alt: "Tísňové tlačítko magneticky přichycené pod masérským stolem",
  },
  {
    num: "02",
    leftMeta: "V KAPSE",
    rightMeta: "4,5 CM • 28 G",
    title: "Bezpečí se pohybuje s vámi.",
    desc: "Má jen 4,5 cm a váží 28 gramů. V kapse zástěry nebo kalhot o něm nevíte — dokud ho nepotřebujete.",
    image: "/button-pocket.jpg",
    alt: "Diskrétní nošení tísňového tlačítka v kapse",
  },
  {
    num: "03",
    leftMeta: "RECEPCE",
    rightMeta: "3M DESTIČKA + MAGNET",
    title: "Pro klienta neviditelné.",
    desc: "Pod hranu recepce přilepíte tenkou kovovou destičku. Tlačítko na ní drží magnetem a můžete ho kdykoliv zase vzít s sebou.",
    image: "/button-under-reception.jpg",
    alt: "Umístění tísňového tlačítka pod deskou recepce na 3M destičku",
  },
];
---

<section
  id="instalace"
  class="pt-20 pb-8 bg-zinc-50 relative"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- 1. Header sekce: Rychlost instalace -->
    <div class="max-w-3xl mx-auto text-center mb-16">
      <div class="inline-flex items-center">
        <span
          class="text-xs font-mono tracking-[0.2em] text-zinc-400 uppercase font-medium block mb-3"
        >
          INSTALACE BĚHEM 2 MINUT
        </span>
      </div>
      <h2
        class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-zinc-950 font-display"
      >
        Žádné vrtání, žádné kabely. <br />
      </h2>
      <p
        class="text-base sm:text-lg text-zinc-600 mt-4 leading-relaxed max-w-2xl mx-auto"
      >
        K instalaci nepotřebujete nářadí, techniky ani složité nastavování.
        <span class="font-bold"
          >Vše dodáváme připravené k okamžitému provozu.</span
        >
      </p>
    </div>

    <!-- 2. 3 KROKY INSTALACE (Fotka nahoře + popis dole) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      {
        installSteps.map((step) => (
          <div class="rounded-3xl bg-white border border-zinc-200/90 shadow-sm overflow-hidden flex flex-col hover:border-zinc-300 hover:shadow-md transition-all duration-300 group">
            <!-- Nahoře: Fotka kroku (čistá bez pilulky) -->
            <div class="relative w-full aspect-[4/3] bg-zinc-100 overflow-hidden">
              <img
                src={step.image}
                alt={step.alt}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                loading="lazy"
              />
            </div>

            <!-- Dole: Popis -->
            <div class="p-6 sm:p-7 flex flex-col justify-between flex-1">
              <div>
                <span class="text-[11px] font-mono font-semibold tracking-wider text-zinc-400 block mb-1">
                  KROK 0{step.num}
                </span>
                <h3 class="text-xl font-bold tracking-tight text-zinc-950 mb-2">
                  {step.title}
                </h3>
                <p class="text-sm text-zinc-600 leading-relaxed">
                  {step.desc}
                </p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- 3. VARIABILITA UCHYCENÍ -->
<section id="variabilita" class="pt-10 pb-12 sm:pt-14 sm:pb-16 md:pt-20 md:pb-36 bg-white dots-t dots-b relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8">
    
    <!-- Hlavička sekce (kompaktní na mobilu pro zobrazení na jedné obrazovce) -->
    <div class="max-w-3xl mx-auto text-center mb-6 sm:mb-8 md:mb-16 lg:mb-20">
      <h2 class="text-2xl sm:text-3xl md:text-5xl lg:text-[3.25rem] font-extrabold tracking-tight text-zinc-950 font-display leading-[1.15]">
        Vždy tam, kam<br class="hidden sm:inline" /> přirozeně sáhnete.
      </h2>
      <p class="text-xs sm:text-sm md:text-lg text-zinc-600 mt-2 sm:mt-3 md:mt-4 leading-relaxed max-w-2xl mx-auto">
        Na kov drží samo. Jinam nalepíte tenkou destičku. Umístění můžete kdykoliv změnit podle toho, kde se právě cítíte nejjistěji.
      </p>
    </div>

    <!-- 3 SLOUPCE (Na mobilu kompaktní 3 sloupce na 1 obrazovce, na desktopu rozvolněné) -->
    <div class="grid grid-cols-3 gap-2.5 sm:gap-4 md:gap-8 lg:gap-10 items-start">
      {
        placementItems.map((item, index) => (
          <div
            class={`flex flex-col group cursor-pointer transition-transform active:scale-[0.98] ${
              index === 1 ? "mt-3 md:mt-14 lg:mt-20" : ""
            }`}
            data-placement-card={index}
            role="button"
            tabindex="0"
            aria-label={`Zvětšit detail: ${item.title}`}
          >
            <!-- Obrázek s číslem v rohu -->
            <div class="relative w-full aspect-[3/4] sm:aspect-[4/5]">
              <!-- Černé kolečko s číslem v rohu -->
              <div class="absolute -top-1.5 -left-1.5 sm:-top-3 sm:-left-3 z-10 w-6 h-6 sm:w-8 sm:h-8 md:w-10 md:h-10 rounded-full bg-zinc-950 text-white font-mono text-[10px] sm:text-xs md:text-sm font-bold flex items-center justify-center shadow-md">
                <span>{item.num}</span>
              </div>

              <!-- Jemná ikonka lupy / zvětšení v rohu fotky -->
              <div class="absolute bottom-1.5 right-1.5 sm:bottom-2.5 sm:right-2.5 z-10 w-5 h-5 sm:w-7 sm:h-7 rounded-full bg-black/60 backdrop-blur-md text-white flex items-center justify-center opacity-85 group-hover:opacity-100 group-hover:scale-110 transition-all shadow-sm">
                <svg class="w-2.5 h-2.5 sm:w-3.5 sm:h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <polyline points="9 21 3 21 3 15"></polyline>
                  <line x1="21" y1="3" x2="14" y2="10"></line>
                  <line x1="3" y1="21" x2="10" y2="14"></line>
                </svg>
              </div>

              <!-- Fotka se zaoblenými rohy -->
              <div class="w-full h-full rounded-2xl md:rounded-[2rem] overflow-hidden bg-zinc-100 shadow-sm group-hover:shadow-md transition-all duration-500">
                <img
                  src={item.image}
                  alt={item.alt}
                  class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out"
                  loading="lazy"
                />
              </div>
            </div>

            <!-- Text pod fotkou -->
            <div class="pt-2.5 sm:pt-3.5 md:pt-6 flex flex-col">
              <!-- Dělicí řádek s linkou -->
              <div class="flex items-center gap-1.5 sm:gap-3 mb-1 sm:mb-1.5 md:mb-3">
                <span class="text-[9px] sm:text-[10px] md:text-[11px] font-mono tracking-wider sm:tracking-widest text-zinc-400 uppercase font-semibold shrink-0">
                  {item.leftMeta}
                </span>
                <span class="hidden md:inline-block h-px bg-zinc-200/90 flex-1 min-w-[20px]" />
                <span class="hidden md:inline-block text-[11px] font-mono tracking-widest text-zinc-400 uppercase font-semibold shrink-0">
                  {item.rightMeta}
                </span>
              </div>

              <!-- Nadpis -->
              <h3 class="text-xs sm:text-base md:text-2xl font-bold tracking-tight text-zinc-950 mb-1 md:mb-2.5 leading-snug line-clamp-2 md:line-clamp-none">
                {item.title}
              </h3>

              <!-- Popis: na mobilu čitelný kompaktní text, na desktopu plný -->
              <p class="text-[10px] sm:text-xs md:text-sm text-zinc-600 leading-snug sm:leading-relaxed line-clamp-2 md:line-clamp-none">
                {item.desc}
              </p>

              <!-- Mobilní nápověda pro zvětšení -->
              <span class="md:hidden text-[9px] sm:text-[10px] font-medium text-zinc-400 mt-1 inline-flex items-center gap-0.5 group-hover:text-zinc-950 transition-colors">
                <span>Zvětšit detail</span>
                <span class="text-zinc-500">&rarr;</span>
              </span>
            </div>
          </div>
        ))
      }
    </div>

  </div>
</section>

<!-- MODAL / LIGHTBOX PRO ZVĚTŠENÍ NA KLIKNUTÍ -->
<div
  id="placement-modal"
  class="fixed inset-0 z-50 bg-zinc-950/80 backdrop-blur-md hidden opacity-0 transition-opacity duration-300 flex items-center justify-center p-4 sm:p-6"
  role="dialog"
  aria-modal="true"
  aria-label="Detail umístění tlačítka"
>
  <!-- Vnitřní karta modalu -->
  <div
    id="placement-modal-card"
    class="relative w-full max-w-lg bg-white rounded-3xl overflow-hidden shadow-2xl transform scale-95 transition-transform duration-300 max-h-[92vh] flex flex-col"
  >
    <!-- Tlačítko zavřít ✕ -->
    <button
      type="button"
      id="placement-modal-close"
      class="absolute top-3.5 right-3.5 z-30 w-9 h-9 rounded-full bg-zinc-950/70 hover:bg-zinc-950 text-white flex items-center justify-center transition-all cursor-pointer backdrop-blur-sm shadow-md"
      aria-label="Zavřít detail"
    >
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <!-- Tlačítko předchozí v modalu -->
    <button
      type="button"
      id="placement-modal-prev"
      class="absolute left-3 top-[38%] -translate-y-1/2 z-30 w-10 h-10 rounded-full bg-white/95 hover:bg-zinc-950 text-zinc-800 hover:text-white border border-zinc-200 shadow-md flex items-center justify-center transition-all cursor-pointer"
      aria-label="Předchozí možnost"
    >
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>

    <!-- Tlačítko další v modalu -->
    <button
      type="button"
      id="placement-modal-next"
      class="absolute right-3 top-[38%] -translate-y-1/2 z-30 w-10 h-10 rounded-full bg-white/95 hover:bg-zinc-950 text-zinc-800 hover:text-white border border-zinc-200 shadow-md flex items-center justify-center transition-all cursor-pointer"
      aria-label="Další možnost"
    >
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>

    <!-- Velká fotka -->
    <div class="relative w-full aspect-[4/3] bg-zinc-100 shrink-0 overflow-hidden">
      <img
        id="modal-img"
        src=""
        alt=""
        class="w-full h-full object-cover"
      />
      <!-- Číslo v rohu -->
      <div
        id="modal-badge"
        class="absolute top-4 left-4 z-10 w-9 h-9 rounded-full bg-zinc-950 text-white font-mono text-xs font-bold flex items-center justify-center shadow-md"
      >
        01
      </div>
    </div>

    <!-- Text detailu -->
    <div class="p-5 sm:p-7 flex flex-col overflow-y-auto">
      <div class="flex items-center gap-2.5 mb-2">
        <span
          id="modal-left-meta"
          class="text-xs font-mono tracking-widest text-zinc-400 uppercase font-semibold shrink-0"
        ></span>
        <span class="h-px bg-zinc-200/90 flex-1 min-w-[20px]"></span>
        <span
          id="modal-right-meta"
          class="text-xs font-mono tracking-widest text-zinc-400 uppercase font-semibold shrink-0"
        ></span>
      </div>

      <h3
        id="modal-title"
        class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-950 mb-2 leading-snug"
      ></h3>

      <p
        id="modal-desc"
        class="text-sm sm:text-base text-zinc-600 leading-relaxed"
      ></p>
    </div>
  </div>
</div>

<style>
  /* Jemné tečkované oddělovače (drobné technické tečky) */
  section {
    --dot: #a1a1aa;
    --dots: radial-gradient(circle, var(--dot) 0.75px, transparent 1.1px);
  }

  .dots-t {
    background-image: var(--dots);
    background-size: 8px 3px;
    background-repeat: repeat-x;
    background-position: top left;
  }

  .dots-b {
    background-image: var(--dots);
    background-size: 8px 3px;
    background-repeat: repeat-x;
    background-position: bottom left;
  }
</style>

<script define:vars={{ placementItems }}>
  function initPlacementModal() {
    const modal = document.getElementById("placement-modal");
    const modalCard = document.getElementById("placement-modal-card");
    const closeBtn = document.getElementById("placement-modal-close");
    const prevBtn = document.getElementById("placement-modal-prev");
    const nextBtn = document.getElementById("placement-modal-next");
    const modalImg = document.getElementById("modal-img");
    const modalBadge = document.getElementById("modal-badge");
    const modalLeftMeta = document.getElementById("modal-left-meta");
    const modalRightMeta = document.getElementById("modal-right-meta");
    const modalTitle = document.getElementById("modal-title");
    const modalDesc = document.getElementById("modal-desc");
    const cards = document.querySelectorAll("[data-placement-card]");

    if (!modal) return;

    let currentIndex = 0;

    function renderModal(index) {
      const item = placementItems[index];
      if (!item) return;
      currentIndex = index;

      if (modalImg) {
        modalImg.src = item.image;
        modalImg.alt = item.alt;
      }
      if (modalBadge) modalBadge.textContent = item.num;
      if (modalLeftMeta) modalLeftMeta.textContent = item.leftMeta;
      if (modalRightMeta) modalRightMeta.textContent = item.rightMeta;
      if (modalTitle) modalTitle.textContent = item.title;
      if (modalDesc) modalDesc.textContent = item.desc;
    }

    function openModal(index) {
      renderModal(index);
      modal.classList.remove("hidden");
      document.body.style.overflow = "hidden";
      setTimeout(() => {
        modal.classList.remove("opacity-0");
        modalCard?.classList.remove("scale-95");
        modalCard?.classList.add("scale-100");
      }, 10);
    }

    function closeModal() {
      modal.classList.add("opacity-0");
      modalCard?.classList.remove("scale-100");
      modalCard?.classList.add("scale-95");
      setTimeout(() => {
        modal.classList.add("hidden");
        document.body.style.overflow = "";
      }, 250);
    }

    cards.forEach((card, i) => {
      card.addEventListener("click", () => openModal(i));
      card.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          openModal(i);
        }
      });
    });

    closeBtn?.addEventListener("click", closeModal);
    modal.addEventListener("click", (e) => {
      if (e.target === modal) closeModal();
    });

    prevBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      const prevIdx = (currentIndex - 1 + placementItems.length) % placementItems.length;
      renderModal(prevIdx);
    });

    nextBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      const nextIdx = (currentIndex + 1) % placementItems.length;
      renderModal(nextIdx);
    });

    document.addEventListener("keydown", (e) => {
      if (modal.classList.contains("hidden")) return;
      if (e.key === "Escape") closeModal();
      if (e.key === "ArrowLeft") {
        const prevIdx = (currentIndex - 1 + placementItems.length) % placementItems.length;
        renderModal(prevIdx);
      }
      if (e.key === "ArrowRight") {
        const nextIdx = (currentIndex + 1) % placementItems.length;
        renderModal(nextIdx);
      }
    });

    // Touch swipe support in modal
    let touchStartX = 0;
    modalCard?.addEventListener("touchstart", (e) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    modalCard?.addEventListener("touchend", (e) => {
      const diff = touchStartX - e.changedTouches[0].screenX;
      if (Math.abs(diff) > 40) {
        if (diff > 0) {
          const nextIdx = (currentIndex + 1) % placementItems.length;
          renderModal(nextIdx);
        } else {
          const prevIdx = (currentIndex - 1 + placementItems.length) % placementItems.length;
          renderModal(prevIdx);
        }
      }
    }, { passive: true });
  }

  initPlacementModal();
  document.addEventListener("astro:page-load", initPlacementModal);
</script>
