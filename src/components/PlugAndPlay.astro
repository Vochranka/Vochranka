---
// src/components/PlugAndPlay.astro

const installSteps = [
  {
    num: "1",
    title: "Zapojit",
    desc: "Zasunete sirénu a bránu do zásuvky.",
    image: "/step1-zapojit.jpg",
    alt: "Zapojení sirény do zásuvky",
  },
  {
    num: "2",
    title: "Umístit",
    desc: "Najdete ideální místo",
    image: "/step2-umistit.jpg",
    alt: "Umístění tísňového tlačítka pod stůl či lehátko",
  },
  {
    num: "3",
    title: "Otestovat",
    desc: "Ověříte, že siréna i SMS 100% fungují.",
    image: "/step3-otestovat.jpg",
    alt: "Otestování sirény a přijetí zkušební SMS na telefonu",
  },
];
---

<section
  id="instalace"
  class="pt-20 pb-8 bg-zinc-50 relative"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- 1. Header sekce: Rychlost instalace -->
    <div class="max-w-3xl mx-auto text-center mb-16">
      <div class="inline-flex items-center">
        <span
          class="text-xs font-mono tracking-[0.2em] text-zinc-400 uppercase font-medium block mb-3"
        >
          INSTALACE BĚHEM 2 MINUT
        </span>
      </div>
      <h2
        class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-zinc-950"
      >
        Žádné vrtání, žádné kabely. <br />
      </h2>
      <p
        class="text-base sm:text-lg text-zinc-600 mt-4 leading-relaxed max-w-2xl mx-auto"
      >
        K instalaci nepotřebujete nářadí, techniky ani složité nastavování.
        <span class="font-bold"
          >Vše dodáváme připravené k okamžitému provozu.</span
        >
      </p>
    </div>

    <!-- 2. 3 KROKY INSTALACE (Fotka nahoře + popis dole) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      {
        installSteps.map((step) => (
          <div class="rounded-3xl bg-white border border-zinc-200/90 shadow-sm overflow-hidden flex flex-col hover:border-zinc-300 hover:shadow-md transition-all duration-300 group">
            <!-- Nahoře: Fotka kroku -->
            <div class="relative w-full aspect-[4/3] bg-zinc-100 overflow-hidden">
              <img
                src={step.image}
                alt={step.alt}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                loading="lazy"
              />
              <!-- Krok badge v rohu fotky -->
              <div class="absolute top-3.5 left-3.5 px-3 py-1 rounded-full bg-black/60 backdrop-blur-md text-white border border-white/20 shadow-sm flex items-center gap-1.5 font-mono text-xs font-medium tracking-wider">
                <span>Krok 0{step.num}</span>
              </div>
            </div>

            <!-- Dole: Popis -->
            <div class="p-6 sm:p-7 flex flex-col justify-between flex-1">
              <div>
                <h3 class="text-lg font-bold tracking-tight text-zinc-900 mb-2">
                  {step.title}
                </h3>
                <p class="text-xs text-zinc-600 leading-relaxed">
                  {step.desc}
                </p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- 3. VARIABILITA UCHYCENÍ (Apple spec strip s tečkami) -->
<section class="spec-strip dots-t dots-b py-14 bg-zinc-50/70 relative">
  <div class="max-w-6xl mx-auto px-6">
    
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4">
      <div>
         <span
          class="text-xs font-mono tracking-[0.2em] text-zinc-400 uppercase font-medium block mb-3"
        >
          Variabilita uchycení
        </span>
        <h3 class="text-2xl md:text-3xl font-bold tracking-tight text-zinc-950">
          Drží pevně. Zůstává stále mobilní.
        </h3>
      </div>
      <p class="text-xs text-zinc-500 max-w-sm leading-relaxed">
        3M páskou nalepíte pouze tenkou kovovou destičku. Samotné tlačítko na ní drží silným magnetem a můžete ho kdykoliv vzít s sebou.
      </p>
    </div>

    <div class="dots-t pt-8 grid grid-cols-1 md:grid-cols-3">
      
      <!-- 01 -->
      <div class="py-5 md:py-0 md:pr-8">
        <span class="text-[11px] font-mono font-medium text-zinc-400 tracking-wider uppercase block mb-1">
          01 / Pult & stůl
        </span>
        <h4 class="text-base font-semibold text-zinc-900 mb-1.5">Skryté pod hranou desky</h4>
        <p class="text-xs text-zinc-600 leading-relaxed">
          Kovová destička ze spodní strany stolu. Tlačítko na ni magneticky přicvaknete — zvenčí zcela neviditelné, pro vaši ruku přirozeně dostupné.
        </p>
      </div>

      <!-- 02 -->
      <div class="py-5 md:py-0 md:px-8">
        <span class="text-[11px] font-mono font-medium text-zinc-400 tracking-wider uppercase block mb-1">
          02 / Lehátko & vozík
        </span>
        <h4 class="text-base font-semibold text-zinc-900 mb-1.5">Přímo na kovový rám</h4>
        <p class="text-xs text-zinc-600 leading-relaxed">
          Bez vrtání a lepidla. Silný neodymový magnet okamžitě přilne k noze stolu, rámu lehátka nebo manipulačnímu vozíku.
        </p>
      </div>

      <!-- 03 -->
      <div class="py-5 md:py-0 md:pl-8">
        <span class="text-[11px] font-mono font-medium text-zinc-400 tracking-wider uppercase block mb-1">
          03 / Pohyb po prostoru
        </span>
        <h4 class="text-base font-semibold text-zinc-900 mb-1.5">V kapse u sebe</h4>
        <p class="text-xs text-zinc-600 leading-relaxed">
          Při vítání klienta nebo přebírání zboží tlačítko bleskově sejmete z magnetu. S váhou 28 g o něm v zástěře ani nevíte.
        </p>
      </div>

    </div>

  </div>
</section>

<style>
  /* Tečkované čáry z kulatých teček v souladu se zbytkem webu */
  .spec-strip {
    --dot: #a1a1aa;
    --dots: radial-gradient(circle, var(--dot) 1.75px, transparent 2.25px);
  }

  .dots-t {
    background-image: var(--dots);
    background-size: 16px 6px;
    background-repeat: repeat-x;
    background-position: top left;
  }

  .dots-b {
    background-image: var(--dots);
    background-size: 16px 6px;
    background-repeat: repeat-x;
    background-position: bottom left;
  }

  /* svislé tečky na desktopu pro prostřední sloupec */
  @media (min-width: 768px) {
    .dots-x-md {
      background-image: var(--dots), var(--dots);
      background-size:
        6px 16px,
        6px 16px;
      background-repeat: repeat-y, repeat-y;
      background-position:
        left top,
        right top;
    }
  }

  /* vodorovné tečky na mobilu mezi položkami */
  @media (max-width: 767px) {
    .dots-y-mobile {
      background-image: var(--dots), var(--dots);
      background-size:
        16px 6px,
        16px 6px;
      background-repeat: repeat-x, repeat-x;
      background-position:
        top left,
        bottom left;
    }
  }
</style>
