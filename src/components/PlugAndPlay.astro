---
// src/components/PlugAndPlay.astro
import {
  Armchair,
  Pocket,
  EyeOff,
  Magnet,
  Check,
} from "lucide-astro";

const placements = [
  {
    icon: Armchair,
    title: "Pod masérským stolem či lehátkem",
    desc: "Silný magnet drží na spodní kovové konstrukci. Během masáže k němu vaše ruka sklouzne poslepu, aniž by si klient čehokoliv všiml.",
    tag: "Na kovový rám lehátka",
  },
  {
    icon: Pocket,
    title: "V kapse zástěry nebo kalhot",
    desc: "Váží 28 gramů. Nosíte ho u sebe jako minci – máte ho po ruce, i když stojíte u věšáku, vítáte nového klienta nebo stojíte u pokladny.",
    tag: "Stále při sobě",
  },
  {
    icon: EyeOff,
    title: "Potají pod hranou stolku či recepce",
    desc: "Přilepené tenkou 3M páskou zespodu desky. Pro kohokoliv zvenčí je stůl prázdný, vy na tlačítko dosáhnete pouhým natažením prstů.",
    tag: "Neviditelné pro okolí",
  },
  {
    icon: Magnet,
    title: "Na kovovém vozíku či stojanu",
    desc: "Neodymový magnet drží na jakémkoliv kovu bez vrtání a nářadí. Kdykoliv si tlačítko přecvaknete tam, kde zrovna stojíte.",
    tag: "Přemístění za sekundu",
  },
];
---

<section
  id="instalace"
  class="py-24 md:py-32 bg-zinc-50 border-b border-zinc-200/80 relative"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-2xl mx-auto text-center mb-16">
      <p class="text-xs font-mono uppercase tracking-widest text-zinc-400 mb-3">
        Zprovoznění bez techniků
      </p>
      <h2
        class="text-3xl sm:text-4xl md:text-5xl font-bold font-display text-zinc-950 tracking-tight"
      >
        Žádná montáž. Žádné vrtání.
      </h2>
      <p class="text-base sm:text-lg text-zinc-600 mt-4 leading-relaxed">
        Sirénu zasunete do běžné zásuvky v salónu a tlačítko přicvaknete magnetem. Všechno je spárované už z dílny – funguje okamžitě po rozbalení.
      </p>
    </div>

    <!-- 4 Real-world placement scenarios -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {
        placements.map((item) => {
          const Icon = item.icon;
          return (
            <div class="p-6 sm:p-7 rounded-2xl bg-white border border-zinc-200/80 hover:border-zinc-300 transition-all flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <div class="w-10 h-10 rounded-xl bg-zinc-100 flex items-center justify-center text-zinc-950">
                    <Icon class="w-5 h-5 text-zinc-950" />
                  </div>
                  <span class="text-[11px] font-medium text-zinc-500 bg-zinc-50 px-2.5 py-1 rounded-md border border-zinc-200/60">
                    {item.tag}
                  </span>
                </div>

                <h3 class="text-lg font-bold text-zinc-950 mb-2">
                  {item.title}
                </h3>

                <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed">
                  {item.desc}
                </p>
              </div>

              <div class="pt-4 mt-5 border-t border-zinc-100 flex items-center gap-1.5 text-xs text-zinc-800 font-medium">
                <Check class="w-3.5 h-3.5 text-zinc-950 shrink-0" />
                <span>Bez poškození nábytku a zdí</span>
              </div>
            </div>
          );
        })
      }
    </div>

  </div>
</section>
