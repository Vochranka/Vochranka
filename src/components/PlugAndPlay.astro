---
// src/components/PlugAndPlay.astro

const installSteps = [
  {
    num: "1",
    dotClass: "bg-[#f97316]", // Vibrant orange
    title: "Zapojit",
    lines: ["Zasuňte sirénu a bránu do zásuvky.", "Spárují se samy."],
    desktopClass: "",
  },
  {
    num: "2",
    dotClass: "bg-[#fbb03b]", // Warm amber / peach
    title: "Přicvaknout",
    lines: ["Tlačítko drží pod stolem magnetem,", "nebo na tenké destičce."],
    desktopClass: "md:mt-20 lg:mt-24 md:mx-auto",
  },
  {
    num: "3",
    dotClass: "bg-[#86efac]", // Mint green
    title: "Otestovat",
    lines: ["Dvojklikem vyzkoušíte sirénu i", "doručení SMS."],
    desktopClass: "md:mt-0 md:ml-auto md:translate-x-6 lg:translate-x-12",
  },
];

const placementItems = [
  {
    num: "01",
    leftMeta: "MASÉRSKÝ STŮL",
    rightMeta: "MAGNETICKÉ UCHYCENÍ",
    title: "Schované. Přesto vždy na dosah.",
    desc: "Tlačítko drží magneticky přímo na kovovém rámu lehátka. Během masáže ho najdete poslepu, bez jediného nápadného pohybu.",
    image: "/button-under-table.jpg",
    alt: "Tísňové tlačítko magneticky přichycené pod masérským stolem",
  },
  {
    num: "02",
    leftMeta: "V KAPSE",
    rightMeta: "4,5 CM • 28 G",
    title: "Bezpečí se pohybuje s vámi.",
    desc: "Má jen 4,5 cm a váží 28 gramů. V kapse zástěry nebo kalhot o něm nevíte — dokud ho nepotřebujete.",
    image: "/button-pocket.jpg",
    alt: "Diskrétní nošení tísňového tlačítka v kapse",
  },
  {
    num: "03",
    leftMeta: "RECEPCE",
    rightMeta: "3M DESTIČKA + MAGNET",
    title: "Pro klienta neviditelné.",
    desc: "Pod hranu recepce přilepíte tenkou kovovou destičku. Tlačítko na ní drží magnetem a můžete ho kdykoliv zase vzít s sebou.",
    image: "/button-under-reception.jpg",
    alt: "Umístění tísňového tlačítka pod deskou recepce na 3M destičku",
  },
];
---

<!-- 1. INSTALACE / ŽÁDNÉ VRTÁNÍ -->
<section
  id="instalace"
  class="py-16 md:py-24 bg-white relative overflow-hidden"
>
  <!-- Horní rohová světle žlutá záře navazující ze sekce Využití -->
  <div
    class="absolute -top-20 -left-20 sm:-top-24 sm:-left-24 w-60 h-60 sm:w-72 sm:h-72 md:w-80 md:h-80 rounded-full bg-gradient-to-br from-amber-400/25 via-yellow-300/15 to-transparent blur-[60px] sm:blur-[70px] md:blur-[80px] pointer-events-none"
    aria-hidden="true"
  ></div>
  <div
    class="absolute -top-20 -right-20 sm:-top-24 sm:-right-24 w-60 h-60 sm:w-72 sm:h-72 md:w-80 md:h-80 rounded-full bg-gradient-to-bl from-amber-400/25 via-yellow-300/15 to-transparent blur-[60px] sm:blur-[70px] md:blur-[80px] pointer-events-none"
    aria-hidden="true"
  ></div>

  <!-- Spodní rohová zelená záře navazující do sekce Variabilita -->
  <div
    class="absolute -bottom-20 -left-20 sm:-bottom-24 sm:-left-24 w-60 h-60 sm:w-72 sm:h-72 md:w-80 md:h-80 rounded-full bg-gradient-to-tr from-emerald-400/25 via-emerald-300/10 to-transparent blur-[60px] sm:blur-[70px] md:blur-[80px] pointer-events-none"
    aria-hidden="true"
  ></div>
  <div
    class="absolute -bottom-20 -right-20 sm:-bottom-24 sm:-right-24 w-60 h-60 sm:w-72 sm:h-72 md:w-80 md:h-80 rounded-full bg-gradient-to-tl from-emerald-400/25 via-emerald-300/10 to-transparent blur-[60px] sm:blur-[70px] md:blur-[80px] pointer-events-none"
    aria-hidden="true"
  ></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Header sekce podle grafického návrhu -->
    <div id="install-heading-wrap" class="max-w-3xl mx-auto text-center mb-16 sm:mb-20 md:mb-28 cursor-pointer select-none group/heading">
      <h2
        class="text-4xl sm:text-5xl md:text-6xl lg:text-[4.25rem] font-extrabold tracking-tight font-display leading-[1.08]"
      >
        <span class="block text-zinc-950">
          Žádné <span class="relative inline-block">
            vrtání.
            <span
              class="strike-line absolute left-[-4px] right-[-6px] top-[56%] -translate-y-1/2 h-[3.5px] sm:h-[4.5px] md:h-[5.5px] bg-[#ef4444] rounded-full -rotate-[1deg] pointer-events-none origin-left scale-x-100 transition-transform duration-500 ease-out"
              data-strike="1"
            ></span>
          </span>
        </span>
        <span class="block text-zinc-400 mt-1 sm:mt-2">
          Žádné <span class="relative inline-block">
            kabely.
            <span
              class="strike-line absolute left-[-4px] right-[-6px] top-[56%] -translate-y-1/2 h-[3.5px] sm:h-[4.5px] md:h-[5.5px] bg-[#ef4444] rounded-full -rotate-[1deg] pointer-events-none origin-left scale-x-100 transition-transform duration-500 ease-out"
              data-strike="2"
            ></span>
          </span>
        </span>
      </h2>
      <p
        class="text-base sm:text-lg md:text-xl text-zinc-600 mt-6 sm:mt-8 font-normal leading-relaxed max-w-xl mx-auto"
      >
        Instalace zabere 2 minuty a nepotřebujete žádné nářadí.
      </p>
    </div>

    <!-- 3 kroky vlnovky / timeline (Přicvaknout uprostřed, Zapojit posunuto vpravo) -->
    <div class="relative max-w-5xl mx-auto px-4 sm:px-6">
      <!-- Desktop křivky (propojovací čárkované linie s plynulým postupným ztmavováním) -->
      <svg
        class="hidden md:block absolute inset-0 w-full h-full pointer-events-none overflow-visible"
        viewBox="0 0 1000 240"
        preserveAspectRatio="none"
        fill="none"
        aria-hidden="true"
      >
        <defs>
          <!-- 1. křivka: ze světlé stříbřitě šedé (Zapojit) do středně šedé (Přicvaknout) -->
          <linearGradient id="dash-grad-1" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#cbd5e1" />
            <stop offset="50%" stop-color="#94a3b8" />
            <stop offset="100%" stop-color="#64748b" />
          </linearGradient>

          <!-- 2. křivka: ze středně šedé (Přicvaknout) plynule navazuje do tmavého grafitu (Otestovat) -->
          <linearGradient id="dash-grad-2" x1="0%" y1="100%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#64748b" />
            <stop offset="50%" stop-color="#475569" />
            <stop offset="100%" stop-color="#0f172a" />
          </linearGradient>
        </defs>

        <!-- Křivka z kroku 1 dolů do kroku 2 -->
        <path
          d="M 265 50 C 315 50, 355 65, 370 80"
          stroke="url(#dash-grad-1)"
          stroke-width="1.75"
          stroke-dasharray="4 4"
          vector-effect="non-scaling-stroke"
        />
        <!-- Křivka z kroku 2 nahoru do kroku 3 -->
        <path
          d="M 630 160 C 685 160, 745 110, 780 45"
          stroke="url(#dash-grad-2)"
          stroke-width="1.75"
          stroke-dasharray="4 4"
          vector-effect="non-scaling-stroke"
        />
      </svg>

      <!-- Desktop: 3 sloupce rozprostřené do šířky se střídavým odsazením -->
      <div class="hidden md:grid md:grid-cols-3 gap-8 md:gap-12 lg:gap-16 relative z-10 items-start">
        {
          installSteps.map((step) => (
            <div class={`flex flex-col items-start ${step.desktopClass}`}>
              <!-- Tečka -->
              <div class={`w-3.5 h-3.5 rounded-full ${step.dotClass} mb-4 shadow-sm`} />

              <!-- Název -->
              <h3 class="text-2xl lg:text-[1.7rem] font-bold text-zinc-950 font-display mb-2.5 tracking-tight">
                {step.title}
              </h3>

              <!-- Popis s přesným zalamováním -->
              <p class="text-sm lg:text-base text-zinc-600 leading-relaxed">
                {step.lines.map((line, i) => (
                  <span>
                    {line}
                    {i < step.lines.length - 1 && <br />}
                  </span>
                ))}
              </p>
            </div>
          ))
        }
      </div>

      <!-- Mobilní verze: vycentrované kroky pod sebou s plynulým vykreslováním na scroll -->
      <div class="md:hidden flex flex-col items-center max-w-sm mx-auto px-4 text-center">
        <!-- Krok 1 -->
        <div id="mob-step-1" class="mobile-scroll-reveal flex flex-col items-center text-center">
          <div class="w-3.5 h-3.5 rounded-full bg-[#f97316] mb-3 shadow-sm" />
          <h3 class="text-xl font-bold text-zinc-950 font-display mb-1.5 tracking-tight">
            Zapojit
          </h3>
          <p class="text-sm text-zinc-600 leading-relaxed">
            Zasuňte sirénu a bránu do zásuvky.<br />Spárují se samy.
          </p>
        </div>

        <!-- Propojovací čára 1 -> 2: plynule se vykresluje podle scrollu -->
        <div id="mob-line-1" class="py-3 flex justify-center">
          <svg class="w-[2px] h-11 overflow-visible" viewBox="0 0 2 44" fill="none">
            <!-- Podkladová jemná stopa -->
            <line
              x1="1"
              y1="0"
              x2="1"
              y2="44"
              stroke="#e4e4e7"
              stroke-width="2"
              stroke-dasharray="3 3"
            />
            <!-- Vykreslující se linie -->
            <line
              class="line-progress-fill"
              x1="1"
              y1="0"
              x2="1"
              y2="44"
              stroke="#64748b"
              stroke-width="2"
              stroke-dasharray="3 3"
              style="clip-path: inset(0 0 100% 0);"
            />
          </svg>
        </div>

        <!-- Krok 2 -->
        <div id="mob-step-2" class="mobile-scroll-reveal flex flex-col items-center text-center">
          <div class="w-3.5 h-3.5 rounded-full bg-[#fbb03b] mb-3 shadow-sm" />
          <h3 class="text-xl font-bold text-zinc-950 font-display mb-1.5 tracking-tight">
            Přicvaknout
          </h3>
          <p class="text-sm text-zinc-600 leading-relaxed">
            Tlačítko drží pod stolem magnetem,<br />nebo na tenké destičce.
          </p>
        </div>

        <!-- Propojovací čára 2 -> 3: plynule se vykresluje podle scrollu -->
        <div id="mob-line-2" class="py-3 flex justify-center">
          <svg class="w-[2px] h-11 overflow-visible" viewBox="0 0 2 44" fill="none">
            <!-- Podkladová jemná stopa -->
            <line
              x1="1"
              y1="0"
              x2="1"
              y2="44"
              stroke="#e4e4e7"
              stroke-width="2"
              stroke-dasharray="3 3"
            />
            <!-- Vykreslující se linie -->
            <line
              class="line-progress-fill"
              x1="1"
              y1="0"
              x2="1"
              y2="44"
              stroke="#334155"
              stroke-width="2"
              stroke-dasharray="3 3"
              style="clip-path: inset(0 0 100% 0);"
            />
          </svg>
        </div>

        <!-- Krok 3 -->
        <div id="mob-step-3" class="mobile-scroll-reveal flex flex-col items-center text-center">
          <div class="w-3.5 h-3.5 rounded-full bg-[#86efac] mb-3 shadow-sm" />
          <h3 class="text-xl font-bold text-zinc-950 font-display mb-1.5 tracking-tight">
            Otestovat
          </h3>
          <p class="text-sm text-zinc-600 leading-relaxed">
            Dvojklikem vyzkoušíte sirénu i<br />doručení SMS.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 2. UMÍSTĚNÍ / VARIABILITA UCHYCENÍ -->
<section
  id="umisteni"
  class="py-16 md:py-24 bg-white relative overflow-hidden"
>
  <!-- Kotva pro případné starší odkazy -->
  <div id="variabilita" class="absolute -top-16 left-0 pointer-events-none"></div>

  <!-- Rohová zelená záře -->
  <div
    class="absolute -top-20 -left-20 sm:-top-24 sm:-left-24 w-60 h-60 sm:w-72 sm:h-72 md:w-80 md:h-80 rounded-full bg-gradient-to-br from-emerald-400/25 via-emerald-300/10 to-transparent blur-[60px] sm:blur-[70px] md:blur-[80px] pointer-events-none"
    aria-hidden="true"
  ></div>
  <div
    class="absolute -top-20 -right-20 sm:-top-24 sm:-right-24 w-60 h-60 sm:w-72 sm:h-72 md:w-80 md:h-80 rounded-full bg-gradient-to-bl from-emerald-400/25 via-emerald-300/10 to-transparent blur-[60px] sm:blur-[70px] md:blur-[80px] pointer-events-none"
    aria-hidden="true"
  ></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Hlavička sekce -->
    <div class="max-w-3xl mx-auto text-center mb-10 sm:mb-14 md:mb-20">
      <h2
        class="text-center text-4xl sm:text-5xl md:text-6xl lg:text-[4.25rem] font-bold md:font-extrabold tracking-tight text-zinc-950 font-display leading-[1.15] md:leading-[1.12]"
      >
        Vždy na dosah
      </h2>
      
      <p
        class="text-center text-base sm:text-base md:text-lg text-zinc-600 mt-4 leading-relaxed max-w-sm sm:max-w-xl md:max-w-2xl mx-auto"
      >
        Na kov drží samo. Jinam nalepíte tenkou destičku. Umístění můžete
        kdykoliv změnit podle toho, kde se právě cítíte nejjistěji.
      </p>
    </div>

    <!-- 3 KARTY: na mobilu nativní Apple swipe carousel, na desktopu 3 sloupce -->
    <div
      id="slider-container"
      class="flex md:grid md:grid-cols-3 overflow-x-auto snap-x snap-mandatory no-scrollbar -mx-6 px-6 gap-4 md:gap-8 scroll-smooth items-start"
      style="-webkit-overflow-scrolling: touch;"
    >
      {
        placementItems.map((item, index) => (
          <div
            class={`flex flex-col select-none w-[85vw] shrink-0 snap-center md:w-auto ${index === 1 ? 'md:mt-12 lg:mt-16' : ''}`}
          >
            <!-- Text nad fotkou -->
            <div class="pb-3 sm:pb-4 md:pb-5 flex flex-col items-center text-center md:items-start md:text-left flex-1">
              <!-- Nadpis -->
              <h3 class="text-lg sm:text-xl md:text-2xl font-bold tracking-tight text-zinc-950 mb-1.5 md:mb-2.5 leading-snug">
                {item.title}
              </h3>

              <!-- Popis -->
              <p class="text-sm sm:text-base text-zinc-600 leading-relaxed max-w-sm md:max-w-none">
                {item.desc}
              </p>
            </div>

            <!-- Obrázek -->
            <div class="relative w-full aspect-[4/3] sm:aspect-[4/5] md:aspect-[3/4] rounded-2xl md:rounded-[2rem] overflow-hidden bg-zinc-100 shadow-sm group-hover:shadow-md transition-all duration-500">
              <!-- Fotka -->
              <img
                src={item.image}
                alt={item.alt}
                class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out"
                loading="lazy"
              />
            </div>
          </div>
        ))
      }
    </div>

    <!-- Plně funkční dynamický indikátor (pouze na mobilu) -->
    <div class="flex md:hidden justify-center mt-6">
      <div
        id="slider-indicator"
        class="flex items-center gap-2.5 py-2 px-4 bg-zinc-200/90 rounded-full border border-zinc-300/40 shadow-inner"
        role="tablist"
        aria-label="Pozice v carouselu"
      >
        {
          placementItems.map((_, index) => (
            <button
              type="button"
              class={`dot h-2 rounded-full cursor-pointer transition-all duration-300 p-0 border-0 ${
                index === 0
                  ? "w-6 bg-zinc-950"
                  : "w-2 bg-zinc-400 hover:bg-zinc-600"
              }`}
              data-index={index}
              aria-label={`Přejít na kartu ${index + 1}`}
            />
          ))
        }
      </div>
    </div>

  </div>

  <!-- Spodní rohová světle žlutá záře navazující do sekce FAQ -->
  <div
    class="absolute -bottom-20 -left-20 sm:-bottom-24 sm:-left-24 w-60 h-60 sm:w-72 sm:h-72 md:w-80 md:h-80 rounded-full bg-gradient-to-tr from-amber-400/25 via-yellow-300/15 to-transparent blur-[60px] sm:blur-[70px] md:blur-[80px] pointer-events-none"
    aria-hidden="true"
  ></div>
  <div
    class="absolute -bottom-20 -right-20 sm:-bottom-24 sm:-right-24 w-60 h-60 sm:w-72 sm:h-72 md:w-80 md:h-80 rounded-full bg-gradient-to-tl from-amber-400/25 via-yellow-300/15 to-transparent blur-[60px] sm:blur-[70px] md:blur-[80px] pointer-events-none"
    aria-hidden="true"
  ></div>
</section>

<style>
  /* Jemné tečkované oddělovače (drobné technické tečky) */
  section {
    --dot: #a1a1aa;
    --dots: radial-gradient(circle, var(--dot) 0.75px, transparent 1.1px);
  }

  .dots-t {
    background-image: var(--dots);
    background-size: 8px 3px;
    background-repeat: repeat-x;
    background-position: top left;
  }

  .dots-b {
    background-image: var(--dots);
    background-size: 8px 3px;
    background-repeat: repeat-x;
    background-position: bottom left;
  }

  /* Skrytí scrollbaru pro swipe carousel */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  /* Plynulejší a pomalejší animace postupného objevování na mobilu */
  .mobile-scroll-reveal {
    opacity: 0;
    transform: translateY(22px);
    transition: opacity 0.95s cubic-bezier(0.16, 1, 0.3, 1), transform 0.95s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }

  .mobile-scroll-reveal.is-revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* Plynulé vykreslování spojovací linie na scroll */
  .line-progress-fill {
    transition: clip-path 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
    will-change: clip-path;
  }
</style>

<script>
  function initStrikeAnimation() {
    const headingWrap = document.getElementById("install-heading-wrap");
    const section = document.getElementById("instalace");
    const strikes = document.querySelectorAll(".strike-line");

    if (!strikes.length) return;

    let isAnimating = false;
    let timer1 = null;
    let timer2 = null;

    function playStrikeAnimation() {
      if (isAnimating) return;
      isAnimating = true;

      clearTimeout(timer1);
      clearTimeout(timer2);

      // Okamžitý reset do výchozího stavu bez přechodové animace
      strikes.forEach((strike) => {
        strike.style.transition = "none";
        strike.classList.remove("scale-x-100");
        strike.classList.add("scale-x-0");
      });

      // Vynucení reflow pro aplikaci nulové šířky před opětovným zapnutím transition
      if (headingWrap) void headingWrap.offsetWidth;

      // Znovupovolení plynulé CSS transition
      strikes.forEach((strike) => {
        strike.style.transition = "";
      });

      // 1. škrtnutí: vrtání.
      timer1 = setTimeout(() => {
        const s1 = document.querySelector('.strike-line[data-strike="1"]');
        if (s1) {
          s1.classList.remove("scale-x-0");
          s1.classList.add("scale-x-100");
        }
      }, 50);

      // 2. škrtnutí: kabely.
      timer2 = setTimeout(() => {
        const s2 = document.querySelector('.strike-line[data-strike="2"]');
        if (s2) {
          s2.classList.remove("scale-x-0");
          s2.classList.add("scale-x-100");
        }
      }, 260);

      // Odemknutí po dokončení tahu pro další najetí myší
      setTimeout(() => {
        isAnimating = false;
      }, 650);
    }

    // Spuštění při prvním nascrollování do sekce
    if (section) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              playStrikeAnimation();
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15 }
      );
      observer.observe(section);
    }

    // Přehrání při každém najetí myší na Žádné vrtání / Žádné kabely
    if (headingWrap) {
      headingWrap.addEventListener("mouseenter", () => {
        playStrikeAnimation();
      });

      // Přehrání i na kliknutí / tapnutí (pro mobilní telefony)
      headingWrap.addEventListener("click", () => {
        isAnimating = false;
        playStrikeAnimation();
      });

      const h2 = headingWrap.querySelector("h2");
      if (h2) {
        h2.addEventListener("mouseenter", () => {
          playStrikeAnimation();
        });
      }
    }
  }

  function initSliderIndicator() {
    const container = document.getElementById('slider-container');
    const dots = document.querySelectorAll('#slider-indicator .dot');

    if (!container || !dots.length) return;

    function setActive(activeIndex) {
      dots.forEach((dot, index) => {
        if (index === activeIndex) {
          dot.classList.remove('w-2', 'bg-zinc-400');
          dot.classList.add('w-6', 'bg-zinc-950');
        } else {
          dot.classList.remove('w-6', 'bg-zinc-950');
          dot.classList.add('w-2', 'bg-zinc-400');
        }
      });
    }

    function updateDots() {
      const scrollLeft = container.scrollLeft;
      const cards = container.querySelectorAll('.snap-center');
      if (!cards.length) return;

      const containerCenter = scrollLeft + container.clientWidth / 2;
      let closestIdx = 0;
      let minDiff = Infinity;

      cards.forEach((card, idx) => {
        const cardCenter = card.offsetLeft + card.offsetWidth / 2;
        const diff = Math.abs(containerCenter - cardCenter);
        if (diff < minDiff) {
          minDiff = diff;
          closestIdx = idx;
        }
      });

      setActive(closestIdx);
    }

    container.addEventListener('scroll', updateDots, { passive: true });
    container.addEventListener('touchmove', updateDots, { passive: true });
    container.addEventListener('touchend', () => {
      setTimeout(updateDots, 60);
      setTimeout(updateDots, 180);
      setTimeout(updateDots, 350);
    }, { passive: true });
    window.addEventListener('resize', updateDots, { passive: true });

    dots.forEach((dot, index) => {
      dot.addEventListener('click', (e) => {
        e.preventDefault();
        const cards = container.querySelectorAll('.snap-center');
        if (cards[index]) {
          cards[index].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
          setActive(index);
        }
      });
    });

    updateDots();
  }

  function initMobileStepReveal() {
    const step1 = document.getElementById("mob-step-1");
    const line1 = document.getElementById("mob-line-1");
    const step2 = document.getElementById("mob-step-2");
    const line2 = document.getElementById("mob-line-2");
    const step3 = document.getElementById("mob-step-3");

    if (!step1) return;

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.querySelectorAll(".mobile-scroll-reveal").forEach((el) => el.classList.add("is-revealed"));
      document.querySelectorAll(".line-progress-fill").forEach((el) => (el.style.clipPath = "inset(0 0 0% 0)"));
      return;
    }

    let ticking = false;

    function updateScrollProgress() {
      ticking = false;
      const vh = window.innerHeight;
      // Trigger line at 78% of viewport height (ideal reading position when scrolling down)
      const triggerY = vh * 0.78;

      // Krok 1
      const r1 = step1.getBoundingClientRect();
      if (r1.top < triggerY) {
        step1.classList.add("is-revealed");
      } else {
        step1.classList.remove("is-revealed");
      }

      // Čára 1 -> 2
      if (line1 && step2) {
        const rLine1 = line1.getBoundingClientRect();
        // Linie se plynule vykresluje od chvíle, kdy její vrchol dosáhne triggeru, až po její spodní konec
        const progress1 = Math.max(0, Math.min(1, (triggerY - rLine1.top) / (rLine1.height + 25)));
        const fill1 = line1.querySelector(".line-progress-fill");
        if (fill1) {
          fill1.style.clipPath = `inset(0 0 ${(1 - progress1) * 100}% 0)`;
        }

        // Krok 2 se objeví po čáře, a zmizí když scrollneme nahoru
        const r2 = step2.getBoundingClientRect();
        if (r2.top < triggerY && progress1 >= 0.4) {
          step2.classList.add("is-revealed");
        } else {
          step2.classList.remove("is-revealed");
        }
      }

      // Čára 2 -> 3
      if (line2 && step3) {
        const rLine2 = line2.getBoundingClientRect();
        const progress2 = Math.max(0, Math.min(1, (triggerY - rLine2.top) / (rLine2.height + 25)));
        const fill2 = line2.querySelector(".line-progress-fill");
        if (fill2) {
          fill2.style.clipPath = `inset(0 0 ${(1 - progress2) * 100}% 0)`;
        }

        // Krok 3 se objeví, a zmizí když scrollneme nahoru
        const r3 = step3.getBoundingClientRect();
        if (r3.top < triggerY && progress2 >= 0.4) {
          step3.classList.add("is-revealed");
        } else {
          step3.classList.remove("is-revealed");
        }
      }
    }

    function onScroll() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(updateScrollProgress);
      }
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    onScroll();
  }

  function initAll() {
    initStrikeAnimation();
    initSliderIndicator();
    initMobileStepReveal();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAll);
  } else {
    initAll();
  }
  document.addEventListener("astro:page-load", initAll);
</script>
