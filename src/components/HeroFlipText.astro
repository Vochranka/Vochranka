---
import { SITE_CONFIG } from "@/data/siteConfig";

interface Props {
  places?: string[];
}

const { places = SITE_CONFIG.heroPlaces } = Astro.props;
const initialPlace = places[0] || "V ORDINACI?";
---

<span
  id="hero-flip-container"
  class="relative inline-block overflow-hidden align-baseline h-[1.15em] text-white"
  data-places={JSON.stringify(places)}
  aria-live="polite"
>
  <span
    id="hero-flip-current"
    class="inline-block transition-transform duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)] will-change-transform"
  >
    {initialPlace}
  </span>
</span>

<script>
  function setupFlipWords() {
    const container = document.getElementById("hero-flip-container");
    const currentSpan = document.getElementById("hero-flip-current");

    if (!container || !currentSpan || container.dataset.initialized === "true") return;
    container.dataset.initialized = "true";

    let places: string[] = [];
    try {
      places = JSON.parse(container.dataset.places || "[]");
    } catch {
      places = [];
    }

    if (places.length <= 1) return;

    let index = 0;
    const interval = 2600;

    setInterval(() => {
      // Step 1: Flip upward out
      currentSpan.style.transform = "translateY(-110%)";
      currentSpan.style.opacity = "0";

      setTimeout(() => {
        // Step 2: Swap word and reset to bottom without transition
        index = (index + 1) % places.length;
        currentSpan.textContent = places[index];
        currentSpan.style.transition = "none";
        currentSpan.style.transform = "translateY(110%)";

        // Step 3: Trigger transition back into center
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            currentSpan.style.transition = "transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease";
            currentSpan.style.transform = "translateY(0)";
            currentSpan.style.opacity = "1";
          });
        });
      }, 500);
    }, interval);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupFlipWords);
  } else {
    setupFlipWords();
  }
  document.addEventListener("astro:page-load", setupFlipWords);
</script>
