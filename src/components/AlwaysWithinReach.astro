---

<section
  id="umisteni"
  class="relative w-full h-[60vh] min-h-[60vh] flex flex-col justify-between overflow-hidden bg-black select-none text-white py-6 sm:py-8 px-6 sm:px-[5.5%]"
  aria-label="Umístění tlačítka"
>
  <!-- Background Image with Gradient Overlays -->
  <div class="absolute inset-0 w-full h-full z-0 overflow-hidden">
    <img
      src="/button_coffeeshop.avif"
      alt="Tlačítko na kovovém rámu stolu"
      class="w-full h-full object-cover object-[center_45%]"
      loading="lazy"
      width="1024"
      height="600"
    />
    <div
      class="absolute inset-0 bg-gradient-to-r from-black/65 via-black/20 to-transparent pointer-events-none"
    >
    </div>
    <div
      class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent pointer-events-none"
    >
    </div>
  </div>

  <!-- Content Container -->
  <div class="relative z-10 w-full">
    <h2
      class="text-6xl sm:text-7xl lg:text-[104px] font-bold text-white leading-[0.98] tracking-tight"
    >
      Vždy<br />
      na dosah
    </h2>
  </div>

  <div
    class="relative z-10 self-end max-w-[380px] text-right flex flex-col items-end gap-5"
  >
    <p class="text-[17px] leading-relaxed text-white/90">
      Nespočet možností, kam svoje tlačítko umístit.
      <!-- Drží samo na magnet, v kapse i pod pultem. Jedním stiskem aktivujete
      sirénu i SMS poplach. -->
    </p>

    <a
      href="#cenik"
      class="inline-block rounded-full px-6 py-3 bg-white text-ink font-medium text-sm hover:bg-neutral-100 active:scale-95 transition-all shadow-md"
    >
      Objednat sadu
    </a>
  </div>
</section>
