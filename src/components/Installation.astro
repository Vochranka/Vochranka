---

---

<section
  id="instalace"
  class="bg-box pt-10 sm:pt-14 lg:pt-16 pb-16 sm:pb-24 px-6 sm:px-[5.5%]"
  aria-label="Instalace a garance"
>
  <div class="max-w-7xl mx-auto">
    <h2 class="sr-only">Instalace: Zapojit, přicvaknout, otestovat</h2>

    <!-- Full-width 3 rows with divider lines -->
    <div>
      <!-- Row 1: Zapojit -->
      <div class="border-b border-line py-5 sm:py-7 lg:py-8">
        <div
          class="grid grid-cols-1 lg:grid-cols-12 gap-3 lg:gap-8 items-start lg:items-center"
        >
          <div class="lg:col-span-7">
            <h3
              class="text-4xl sm:text-6xl lg:text-[76px] font-bold text-neutral-400 tracking-tight leading-[1.04]"
            >
              Zapojit
            </h3>
          </div>
          <div class="lg:col-span-5 flex lg:justify-end">
            <p
              class="text-[14px] sm:text-base lg:text-lg text-ink-muted leading-relaxed text-left w-full lg:max-w-[340px]"
            >
              Zasuňte sirénu a centrálu do zásuvky. <br
                class="hidden lg:block"
              />Samy se ihned spárují.
            </p>
          </div>
        </div>
      </div>

      <!-- Row 2: Přicvaknout -->
      <div class="border-b border-line py-5 sm:py-7 lg:py-8">
        <div
          class="grid grid-cols-1 lg:grid-cols-12 gap-3 lg:gap-8 items-start lg:items-center"
        >
          <div class="lg:col-span-7">
            <h3
              class="text-4xl sm:text-6xl lg:text-[76px] font-bold text-neutral-500 tracking-tight leading-[1.04]"
            >
              Přicvaknout
            </h3>
          </div>
          <div class="lg:col-span-5 flex lg:justify-end">
            <p
              class="text-[14px] sm:text-base lg:text-lg text-ink-muted leading-relaxed text-left w-full lg:max-w-[340px]"
            >
              Tlačítko přilne přímo na povrch, <br
                class="hidden lg:block"
              />nebo na kovovou podložku.
            </p>
          </div>
        </div>
      </div>

      <!-- Row 3: Otestovat -->
      <div class="py-5 sm:py-7 lg:py-8">
        <div
          class="grid grid-cols-1 lg:grid-cols-12 gap-3 lg:gap-8 items-start lg:items-center"
        >
          <div class="lg:col-span-7">
            <h3
              class="text-4xl sm:text-6xl lg:text-[76px] font-bold text-ink tracking-tight leading-[1.04]"
            >
              Otestovat
            </h3>
          </div>
          <div class="lg:col-span-5 flex lg:justify-end">
            <p
              class="text-[14px] sm:text-base lg:text-lg text-ink-muted leading-relaxed text-left w-full lg:max-w-[340px]"
            >
              Podržením vyzkoušíte sirénu <br class="hidden lg:block" />i
              funkčnost doručení SMS zpráv.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
