---
// src/components/Installation.astro

const installSteps = [
  {
    num: "1",
    dotClass: "bg-[#f97316]", // Vibrant orange
    title: "Zapojit",
    lines: ["Zasuňte sirénu a bránu do zásuvky.", "Spárují se samy."],
    desktopClass: "",
  },
  {
    num: "2",
    dotClass: "bg-[#fbb03b]", // Warm amber / peach
    title: "Přicvaknout",
    lines: ["Tlačítko drží pod stolem magnetem,", "nebo na tenké destičce."],
    desktopClass: "md:mt-20 lg:mt-24 md:mx-auto",
  },
  {
    num: "3",
    dotClass: "bg-[#86efac]", // Mint green
    title: "Otestovat",
    lines: ["Podržením vyzkoušíte sirénu i", "doručení SMS."],
    desktopClass: "md:mt-0 md:ml-auto md:translate-x-6 lg:translate-x-12",
  },
];
---

<!-- 1. INSTALACE / ŽÁDNÉ VRTÁNÍ -->
<section
  id="instalace"
  class="py-24 sm:py-32 md:py-36 bg-white relative overflow-hidden min-h-[100svh] flex flex-col justify-center"
>
  <!-- Horní rohová světle žlutá záře navazující ze sekce Využití -->
  <div
    class="absolute -top-20 -left-20 sm:-top-24 sm:-left-24 w-60 h-60 sm:w-72 sm:h-72 md:w-80 md:h-80 rounded-full bg-gradient-to-br from-amber-400/25 via-yellow-300/15 to-transparent blur-[60px] sm:blur-[70px] md:blur-[80px] pointer-events-none"
    aria-hidden="true"
  ></div>
  <div
    class="absolute -top-20 -right-20 sm:-top-24 sm:-right-24 w-60 h-60 sm:w-72 sm:h-72 md:w-80 md:h-80 rounded-full bg-gradient-to-bl from-amber-400/25 via-yellow-300/15 to-transparent blur-[60px] sm:blur-[70px] md:blur-[80px] pointer-events-none"
    aria-hidden="true"
  ></div>



  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Header sekce podle grafického návrhu s většími obrázky výrazně dál po stranách -->
    <div id="install-heading-wrap" class="relative max-w-7xl mx-auto text-center mb-16 sm:mb-20 md:mb-28 cursor-pointer select-none group/heading">
      <div class="flex items-center justify-between gap-4 sm:gap-8 md:gap-12">
        <!-- Levý obrázek: zrcadlově otočený, zvětšený a na levém kraji -->
        <div class="hidden sm:block shrink-0 w-28 sm:w-36 md:w-48 lg:w-60 xl:w-64 pointer-events-none -ml-4 sm:-ml-8 md:-ml-12 lg:-ml-16">
          <img
            src="/doleva.webp"
            alt="Tísňové tlačítko Vochranka"
            class="w-full h-auto drop-shadow-xl select-none transform -scale-x-100 -rotate-12 hover:rotate-[-6deg] transition-transform duration-500"
            loading="lazy"
          />
        </div>

        <!-- Nadpis uprostřed -->
        <div class="flex-1 max-w-2xl mx-auto">
          <h2
            class="text-4xl sm:text-5xl md:text-6xl lg:text-[3.25rem] xl:text-[4vw] font-extrabold tracking-tight font-display leading-[1.08]"
          >
            <span class="block text-zinc-950">
              Žádné <span class="text-[#63625C] relative inline-block">
                vrtání.
                <span
                  class="strike-line absolute left-[-4px] right-[-6px] top-[56%] -translate-y-1/2 h-[3.5px] sm:h-[4.5px] md:h-[5.5px] bg-[#ef4444] rounded-full -rotate-[1deg] pointer-events-none origin-left scale-x-100 transition-transform duration-500 ease-out"
                  data-strike="1"
                ></span>
              </span>
            </span>
            <span class="block text-zinc-950 mt-1 sm:mt-2">
              Žádné <span class="text-[#63625C] relative inline-block">
                kabely.
                <span
                  class="strike-line absolute left-[-4px] right-[-6px] top-[56%] -translate-y-1/2 h-[3.5px] sm:h-[4.5px] md:h-[5.5px] bg-[#ef4444] rounded-full -rotate-[1deg] pointer-events-none origin-left scale-x-100 transition-transform duration-500 ease-out"
                  data-strike="2"
                ></span>
              </span>
            </span>
          </h2>

          <p
            class="text-base sm:text-lg md:text-xl text-zinc-600 mt-6 sm:mt-8 font-normal leading-relaxed max-w-xl mx-auto"
          >
            Instalace zabere 2 minuty a bez nářadí.
          </p>
        </div>

        <!-- Pravý obrázek: zvětšený a na pravém kraji -->
        <div class="hidden sm:block shrink-0 w-28 sm:w-36 md:w-48 lg:w-60 xl:w-64 pointer-events-none -mr-4 sm:-mr-8 md:-mr-12 lg:-mr-16">
          <img
            src="/doleva.webp"
            alt="Tísňové tlačítko Vochranka"
            class="w-full h-auto drop-shadow-xl select-none transform rotate-12 hover:rotate-[6deg] transition-transform duration-500"
            loading="lazy"
          />
        </div>
      </div>
    </div>

    <!-- 3 KROKY INSTALACE (Desktop i Mobil) -->
    <div id="install-steps-container" class="relative max-w-5xl mx-auto px-4 sm:px-6">
      <!-- Desktop křivky (propojovací čárkované linie s plynulým postupným ztmavováním) -->
      <svg
        class="hidden md:block absolute inset-0 w-full h-full pointer-events-none overflow-visible"
        viewBox="0 0 1000 240"
        preserveAspectRatio="none"
        fill="none"
        aria-hidden="true"
      >
        <defs>
          <!-- 1. křivka: ze světlé stříbřitě šedé (Zapojit) do středně šedé (Přicvaknout) -->
          <linearGradient id="dash-grad-1" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#cbd5e1" />
            <stop offset="50%" stop-color="#94a3b8" />
            <stop offset="100%" stop-color="#64748b" />
          </linearGradient>

          <!-- 2. křivka: ze středně šedé (Přicvaknout) plynule navazuje do tmavého grafitu (Otestovat) -->
          <linearGradient id="dash-grad-2" x1="0%" y1="100%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#64748b" />
            <stop offset="50%" stop-color="#475569" />
            <stop offset="100%" stop-color="#0f172a" />
          </linearGradient>

          <!-- Masky pro odhalování křivek se zachováním čárkovaného vzoru (4 4) -->
          <mask id="curve-mask-1" maskUnits="userSpaceOnUse">
            <path
              id="mask-path-1"
              d="M 265 50 C 315 50, 355 65, 370 80"
              stroke="#ffffff"
              stroke-width="8"
              fill="none"
              stroke-dasharray="250"
              stroke-dashoffset="250"
            />
          </mask>

          <mask id="curve-mask-2" maskUnits="userSpaceOnUse">
            <path
              id="mask-path-2"
              d="M 630 160 C 685 160, 745 110, 780 45"
              stroke="#ffffff"
              stroke-width="8"
              fill="none"
              stroke-dasharray="250"
              stroke-dashoffset="250"
            />
          </mask>
        </defs>

        <!-- Křivka z kroku 1 dolů do kroku 2 -->
        <path
          id="desktop-curve-1"
          class="desktop-line-curve"
          mask="url(#curve-mask-1)"
          d="M 265 50 C 315 50, 355 65, 370 80"
          stroke="url(#dash-grad-1)"
          stroke-width="1.75"
          stroke-dasharray="4 4"
          vector-effect="non-scaling-stroke"
        />
        <!-- Křivka z kroku 2 nahoru do kroku 3 -->
        <path
          id="desktop-curve-2"
          class="desktop-line-curve"
          mask="url(#curve-mask-2)"
          d="M 630 160 C 685 160, 745 110, 780 45"
          stroke="url(#dash-grad-2)"
          stroke-width="1.75"
          stroke-dasharray="4 4"
          vector-effect="non-scaling-stroke"
        />
      </svg>

      <!-- Desktop: 3 sloupce rozprostřené do šířky se střídavým odsazením -->
      <div class="hidden md:grid md:grid-cols-3 gap-8 md:gap-12 lg:gap-16 relative z-10 items-start">
        {
          installSteps.map((step, idx) => (
            <div id={`desk-step-${idx + 1}`} class={`step-item flex flex-col items-start ${step.desktopClass}`}>
              <!-- Tečka -->
              <div class={`step-dot w-3.5 h-3.5 rounded-full ${step.dotClass} mb-4 shadow-sm`} />

              <!-- Text wrapper -->
              <div class="step-text">
                <h3 class="text-2xl lg:text-[1.7rem] font-bold text-zinc-950 font-display mb-2.5 tracking-tight">
                  {step.title}
                </h3>

                <p class="text-sm lg:text-base text-zinc-600 leading-relaxed">
                  {step.lines.map((line, i) => (
                    <span>
                      {line}
                      {i < step.lines.length - 1 && <br />}
                    </span>
                  ))}
                </p>
              </div>
            </div>
          ))
        }
      </div>

      <!-- Mobilní verze: rozložení vlevo (Zapojit), vpravo (Přicvaknout), vlevo (Otestovat) s centrovanými čarami a postupným vyplněním -->
      <div class="md:hidden relative w-full max-w-sm mx-auto px-4 py-4 flex flex-col items-center">
        <!-- Krok 1 (VLEVO) -->
        <div id="mob-step-1" class="step-item relative z-10 flex flex-col items-start text-left w-full max-w-[240px] mr-auto">
          <div class="step-dot w-3.5 h-3.5 rounded-full bg-[#f97316] mb-3 shadow-sm" />
          <div class="step-text">
            <h3 class="text-xl font-bold text-zinc-950 font-display mb-1.5 tracking-tight">
              Zapojit
            </h3>
            <p class="text-sm text-zinc-600 leading-relaxed">
              Zasuňte sirénu a bránu do zásuvky.<br />
              <span>Spárují se samy.</span>
            </p>
          </div>
        </div>

        <!-- 1. Vertikální propojovací čára uprostřed (mezi krokem 1 a 2, umístěná níže) -->
        <div id="mob-line-1" class="py-5 flex justify-center w-full">
          <svg class="w-[2px] h-14 overflow-visible" viewBox="0 0 2 56" fill="none">
            <!-- Podkladová světlá stopa -->
            <line
              x1="1"
              y1="0"
              x2="1"
              y2="56"
              stroke="#e4e4e7"
              stroke-width="2"
              stroke-dasharray="3 3"
            />
            <!-- Vykreslující se linie s animací vyplnění -->
            <line
              class="line-progress-fill"
              x1="1"
              y1="0"
              x2="1"
              y2="56"
              stroke="#64748b"
              stroke-width="2"
              stroke-dasharray="3 3"
              style="clip-path: inset(0 0 100% 0);"
            />
          </svg>
        </div>

        <!-- Krok 2 (VPRAVO) -->
        <div id="mob-step-2" class="step-item relative z-10 flex flex-col items-end text-right w-full max-w-[245px] ml-auto">
          <div class="step-dot w-3.5 h-3.5 rounded-full bg-[#fbb03b] mb-3 shadow-sm" />
          <div class="step-text">
            <h3 class="text-xl font-bold text-zinc-950 font-display mb-1.5 tracking-tight">
              Přicvaknout
            </h3>
            <p class="text-sm text-zinc-600 leading-relaxed">
              Tlačítko drží pod stolem magnetem,<br />
              nebo na tenké destičce.
            </p>
          </div>
        </div>

        <!-- 2. Vertikální propojovací čára uprostřed (mezi krokem 2 a 3) -->
        <div id="mob-line-2" class="py-5 flex justify-center w-full">
          <svg class="w-[2px] h-14 overflow-visible" viewBox="0 0 2 56" fill="none">
            <!-- Podkladová světlá stopa -->
            <line
              x1="1"
              y1="0"
              x2="1"
              y2="56"
              stroke="#e4e4e7"
              stroke-width="2"
              stroke-dasharray="3 3"
            />
            <!-- Vykreslující se linie s animací vyplnění -->
            <line
              class="line-progress-fill"
              x1="1"
              y1="0"
              x2="1"
              y2="56"
              stroke="#0f172a"
              stroke-width="2"
              stroke-dasharray="3 3"
              style="clip-path: inset(0 0 100% 0);"
            />
          </svg>
        </div>

        <!-- Krok 3 (VLEVO) -->
        <div id="mob-step-3" class="step-item relative z-10 flex flex-col items-start text-left w-full max-w-[240px] mr-auto">
          <div class="step-dot w-3.5 h-3.5 rounded-full bg-[#86efac] mb-3 shadow-sm" />
          <div class="step-text">
            <h3 class="text-xl font-bold text-zinc-950 font-display mb-1.5 tracking-tight">
              Otestovat
            </h3>
            <p class="text-sm text-zinc-600 leading-relaxed">
              Podržením vyzkoušíte sirénu i<br />doručení SMS.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .step-dot {
    transform-origin: center center;
    will-change: transform, opacity;
  }

  .step-text {
    will-change: transform, opacity;
  }

  .desktop-line-curve {
    will-change: stroke-dashoffset;
  }

  .line-progress-fill {
    will-change: clip-path;
  }
</style>

<script>
  function initStrikeAnimation() {
    const headingWrap = document.getElementById("install-heading-wrap");
    const section = document.getElementById("instalace");
    const strikes = document.querySelectorAll(".strike-line");

    if (!strikes.length) return;

    let isAnimating = false;
    let timer1: number | null = null;
    let timer2: number | null = null;

    function playStrikeAnimation() {
      if (isAnimating) return;
      isAnimating = true;

      if (timer1) clearTimeout(timer1);
      if (timer2) clearTimeout(timer2);

      // Okamžitý reset do výchozího stavu bez přechodové animace
      strikes.forEach((strike) => {
        (strike as HTMLElement).style.transition = "none";
        strike.classList.remove("scale-x-100");
        strike.classList.add("scale-x-0");
      });

      // Vynucení reflow pro aplikaci nulové šířky před opětovným zapnutím transition
      if (headingWrap) void headingWrap.offsetWidth;

      // Znovupovolení plynulé CSS transition
      strikes.forEach((strike) => {
        (strike as HTMLElement).style.transition = "";
      });

      // 1. škrtnutí: vrtání.
      timer1 = setTimeout(() => {
        const s1 = document.querySelector('.strike-line[data-strike="1"]');
        if (s1) {
          s1.classList.remove("scale-x-0");
          s1.classList.add("scale-x-100");
        }
      }, 50);

      // 2. škrtnutí: kabely.
      timer2 = setTimeout(() => {
        const s2 = document.querySelector('.strike-line[data-strike="2"]');
        if (s2) {
          s2.classList.remove("scale-x-0");
          s2.classList.add("scale-x-100");
        }
      }, 260);

      // Odemknutí po dokončení tahu pro další najetí myší
      setTimeout(() => {
        isAnimating = false;
      }, 650);
    }

    // Spuštění při prvním nascrollování do sekce
    if (section) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              playStrikeAnimation();
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15 }
      );
      observer.observe(section);
    }

    // Přehrání při každém najetí myší na Žádné vrtání / Žádné kabely
    if (headingWrap) {
      headingWrap.addEventListener("mouseenter", () => {
        playStrikeAnimation();
      });

      // Přehrání i na kliknutí / tapnutí (pro mobilní telefony)
      headingWrap.addEventListener("click", () => {
        isAnimating = false;
        playStrikeAnimation();
      });

      const h2 = headingWrap.querySelector("h2");
      if (h2) {
        h2.addEventListener("mouseenter", () => {
          playStrikeAnimation();
        });
      }
    }
  }

  function initScrollScrubAnimation() {
    const container = document.getElementById("install-steps-container");
    if (!container) return;

    // Elements
    const deskStep1 = document.getElementById("desk-step-1");
    const deskStep2 = document.getElementById("desk-step-2");
    const deskStep3 = document.getElementById("desk-step-3");
    const maskPath1 = document.getElementById("mask-path-1") as SVGPathElement | null;
    const maskPath2 = document.getElementById("mask-path-2") as SVGPathElement | null;

    const mobStep1 = document.getElementById("mob-step-1");
    const mobStep2 = document.getElementById("mob-step-2");
    const mobStep3 = document.getElementById("mob-step-3");
    const mobLine1 = document.querySelector("#mob-line-1 .line-progress-fill") as HTMLElement | null;
    const mobLine2 = document.querySelector("#mob-line-2 .line-progress-fill") as HTMLElement | null;

    // Measure desktop path lengths
    let pathLen1 = 250;
    let pathLen2 = 250;
    if (maskPath1) {
      try {
        pathLen1 = Math.ceil(maskPath1.getTotalLength()) || 250;
        maskPath1.style.strokeDasharray = `${pathLen1}`;
        maskPath1.style.strokeDashoffset = `${pathLen1}`;
      } catch (e) {}
    }
    if (maskPath2) {
      try {
        pathLen2 = Math.ceil(maskPath2.getTotalLength()) || 250;
        maskPath2.style.strokeDasharray = `${pathLen2}`;
        maskPath2.style.strokeDashoffset = `${pathLen2}`;
      } catch (e) {}
    }

    const isReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    function applyState(
      stepEl: HTMLElement | null,
      p: number, // 0 to 1
    ) {
      if (!stepEl) return;
      const dot = stepEl.querySelector(".step-dot") as HTMLElement | null;
      const text = stepEl.querySelector(".step-text") as HTMLElement | null;
      if (isReduced) {
        if (dot) {
          dot.style.opacity = "1";
          dot.style.transform = "scale(1)";
        }
        if (text) {
          text.style.opacity = "1";
          text.style.transform = "translateY(0px)";
        }
        return;
      }

      if (dot) {
        dot.style.opacity = String(p);
        dot.style.transform = `scale(${p})`;
      }
      if (text) {
        text.style.opacity = String(p);
        text.style.transform = `translateY(${(1 - p) * 12}px)`;
      }
    }

    function applyMaskCurve(
      maskEl: SVGPathElement | null,
      p: number, // 0 to 1
      totalLen: number
    ) {
      if (!maskEl) return;
      if (isReduced) {
        maskEl.style.strokeDashoffset = "0";
        return;
      }
      maskEl.style.strokeDashoffset = `${totalLen * (1 - p)}`;
    }

    function applyMobLine(lineEl: HTMLElement | null, p: number) {
      if (!lineEl) return;
      if (isReduced) {
        lineEl.style.clipPath = "inset(0 0 0% 0)";
        return;
      }
      lineEl.style.clipPath = `inset(0 0 ${(1 - p) * 100}% 0)`;
    }

    // Helper clamping
    const clamp01 = (v: number) => Math.max(0, Math.min(1, v));
    const rangeProgress = (progress: number, start: number, end: number) => {
      if (progress <= start) return 0;
      if (progress >= end) return 1;
      return (progress - start) / (end - start);
    };

    let ticking = false;

    function update() {
      ticking = false;
      const vh = window.innerHeight;
      const isMobile = window.innerWidth < 768;

      if (!isMobile) {
        const rect = container!.getBoundingClientRect();
        const startY = vh * 0.90;
        const endY = vh * 0.30;
        const totalDist = startY - endY;
        const currentPos = startY - rect.top;
        const progress = clamp01(currentPos / totalDist);

        const pStep1 = rangeProgress(progress, 0.0, 0.20);
        const pCurve1 = rangeProgress(progress, 0.20, 0.50);
        const pStep2 = rangeProgress(progress, 0.50, 0.65);
        const pCurve2 = rangeProgress(progress, 0.65, 0.85);
        const pStep3 = rangeProgress(progress, 0.85, 1.0);

        applyState(deskStep1, pStep1);
        applyMaskCurve(maskPath1, pCurve1, pathLen1);
        applyState(deskStep2, pStep2);
        applyMaskCurve(maskPath2, pCurve2, pathLen2);
        applyState(deskStep3, pStep3);
      } else {
        // Mobile vertical scrubbing: each step & vertical connecting line scrubs
        // directly as it enters and moves across the phone viewport
        const calcElemScrub = (el: HTMLElement | null, offsetRatio = 0.88, dist = 140) => {
          if (!el) return 0;
          const top = el.getBoundingClientRect().top;
          const trigger = vh * offsetRatio;
          return clamp01((trigger - top) / dist);
        };

        const mStep1 = calcElemScrub(mobStep1, 0.90, 130);
        const mLine1 = calcElemScrub(document.getElementById("mob-line-1"), 0.86, 100);
        const mStep2 = calcElemScrub(mobStep2, 0.86, 130);
        const mLine2 = calcElemScrub(document.getElementById("mob-line-2"), 0.82, 100);
        const mStep3 = calcElemScrub(mobStep3, 0.82, 130);

        applyState(mobStep1, mStep1);
        applyMobLine(mobLine1, mLine1);
        applyState(mobStep2, mStep2);
        applyMobLine(mobLine2, mLine2);
        applyState(mobStep3, mStep3);
      }
    }

  function onScroll() {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(update);
    }
  }

  function onResize() {
    if (maskPath1) {
      try {
        pathLen1 = Math.ceil(maskPath1.getTotalLength()) || 250;
        maskPath1.style.strokeDasharray = `${pathLen1}`;
      } catch (e) {}
    }
    if (maskPath2) {
      try {
        pathLen2 = Math.ceil(maskPath2.getTotalLength()) || 250;
        maskPath2.style.strokeDasharray = `${pathLen2}`;
      } catch (e) {}
    }
    onScroll();
  }

  window.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("resize", onResize, { passive: true });
  update();
}

  function initAll() {
    initStrikeAnimation();
    initScrollScrubAnimation();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAll);
  } else {
    initAll();
  }
  document.addEventListener("astro:page-load", initAll);
</script>
