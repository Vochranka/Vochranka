---
import { ArrowRight } from "lucide-astro";
import { SITE_CONFIG } from "@/data/siteConfig";

const steps = SITE_CONFIG.installationSteps;
const guarantees = SITE_CONFIG.guarantees;
---

<section
  id="instalace"
  class="py-20 sm:py-28 lg:py-36 px-6 sm:px-12 lg:px-20 bg-[#F4F4F4] select-none overflow-hidden"
  aria-label="Instalace"
>
  <div class="max-w-[1260px] mx-auto">
    
    <!-- 1. TOP PART: The 3 steps on the left + Circular button illustration on the right -->
    <div class="relative grid grid-cols-1 lg:grid-cols-12 gap-8 items-center border-t border-[#DDDDDD]">
      <!-- Left side: 3 steps -->
      <div class="lg:col-span-7 divide-y divide-[#DDDDDD] text-left">
        <!-- Zapojit -->
        <div class="py-7 sm:py-8">
          <h3 class="font-sans font-light text-3xl sm:text-4xl lg:text-[46px] text-[#2B2523] tracking-[-0.03em] leading-tight mb-2">
            Zapojit
          </h3>
          <p class="font-mono text-xs sm:text-[13px] text-[#6B6560] leading-[1.4] max-w-sm font-normal">
            Zapojte sirénu a ovladač do zásuvky. Vše se spáruje automaticky.
          </p>
        </div>

        <!-- Přicvaknout -->
        <div class="py-7 sm:py-8">
          <h3 class="font-sans font-light text-3xl sm:text-4xl lg:text-[46px] text-[#2B2523] tracking-[-0.03em] leading-tight mb-2">
            Přicvaknout
          </h3>
          <p class="font-mono text-xs sm:text-[13px] text-[#6B6560] leading-[1.4] max-w-sm font-normal">
            Tlačítko přilne přímo na pevný povrch nebo na kovovou podložku.
          </p>
        </div>

        <!-- Otestovat -->
        <div class="py-7 sm:py-8">
          <h3 class="font-sans font-light text-3xl sm:text-4xl lg:text-[46px] text-[#2B2523] tracking-[-0.03em] leading-tight mb-2">
            Otestovat
          </h3>
          <p class="font-mono text-xs sm:text-[13px] text-[#6B6560] leading-[1.4] max-w-sm font-normal">
            Potřebné vyzkoušíte sirénu i funkčnost zkušební SMS zprávy.
          </p>
        </div>
      </div>

      <!-- Right side: Big round button illustration matching Figma node 5:14 -->
      <div class="lg:col-span-5 flex items-center justify-center lg:justify-end py-6">
        <div class="w-full max-w-[440px] sm:max-w-[480px] lg:max-w-[520px] aspect-square flex items-center justify-center">
          <img
            src="/figma-tlacitko-5-14.png"
            alt="Vochránka tísňové tlačítko"
            class="w-full h-full object-contain filter drop-shadow-[0_25px_50px_rgba(0,0,0,0.06)]"
            loading="lazy"
            width="541"
            height="500"
          />
        </div>
      </div>
    </div>

    <!-- 2. BOTTOM PART: Giant Full-Width "OBJEDNAT SADU" Banner with accent line directly below -->
    <div class="mt-16 sm:mt-24 text-left">
      <a
        href="#kontakt"
        class="group block select-none focus-visible:outline-none"
        aria-label="Přejít k objednání sady Vochránka"
      >
        <span class="font-sans font-bold text-5xl sm:text-8xl md:text-9xl lg:text-[130px] xl:text-[150px] tracking-[-0.06em] text-[#2B2523] leading-none uppercase block mb-4 group-hover:text-black transition-colors">
          OBJEDNAT SADU
        </span>
        <div class="w-full h-[4px] bg-[#A9532E]"></div>
      </a>
    </div>

  </div>
</section>
