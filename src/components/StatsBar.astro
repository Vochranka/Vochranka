---
import { SITE_CONFIG } from "@/data/siteConfig";

const stats = SITE_CONFIG.stats;
---

<section class="bg-white border-b border-black/10 py-10 sm:py-14 px-4 sm:px-8 lg:px-12 select-none" aria-label="Klíčové parametry">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-black/10">
      {
        stats.map((stat) => (
          <div class="py-6 md:py-0 md:px-8 first:pl-0 last:pr-0 text-left">
            <span class="font-heading font-black text-4xl sm:text-5xl lg:text-6xl text-ink tracking-tight block leading-none">
              {stat.value}
            </span>
            <p class="text-xs sm:text-sm text-black/60 mt-2 font-medium">
              {stat.label}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>

