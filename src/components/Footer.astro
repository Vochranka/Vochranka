---
import {
  ShieldCheck,
  Mail,
  Phone,
  Instagram,
  Heart,
  MapPin,
} from "lucide-astro";
---

<footer class="bg-white text-zinc-600 py-12">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-10">
      
      <!-- Brand & Mission -->
      <div class="flex flex-col items-start gap-3 lg:max-w-sm">
        <span class="text-xl font-bold font-display tracking-tight text-zinc-950">
          Vochranka
        </span>
        <p class="text-xs sm:text-sm text-zinc-600 text-left leading-relaxed">
          Bezpečnostní systém navržen s empatií pro sólo masérky, kosmetičky, terapeutky. Pro klid při každém klientském setkání.
        </p>
      </div>

      <!-- Contact Info in a row on desktop/tablet, stacked left on mobile -->
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6 sm:gap-8 text-sm font-medium text-zinc-800 relative">
        <!-- Žlutá záře -->
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[150%] h-[150%] bg-yellow-400/20 blur-[50px] pointer-events-none -z-10 rounded-full"></div>

        <a href="mailto:info@vochranka.cz" class="flex items-center gap-2 hover:text-zinc-950 hover:underline transition-all">
          <Mail class="w-4 h-4 text-zinc-900 shrink-0" />
          <span>info@vochranka.cz</span>
        </a>

        <div class="flex items-start sm:items-center gap-2">
          <MapPin class="w-4 h-4 text-zinc-900 shrink-0 sm:mt-0 mt-0.5" />
          <span class="text-left">
            Praha <span class="hidden sm:inline">|</span><br class="sm:hidden" />
            <span class="text-[11px] text-zinc-500 font-normal">Osobní zkoušky po domluvě</span>
          </span>
        </div>

        <a href="https://instagram.com/vochranka.cz" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 hover:text-zinc-950 transition-colors">
          <Instagram class="w-4 h-4 text-zinc-900 shrink-0" />
          <span>@vochranka.cz</span>
        </a>
      </div>

    </div>

    <!-- Bottom copyright -->
    <div class="mt-12 pt-8 flex items-start sm:items-center sm:justify-center text-xs text-zinc-500">
      <p>© {new Date().getFullYear()} Vochranka. Všechna práva vyhrazena.</p>
    </div>
  </div>
</footer>
