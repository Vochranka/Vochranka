---
import { SITE_CONFIG } from "@/data/siteConfig";

const { name, contact, navLinks } = SITE_CONFIG;
---

<footer class="py-16 sm:py-24 px-6 sm:px-12 lg:px-20 bg-white select-none">
  <div class="max-w-[1260px] mx-auto text-left">
    <!-- Giant Logo Heading -->
    <div class="mb-12 sm:mb-16">
      <h2 class="font-sans font-bold text-6xl sm:text-7xl lg:text-[84px] text-[#2B2523] tracking-[-0.05em] leading-none uppercase">
        VOCHRANKA
      </h2>
    </div>

    <!-- 3 Columns Footer info matching Figma node 7:44 -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start pt-6 border-t border-[#CFCFCF]">
      <!-- Column 1: Mission text -->
      <div class="md:col-span-4">
        <p class="font-mono text-[11px] text-[#2B2523] leading-[1.5] max-w-[340px] font-normal">
          Bezpečnostní systém navržený s empatií pro lidi v kontaktu se zákazníky: maséry, kosmetičky, terapeuty. Pro klid při každé návštěvě.
        </p>
      </div>

      <!-- Column 2: Contact -->
      <div class="md:col-span-4 space-y-1 font-mono text-[11px] text-[#2B2523]">
        <p>
          <a href="mailto:info@vochranka.cz" class="underline hover:text-black">
            info@vochranka.cz
          </a>
        </p>
        <p class="text-[#2B2523]">
          Praha | Česká republika po domluvě
        </p>
        <p>
          <a href="https://instagram.com/vochranka.cz" target="_blank" rel="noopener noreferrer" class="underline hover:text-black">
            @vochranka.cz
          </a>
        </p>
      </div>

      <!-- Column 3: Copyright -->
      <div class="md:col-span-4 md:text-right">
        <p class="font-mono text-[11px] text-[#2B2523]">
          © 2026 Vochranka. Všechna práva vyhrazena.
        </p>
      </div>
    </div>
  </div>
</footer>
