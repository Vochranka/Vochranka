---
import {
  Play,
  Pause,
  Volume2,
  VolumeX,
  ShieldCheck,
  Bell,
  MessageSquare,
  Check,
  Sparkles,
  ChevronDown,
} from "lucide-astro";
---

<section
  class="relative w-full min-h-screen lg:h-screen flex flex-col justify-between pt-24 pb-6 md:pt-28 md:pb-8 overflow-hidden text-white"
>
  <!-- Full-Bleed Background Video with Overlays -->
  <div
    class="absolute inset-0 w-full h-full -z-20 overflow-hidden bg-anthracite-950"
  >
    <video
      id="hero-bg-video"
      autoplay
      muted
      loop
      playsinline
      webkit-playsinline
      x5-playsinline
      preload="metadata"
      disablepictureinpicture
      disableRemotePlayback
      class="w-full h-full object-cover opacity-90 transition-opacity duration-700"
    >
      <source src="/vochranka-video-optimized.mp4" type="video/mp4" />
      Váš prohlížeč nepodporuje přehrávání videa.
    </video>

    <!-- Deep cinematic gradient overlay for readability & contrast (fading to transparent on the right) -->
    <div
      class="absolute inset-0 bg-gradient-to-r from-anthracite-950/90 via-anthracite-950/50 to-transparent pointer-events-none"
    >
    </div>
    <div
      class="absolute inset-0 bg-gradient-to-t from-anthracite-950/80 via-transparent to-anthracite-950/25 pointer-events-none"
    >
    </div>
  </div>

  <!-- Headline Content: nahoře a na střed na mobilu, vlevo na desktopu (0 až 4 sekundy) -->
  <div
    id="hero-left-text"
    class="max-w-[1720px] mx-auto px-6 sm:px-10 lg:px-16 xl:px-24 w-full relative z-10 pt-10 sm:pt-14 md:pt-0 mt-2 sm:mt-4 md:my-auto transition-all duration-700 opacity-100 translate-y-0"
  >
    <div class="max-w-xl mx-auto md:mx-0 text-center md:text-left">
      <!-- Main Heading (Hesla se postupně objevují) -->
      <h1
        class="text-5xl sm:text-6xl md:text-6xl lg:text-[4.5rem] font-extrabold font-display text-white tracking-tight leading-[1.08] drop-shadow-md"
      >
        <span
          id="word-klik"
          class="block transition-all duration-500 opacity-0 translate-y-2"
        >
          Klik.
        </span>
        <span
          id="word-alarm"
          class="block text-red-500 transition-all duration-500 opacity-0 translate-y-2"
        >
          <span id="hero-alarm" class="inline-block transition-all duration-300"
            >Alarm.</span
          >
        </span>
        <span
          id="word-sos"
          class="block text-white transition-all duration-500 opacity-0 translate-y-2"
        >
          SOS zpráva.
        </span>
      </h1>
    </div>
  </div>

  <!-- Centered Message: Buďte vždy v bezpečí. (od 4. sekundy) -->
  <div
    id="hero-center-safety"
    class="absolute inset-0 z-10 flex items-center justify-center pointer-events-none px-4 sm:px-6 lg:px-8 xl:px-12 transition-all duration-700 opacity-0 scale-95"
  >
    <h2
      class="w-full text-5xl sm:text-6xl md:text-7xl lg:text-[8.5vw] xl:text-[9.5vw] 2xl:text-[10vw] font-extrabold text-white text-center tracking-tight lg:tracking-tighter drop-shadow-[0_10px_35px_rgba(0,0,0,0.85)] font-display leading-[1.05] lg:leading-[0.95] lg:whitespace-nowrap -translate-y-32 sm:-translate-y-36 md:-translate-y-32 lg:-translate-y-6 select-none"
    >
      Buďte vždy v bezpečí.
    </h2>
  </div>

  <!-- Bottom Centered Area: CTA Action Buttons + Scroll Down Indicator -->
  <div
    class="relative z-20 w-full px-4 flex flex-col items-center justify-center gap-4"
  >
    <!-- CTA Action Buttons -->
    <div
      class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 w-full sm:w-auto"
    >
      <a
        href="#objednavka"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-3.5 rounded-full text-base font-semibold text-zinc-950 bg-white hover:bg-zinc-100 active:scale-[0.99] transition-all duration-200 shadow-lg hover:scale-105"
      >
        <span>Chci sadu do salónu</span>
      </a>

      <a
        href="#jak-to-funguje"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full text-base font-medium text-white bg-white/15 hover:bg-white/25 backdrop-blur-md border border-white/20 active:scale-[0.99] transition-all duration-200 group cursor-pointer shadow-sm hover:scale-105"
      >
        <span>Chci vědět víc</span>
      </a>
    </div>

    <!-- Animated scroll down arrow indicator -->
    <a
      href="#jak-to-funguje"
      class="flex flex-col items-center justify-center p-2 text-stone-300 hover:text-white transition-all duration-300 hover:scale-110 group mt-1"
      aria-label="Přejít na další sekci"
    >
      <ChevronDown
        class="w-6 h-6 text-stone-300 group-hover:text-white animate-bounce transition-colors drop-shadow"
      />
    </a>
  </div>

  <!-- Mobile Sound Toggle Button (Diskrétní tlačítko zvuku jen na telefonu) -->
  <button
    id="mobile-sound-toggle-btn"
    type="button"
    class="md:hidden absolute top-20 right-4 z-30 p-2.5 rounded-full bg-black/50 backdrop-blur-md border border-white/20 text-white shadow-soft-md active:scale-95 transition-all"
    aria-label="Zapnout / Vypnout zvuk videa"
    title="Zvuk videa"
  >
    <VolumeX class="w-4 h-4" id="mobile-sound-muted-icon" />
    <Volume2 class="w-4 h-4 hidden" id="mobile-sound-unmuted-icon" />
  </button>

  <!-- Ambient Video Controls Bar in Bottom-Right Corner of Hero (pouze na počítači / tabletu) -->
  <div
    class="hidden md:flex absolute bottom-6 right-6 z-20 items-center gap-2 bg-black/60 backdrop-blur-md px-3.5 py-1.5 rounded-full border border-white/15 text-xs text-stone-300 shadow-soft-md"
  >
    <button
      id="video-toggle-play"
      type="button"
      class="hover:text-white transition-colors flex items-center gap-1 cursor-pointer focus:outline-none"
      title="Pozastavit / Spustit video"
      aria-label="Pozastavit nebo spustit video"
    >
      <Pause class="w-3.5 h-3.5" id="video-pause-icon" />
      <Play class="w-3.5 h-3.5 hidden" id="video-play-icon" />
      <span class="text-[11px]" id="video-play-label">Pozastavit</span>
    </button>
    <span class="text-stone-600">|</span>
    <button
      id="video-toggle-sound"
      type="button"
      class="hover:text-white transition-colors flex items-center gap-1 cursor-pointer focus:outline-none"
      title="Zapnout / Vypnout zvuk"
      aria-label="Zapnout nebo vypnout zvuk"
    >
      <VolumeX class="w-3.5 h-3.5" id="video-sound-muted-icon" />
      <Volume2 class="w-3.5 h-3.5 hidden" id="video-sound-unmuted-icon" />
      <span class="text-[11px]" id="video-sound-label">Zvuk vypnut</span>
    </button>
  </div>
</section>

<script>
  const videoEl = document.getElementById("hero-bg-video") as HTMLVideoElement;
  const togglePlayBtn = document.getElementById("video-toggle-play");
  const toggleSoundBtn = document.getElementById("video-toggle-sound");
  const playLabel = document.getElementById("video-play-label");
  const soundLabel = document.getElementById("video-sound-label");
  const pauseIcon = document.getElementById("video-pause-icon");
  const playIcon = document.getElementById("video-play-icon");
  const soundMutedIcon = document.getElementById("video-sound-muted-icon");
  const soundUnmutedIcon = document.getElementById("video-sound-unmuted-icon");
  const mobileSoundBtn = document.getElementById("mobile-sound-toggle-btn");
  const mobileMutedIcon = document.getElementById("mobile-sound-muted-icon");
  const mobileUnmutedIcon = document.getElementById(
    "mobile-sound-unmuted-icon",
  );
  const heroLeftText = document.getElementById("hero-left-text");
  const heroCenterSafety = document.getElementById("hero-center-safety");
  const wordKlik = document.getElementById("word-klik");
  const wordAlarm = document.getElementById("word-alarm");
  const wordSos = document.getElementById("word-sos");
  const heroAlarm = document.getElementById("hero-alarm");

  // Helper to show/hide animated words
  function setWordVisible(el: HTMLElement | null, visible: boolean) {
    if (!el) return;
    if (visible) {
      el.classList.remove("opacity-0", "translate-y-2");
      el.classList.add("opacity-100", "translate-y-0");
    } else {
      el.classList.remove("opacity-100", "translate-y-0");
      el.classList.add("opacity-0", "translate-y-2");
    }
  }

  // Reset all words and alarm effects immediately without animation delay (prevents flash on loop)
  function resetWordsImmediately() {
    [wordKlik, wordAlarm, wordSos].forEach((el) => {
      if (!el) return;
      el.classList.add("duration-0");
      el.classList.remove("opacity-100", "translate-y-0", "duration-500");
      el.classList.add("opacity-0", "translate-y-2");
      // Force reflow so zero-duration takes effect immediately
      void el.offsetHeight;
      el.classList.remove("duration-0");
      el.classList.add("duration-500");
    });

    if (heroAlarm) {
      heroAlarm.classList.remove(
        "alarm-pulse-fast",
        "drop-shadow-[0_0_15px_rgba(239,68,68,0.9)]",
      );
    }
  }

  // Dynamic video sequence:
  // 0.3s+: "Klik." se objeví
  // 1.1s+: "Alarm." se objeví se sirénou (pulzující červené slovo)
  // 2.0s+: "SOS zpráva." se objeví pod ním -> všechny 3 jsou vidět najednou
  // 4.0s+: celý blok hesel zmizí nahoru a uprostřed naskočí "Buď vždy v bezpečí."
  let lastTime = 0;

  if (videoEl && heroLeftText && heroCenterSafety) {
    videoEl.addEventListener("timeupdate", () => {
      const t = videoEl.currentTime;

      // Detekce zacyklení videa zpět na začátek (čas klesl)
      if (t < lastTime && t < 1.0) {
        resetWordsImmediately();
      }
      lastTime = t;

      // 1. Postupné objevování hesel
      setWordVisible(wordKlik, t >= 0.2);
      setWordVisible(wordAlarm, t >= 1.1);
      setWordVisible(wordSos, t >= 2.0);

      // Zvýraznění Alarm. při aktivaci (t >= 1.1s)
      if (t >= 1.1 && t < 4.0) {
        if (heroAlarm) {
          heroAlarm.classList.add(
            "alarm-pulse-fast",
            "drop-shadow-[0_0_15px_rgba(239,68,68,0.9)]",
          );
        }
      } else if (t < 1.1) {
        if (heroAlarm) {
          heroAlarm.classList.remove(
            "alarm-pulse-fast",
            "drop-shadow-[0_0_15px_rgba(239,68,68,0.9)]",
          );
        }
      }

      // 2. Přechod na "Buď vždy v bezpečí." od 4. sekundy
      if (t >= 4.0) {
        // Fade out levého bloku se 3 hesly
        heroLeftText.classList.remove("opacity-100", "translate-y-0");
        heroLeftText.classList.add(
          "opacity-0",
          "-translate-y-4",
          "pointer-events-none",
        );

        // Scale & fade in pro "Buď vždy v bezpečí."
        heroCenterSafety.classList.remove("opacity-0", "scale-95");
        heroCenterSafety.classList.add("opacity-100", "scale-100");
      } else {
        // Obnovení stavu rodičovských kontejnerů pro novou sekvenci
        heroLeftText.classList.remove(
          "opacity-0",
          "-translate-y-4",
          "pointer-events-none",
        );
        heroLeftText.classList.add("opacity-100", "translate-y-0");

        heroCenterSafety.classList.remove("opacity-100", "scale-100");
        heroCenterSafety.classList.add("opacity-0", "scale-95");
      }
    });

    // Pojistka pro seek / přetočení na začátek
    videoEl.addEventListener("seeked", () => {
      if (videoEl.currentTime < 0.3) {
        resetWordsImmediately();
      }
    });
  }

  // Update play/pause UI (icon and label)
  function updatePlayUI() {
    if (!videoEl) return;
    const isPaused = videoEl.paused;
    if (pauseIcon) pauseIcon.classList.toggle("hidden", isPaused);
    if (playIcon) playIcon.classList.toggle("hidden", !isPaused);
    if (playLabel) playLabel.textContent = isPaused ? "Spustit" : "Pozastavit";
  }

  // Ensure autoplay starts reliably across all browsers (Safari/Chrome/iOS)
  if (videoEl) {
    videoEl.muted = true;
    const playPromise = videoEl.play();
    if (playPromise !== undefined) {
      playPromise.catch(() => {
        // Autoplay policy prevented playback until user interaction
        const triggerPlay = () => {
          videoEl.play();
          window.removeEventListener("click", triggerPlay);
          window.removeEventListener("touchstart", triggerPlay);
          window.removeEventListener("scroll", triggerPlay);
        };
        window.addEventListener("click", triggerPlay, { once: true });
        window.addEventListener("touchstart", triggerPlay, { once: true });
        window.addEventListener("scroll", triggerPlay, { once: true });
      });
    }

    // Keep UI synchronized with video play/pause events
    videoEl.addEventListener("play", updatePlayUI);
    videoEl.addEventListener("pause", updatePlayUI);
    videoEl.addEventListener("volumechange", updateSoundUI);

    // Reliable mobile loop fallback (fixes iOS Safari freeze at video end)
    videoEl.addEventListener("ended", () => {
      resetWordsImmediately();
      videoEl.currentTime = 0;
      videoEl.play().catch(() => {});
    });

    // Mobile buffer stall recovery
    videoEl.addEventListener("waiting", () => {
      // If stalled while playing, attempt recovery
      if (!videoEl.paused) {
        videoEl.play().catch(() => {});
      }
    });
  }

  // Sound toggle logic
  function toggleAudio() {
    if (!videoEl) return;
    videoEl.muted = !videoEl.muted;
    updateSoundUI();
  }

  function updateSoundUI() {
    if (!videoEl) return;
    const isMuted = videoEl.muted;
    if (soundMutedIcon) soundMutedIcon.classList.toggle("hidden", !isMuted);
    if (soundUnmutedIcon) soundUnmutedIcon.classList.toggle("hidden", isMuted);
    if (mobileMutedIcon) mobileMutedIcon.classList.toggle("hidden", !isMuted);
    if (mobileUnmutedIcon)
      mobileUnmutedIcon.classList.toggle("hidden", isMuted);
    if (soundLabel) {
      soundLabel.textContent = isMuted ? "Zvuk vypnut" : "Zvuk zapnut";
    }
  }

  if (toggleSoundBtn) {
    toggleSoundBtn.addEventListener("click", toggleAudio);
  }

  if (mobileSoundBtn) {
    mobileSoundBtn.addEventListener("click", toggleAudio);
  }

  // Play/Pause toggle
  if (togglePlayBtn && videoEl) {
    togglePlayBtn.addEventListener("click", () => {
      if (videoEl.paused) {
        videoEl.play();
      } else {
        videoEl.pause();
      }
    });
  }

  // Initial UI sync
  updatePlayUI();
  updateSoundUI();

  // Interactive button test
  const demoBtn = document.getElementById("interactive-demo-btn");
  const alertBox = document.getElementById("demo-feedback-alert");

  if (demoBtn && alertBox) {
    demoBtn.addEventListener("click", () => {
      demoBtn.classList.add("opacity-50", "pointer-events-none");
      demoBtn.innerHTML = "<span>Odesílám signál...</span>";

      setTimeout(() => {
        alertBox.classList.remove("hidden");
        demoBtn.innerHTML = "<span>Vyzkoušeno ✓</span>";
        setTimeout(() => {
          demoBtn.classList.remove("opacity-50", "pointer-events-none");
          demoBtn.innerHTML =
            '<span class="w-2 h-2 rounded-full bg-zinc-950"></span><span>Kliknout znovu</span>';
        }, 3000);
      }, 700);
    });
  }
</script>

<style>
  @keyframes alarmPulseFast {
    0%,
    100% {
      opacity: 1;
      filter: drop-shadow(0 0 16px rgba(239, 68, 68, 0.95));
      transform: scale(1);
    }
    50% {
      opacity: 0.65;
      filter: drop-shadow(0 0 4px rgba(239, 68, 68, 0.4));
      transform: scale(1.02);
    }
  }

  :global(.alarm-pulse-fast) {
    animation: alarmPulseFast 0.65s cubic-bezier(0.4, 0, 0.6, 1) infinite !important;
  }
</style>
