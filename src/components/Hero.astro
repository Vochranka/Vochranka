---
// src/components/Hero.astro
import { ChevronDown } from "lucide-astro";
---

<section
  class="hero-section relative isolate w-full h-screen min-h-[600px] max-h-[1080px] overflow-hidden bg-[#cdd4cb] text-zinc-900"
  aria-label="Vochranka – tísňové tlačítko"
>

  <!-- Giant brand name at the bottom (watermark style) -->
  <div
    class="absolute bottom-0 left-0 w-full pointer-events-none select-none overflow-hidden leading-none"
    aria-hidden="true"
  >
    <span
      class="block text-center font-black uppercase tracking-tight text-zinc-900/10"
      style="font-size: clamp(8rem, 22vw, 22rem); font-family: system-ui, -apple-system, 'Helvetica Neue', sans-serif; line-height: 0.78; transform: translateY(18%);"
    >
      VOCHRANKA
    </span>
  </div>

  <!-- Product image – centered, large, on top of the brand name -->
  <div
    class="absolute inset-0 flex items-center justify-center pointer-events-none select-none"
    aria-hidden="true"
  >
    <img
      src="/button1.webp"
      alt="Vochranka tísňové tlačítko"
      class="w-[260px] h-[260px] sm:w-[340px] sm:h-[340px] md:w-[420px] md:h-[420px] lg:w-[500px] lg:h-[500px] xl:w-[560px] xl:h-[560px] object-contain drop-shadow-[0_40px_80px_rgba(0,0,0,0.18)]"
      loading="eager"
    />
  </div>

  <!-- Foreground content: text top-left -->
  <div class="relative z-10 h-full flex flex-col justify-between px-6 sm:px-10 lg:px-16 xl:px-20 pt-8 sm:pt-10 pb-6 sm:pb-8">

    <!-- Top left: headline + subline + benefits -->
    <div class="max-w-[380px] sm:max-w-[440px] lg:max-w-[500px]">
      <h1
        class="text-2xl sm:text-3xl md:text-4xl lg:text-[2.6rem] font-bold leading-tight text-zinc-900 mb-2 sm:mb-3"
        style="font-family: system-ui, -apple-system, 'Helvetica Neue', sans-serif;"
      >
        Bezpečnostní tlačítko<br />pro nouzové situace.
      </h1>
      <p class="text-sm sm:text-base text-zinc-600 font-normal mb-5 sm:mb-7 leading-relaxed">
        Dvakrát stiskněte – zazní siréna a blízcí dostanou SOS zprávu.
      </p>

      <!-- Benefits pills -->
      <div class="flex flex-col gap-2">
        <div class="inline-flex items-center gap-2 text-xs sm:text-sm font-medium text-zinc-700">
          <span class="w-1.5 h-1.5 rounded-full bg-zinc-800 shrink-0"></span>
          14 dní zdarma – zkušební doba bez závazků
        </div>
        <div class="inline-flex items-center gap-2 text-xs sm:text-sm font-medium text-zinc-700">
          <span class="w-1.5 h-1.5 rounded-full bg-zinc-800 shrink-0"></span>
          1. rok provozu zdarma
        </div>
      </div>
    </div>

    <!-- Bottom row: CTA left + scroll arrow right -->
    <div class="flex items-end justify-between w-full">
      <div class="flex flex-col sm:flex-row gap-2 sm:gap-3">
        <a
          href="#kontakt"
          class="inline-flex items-center justify-center px-6 sm:px-8 py-2.5 sm:py-3 rounded-full text-sm sm:text-base font-semibold text-white bg-zinc-900 hover:bg-zinc-700 active:scale-95 transition-all duration-200 shadow-[0_8px_24px_-4px_rgba(0,0,0,0.25)] hover:scale-[1.03] cursor-pointer"
        >
          Objednat tlačítko
        </a>
        <a
          href="#vyuziti"
          class="inline-flex items-center justify-center px-6 sm:px-8 py-2.5 sm:py-3 rounded-full text-sm sm:text-base font-semibold text-zinc-800 bg-white/50 hover:bg-white/80 backdrop-blur-sm border border-zinc-900/15 active:scale-95 transition-all duration-200 hover:scale-[1.03] cursor-pointer"
        >
          Jak to funguje
        </a>
      </div>

      <!-- Scroll down hint -->
      <a
        href="#vyuziti"
        class="flex items-center gap-1.5 text-xs text-zinc-500 hover:text-zinc-800 transition-colors duration-200 group mb-1"
        aria-label="Přejít dolů"
      >
        <ChevronDown class="w-4 h-4 animate-bounce" />
      </a>
    </div>
  </div>

</section>
