---
import { ArrowRight } from "lucide-astro";
import { SITE_CONFIG } from "@/data/siteConfig";

const places = SITE_CONFIG.heroPlaces;
---

<section class="relative w-full bg-[#2A211D] text-white pt-28 sm:pt-36 lg:pt-44 pb-20 sm:pb-28 px-6 sm:px-12 lg:px-20 overflow-hidden select-none">
  <div class="max-w-[1260px] mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-end">
      
      <!-- LEFT: Massive All-Caps Heading with rotating place -->
      <div class="lg:col-span-8 text-left">
        <h1 class="font-sans font-bold text-5xl sm:text-7xl md:text-8xl lg:text-[110px] xl:text-[128px] tracking-[-0.05em] text-white leading-[0.88] uppercase">
          <span class="block">OBTĚŽOVAL</span>
          <span class="block">VÁS NĚKDO</span>
          <span class="inline-block relative overflow-hidden align-bottom h-[1.05em] [perspective:800px]">
            <span
              id="hero-rotating-place"
              data-places={JSON.stringify(places)}
              class="inline-block whitespace-nowrap will-change-transform text-white"
            >
              {places[0]}
            </span>
          </span>
        </h1>
      </div>

      <!-- RIGHT: Paragraph & Buttons -->
      <div class="lg:col-span-4 flex flex-col items-start lg:items-end text-left lg:text-right">
        <p class="font-mono text-xs sm:text-[13px] text-white/90 leading-[1.5] max-w-[420px] mb-8 font-normal">
          Bezpečnostní systém. Jste sami ve svém salonu, kavárně či večerce a zákazník se začne chovat divně? Podržením tlačítka spustíte výstražnou sirénu a pošlete nouzovou SMS.
        </p>

        <div class="flex items-center gap-5 sm:gap-6">
          <a
            href="#vyuziti"
            class="font-mono text-[13px] text-white underline hover:text-white/80 transition-colors"
          >
            Jak to funguje
          </a>

          <a
            href="#cenik"
            class="inline-flex items-center justify-center px-6 py-2.5 rounded-full text-sm font-medium text-[#2B2523] bg-white hover:bg-white/90 active:scale-95 transition-all shadow-sm"
          >
            Chci bezpečí
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  let intervalId: ReturnType<typeof setInterval> | null = null;

  function initRotatingPlace() {
    const el = document.getElementById("hero-rotating-place");
    if (!el || !el.dataset.places) return;

    if (intervalId) {
      clearInterval(intervalId);
      intervalId = null;
    }

    const places: string[] = JSON.parse(el.dataset.places);
    let index = 0;
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const rotate = () => {
      index = (index + 1) % places.length;

      if (prefersReducedMotion) {
        el.textContent = places[index];
        return;
      }

      el.animate(
        [
          { transform: "translateY(0%) rotateX(0deg)", opacity: 1 },
          { transform: "translateY(-110%) rotateX(65deg)", opacity: 0 }
        ],
        { duration: 420, easing: "cubic-bezier(0.4, 0, 0.2, 1)", fill: "forwards" }
      ).onfinish = () => {
        el.textContent = places[index];

        el.animate(
          [
            { transform: "translateY(110%) rotateX(-65deg)", opacity: 0 },
            { transform: "translateY(0%) rotateX(0deg)", opacity: 1 }
          ],
          { duration: 480, easing: "cubic-bezier(0.34, 1.56, 0.64, 1)", fill: "forwards" }
        );
      };
    };

    intervalId = setInterval(rotate, 2800);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initRotatingPlace);
  } else {
    initRotatingPlace();
  }
  document.addEventListener("astro:page-load", initRotatingPlace);
</script>

