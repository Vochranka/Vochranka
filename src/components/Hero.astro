---
import {
  Play,
  Pause,
  Volume2,
  VolumeX,
  ShieldCheck,
  Bell,
  MessageSquare,
  Check,
  Sparkles,
} from "lucide-astro";
---

<section
  class="relative min-h-[85vh] lg:min-h-[92vh] flex items-center pt-12 pb-20 md:pt-16 md:pb-28 overflow-hidden text-white"
>
  <!-- Full-Bleed Background Video with Overlays -->
  <div
    class="absolute inset-0 w-full h-full -z-20 overflow-hidden bg-anthracite-950"
  >
    <video
      id="hero-bg-video"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      class="w-full h-full object-cover opacity-85 transition-opacity duration-700"
    >
      <source src="/vochranka-video.mp4" type="video/mp4" />
      Váš prohlížeč nepodporuje přehrávání videa.
    </video>

    <!-- Deep cinematic gradient overlay for readability & contrast -->
    <div
      class="absolute inset-0 bg-gradient-to-r from-anthracite-950/92 via-anthracite-950/78 to-anthracite-900/60 pointer-events-none"
    >
    </div>
    <div
      class="absolute inset-0 bg-gradient-to-t from-anthracite-950/90 via-transparent to-anthracite-950/40 pointer-events-none"
    >
    </div>
    <div
      class="absolute inset-0 bg-sage-950/20 mix-blend-color pointer-events-none"
    >
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 w-full relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      <!-- Left Column: Copy & CTAs -->
      <div class="lg:col-span-7 text-center lg:text-left">
        <!-- Target Badge -->
        <div
          class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-sage-900/85 border border-sage-500/40 text-sage-200 text-xs sm:text-sm font-semibold mb-6 shadow-soft-sm backdrop-blur-md"
        >
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"
          ></span>
          <span>Vyvinuto speciálně pro masérky a privátní salóny</span>
        </div>

        <!-- Main Heading -->
        <h1
          class="text-3xl sm:text-4xl md:text-5xl lg:text-[3.35rem] font-bold font-display text-white tracking-tight leading-[1.16] mb-6 drop-shadow-md"
        >
          Bezpečí a klid při práci o samotě. <br class="hidden sm:inline" />
          <span class="text-sage-300">Na jedno diskrétní kliknutí.</span>
        </h1>

        <!-- Subheading -->
        <p
          class="text-base sm:text-lg text-stone-200 leading-relaxed max-w-2xl mx-auto lg:mx-0 mb-8 font-normal drop-shadow"
        >
          Malé bezdrátové tlačítko pod lehátko nebo stůl. Pronikavá siréna k
          odstrašení na místě a tiché nouzové SMS rodině. Bez vrtání, kabelů a
          složité montáže.
        </p>

        <!-- CTA Action Buttons -->
        <div
          class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 mb-10"
        >
          <a
            href="#objednavka"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-2xl text-base font-semibold text-white bg-sage-600 hover:bg-sage-500 active:scale-[0.99] transition-all duration-200 shadow-glow-sage hover:shadow-soft-xl"
          >
            <span>Chci sadu do salónu</span>
            <span
              class="text-xs bg-sage-800/90 py-0.5 px-2 rounded-full font-medium text-sage-100"
              >2 990 Kč</span
            >
          </a>

          <button
            id="hero-unmute-btn"
            type="button"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-7 py-4 rounded-2xl text-base font-medium text-white bg-white/10 hover:bg-white/20 border border-white/20 active:scale-[0.99] backdrop-blur-md transition-all duration-200 group cursor-pointer shadow-soft-sm"
          >
            <div
              class="w-7 h-7 rounded-full bg-white/20 flex items-center justify-center text-white group-hover:bg-sage-500 transition-colors"
            >
              <Volume2 class="w-3.5 h-3.5" id="hero-sound-icon-btn" />
            </div>
            <span id="hero-sound-text-btn">Pustit zvuk videa</span>
          </button>
        </div>

        <!-- Trust Badges List -->
        <div
          class="pt-6 border-t border-white/15 grid grid-cols-3 gap-2 sm:gap-4 max-w-lg mx-auto lg:mx-0 text-left"
        >
          <div
            class="flex items-center gap-2 text-xs sm:text-sm text-stone-200 font-medium"
          >
            <Check class="w-4 h-4 text-emerald-400 shrink-0" />
            <span>Bez vrtání a kabelů</span>
          </div>
          <div
            class="flex items-center gap-2 text-xs sm:text-sm text-stone-200 font-medium"
          >
            <Check class="w-4 h-4 text-emerald-400 shrink-0" />
            <span>100% diskrétní balení</span>
          </div>
          <div
            class="flex items-center gap-2 text-xs sm:text-sm text-stone-200 font-medium"
          >
            <Check class="w-4 h-4 text-emerald-400 shrink-0" />
            <span>Záruka vrácení 14 dní</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Ambient Video Controls Bar in Bottom-Right Corner of Hero -->
<div
  class="absolute bottom-4 right-4 z-20 flex items-center gap-2 bg-black/60 backdrop-blur-md px-3 py-1.5 rounded-full border border-white/15 text-xs text-stone-300"
>
  <button
    id="video-toggle-play"
    type="button"
    class="hover:text-white transition-colors flex items-center gap-1 cursor-pointer focus:outline-none"
    title="Pozastavit / Spustit video"
    aria-label="Pozastavit nebo spustit video"
  >
    <Pause class="w-3.5 h-3.5" id="video-play-icon" />
    <span class="text-[11px]" id="video-play-label">Pozastavit</span>
  </button>
  <span class="text-stone-600">|</span>
  <button
    id="video-toggle-sound"
    type="button"
    class="hover:text-white transition-colors flex items-center gap-1 cursor-pointer focus:outline-none"
    title="Zapnout / Vypnout zvuk"
    aria-label="Zapnout nebo vypnout zvuk"
  >
    <VolumeX class="w-3.5 h-3.5" id="video-sound-icon" />
    <span class="text-[11px]" id="video-sound-label">Zvuk vypnut</span>
  </button>
</div>

<script>
  const videoEl = document.getElementById("hero-bg-video") as HTMLVideoElement;
  const togglePlayBtn = document.getElementById("video-toggle-play");
  const toggleSoundBtn = document.getElementById("video-toggle-sound");
  const heroUnmuteBtn = document.getElementById("hero-unmute-btn");
  const heroSoundTextBtn = document.getElementById("hero-sound-text-btn");
  const playLabel = document.getElementById("video-play-label");
  const soundLabel = document.getElementById("video-sound-label");

  // Sound toggle logic
  function toggleAudio() {
    if (!videoEl) return;
    videoEl.muted = !videoEl.muted;
    updateSoundUI();
  }

  function updateSoundUI() {
    if (!videoEl) return;
    const isMuted = videoEl.muted;
    if (soundLabel) {
      soundLabel.textContent = isMuted ? "Zvuk vypnut" : "Zvuk zapnut";
    }
    if (heroSoundTextBtn) {
      heroSoundTextBtn.textContent = isMuted
        ? "Pustit zvuk videa"
        : "Ztlumit video";
    }
  }

  if (toggleSoundBtn) {
    toggleSoundBtn.addEventListener("click", toggleAudio);
  }

  if (heroUnmuteBtn) {
    heroUnmuteBtn.addEventListener("click", toggleAudio);
  }

  // Play/Pause toggle
  if (togglePlayBtn && videoEl) {
    togglePlayBtn.addEventListener("click", () => {
      if (videoEl.paused) {
        videoEl.play();
        if (playLabel) playLabel.textContent = "Pozastavit";
      } else {
        videoEl.pause();
        if (playLabel) playLabel.textContent = "Spustit";
      }
    });
  }

  // Interactive button test
  const demoBtn = document.getElementById("interactive-demo-btn");
  const alertBox = document.getElementById("demo-feedback-alert");

  if (demoBtn && alertBox) {
    demoBtn.addEventListener("click", () => {
      demoBtn.classList.add("opacity-50", "pointer-events-none");
      demoBtn.innerHTML = "<span>Odesílám signál...</span>";

      setTimeout(() => {
        alertBox.classList.remove("hidden");
        demoBtn.innerHTML = "<span>Vyzkoušeno ✓</span>";
        setTimeout(() => {
          demoBtn.classList.remove("opacity-50", "pointer-events-none");
          demoBtn.innerHTML =
            '<span class="w-2 h-2 rounded-full bg-sage-600"></span><span>Kliknout znovu</span>';
        }, 3000);
      }, 700);
    });
  }
</script>
