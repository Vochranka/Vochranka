---
// src/components/Hero.astro
import { ChevronDown } from "lucide-astro";
---

<section
  class="relative isolate w-full h-screen min-h-[600px] max-h-[1080px] overflow-hidden text-zinc-900"
  style="background-color: #F9F8F6;"
  aria-label="Vochranka – tísňové tlačítko"
>
  <!-- Giant brand name at the bottom (watermark style) -->
  <div
    class="absolute bottom-0 left-0 w-full pointer-events-none select-none overflow-hidden leading-none"
    aria-hidden="true"
  >
    <span
      class="block text-center font-black uppercase tracking-tight text-zinc-900/[0.06]"
      style="font-size: clamp(8rem, 22vw, 22rem); line-height: 0.78; transform: translateY(18%);"
    >
      VOCHRANKA
    </span>
  </div>

  <!-- Product image – right side, large, with orange glow -->
  <div
    class="absolute top-1/2 -translate-y-1/2 right-[-8%] sm:right-[-5%] md:right-[-3%] lg:right-[-1%] pointer-events-none select-none z-[1] flex items-center justify-center"
    aria-hidden="true"
  >
    <!-- Orange glow -->
    <div
      class="absolute rounded-full"
      style="width: 110%; height: 110%; background: radial-gradient(circle, rgba(251,146,60,0.32) 0%, rgba(251,146,60,0.13) 42%, transparent 70%); filter: blur(14px);"
    ></div>
    <img
      src="/button1.webp"
      alt="Vochranka tísňové tlačítko"
      class="relative w-[320px] h-[320px] sm:w-[430px] sm:h-[430px] md:w-[540px] md:h-[540px] lg:w-[640px] lg:h-[640px] xl:w-[720px] xl:h-[720px] object-contain drop-shadow-[0_40px_80px_rgba(0,0,0,0.14)]"
      loading="eager"
    />
  </div>

  <!-- Foreground content: vertically centered on left -->
  <div class="relative z-10 h-full flex flex-col justify-center px-6 sm:px-10 lg:px-16 xl:px-20 pt-20 pb-16">
    <div class="max-w-[360px] sm:max-w-[420px] lg:max-w-[460px]">

      <!-- Headline -->
      <h1 class="text-3xl sm:text-4xl md:text-[2.8rem] lg:text-5xl font-bold leading-tight text-zinc-900 mb-3 sm:mb-4">
        Bezpečnostní tlačítko<br />pro nouzové situace.
      </h1>

      <!-- Subtext -->
      <p class="text-sm sm:text-base text-zinc-500 leading-relaxed mb-6 sm:mb-7">
        Dvakrát stiskněte – zazní siréna a&nbsp;blízcí dostanou SOS zprávu.
      </p>

      <!-- 14 dní bubble -->
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs sm:text-sm font-semibold text-zinc-800 border border-zinc-200 shadow-sm bg-white mb-7 sm:mb-9">
        <span class="w-2 h-2 rounded-full bg-emerald-500 shrink-0"></span>
        14 dní na zkoušku zdarma
      </div>

      <!-- CTA buttons -->
      <div class="flex flex-col sm:flex-row items-start gap-2.5 sm:gap-3">
        <a
          href="#kontakt"
          class="inline-flex items-center justify-center px-7 py-3 rounded-full text-sm sm:text-base font-semibold text-white bg-zinc-900 hover:bg-zinc-700 active:scale-95 transition-all duration-200 shadow-[0_8px_24px_-4px_rgba(0,0,0,0.22)] hover:scale-[1.03] cursor-pointer"
        >
          Objednat tlačítko
        </a>
        <a
          href="#vyuziti"
          class="inline-flex items-center justify-center px-7 py-3 rounded-full text-sm sm:text-base font-semibold text-zinc-700 bg-white border border-zinc-200 hover:bg-zinc-50 active:scale-95 transition-all duration-200 hover:scale-[1.03] cursor-pointer"
        >
          Jak to funguje
        </a>
      </div>

    </div>
  </div>

  <!-- Scroll arrow -->
  <div class="absolute bottom-5 left-1/2 -translate-x-1/2 z-20">
    <a
      href="#vyuziti"
      class="flex items-center justify-center text-zinc-400 hover:text-zinc-600 transition-colors duration-200"
      aria-label="Přejít dolů"
    >
      <ChevronDown class="w-5 h-5 animate-bounce" />
    </a>
  </div>
</section>
