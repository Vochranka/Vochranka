---
import { ArrowRight } from "lucide-astro";
import { SITE_CONFIG } from "@/data/siteConfig";

const places = SITE_CONFIG.heroPlaces;
---

<section class="relative w-full min-h-[85vh] sm:min-h-[92vh] flex flex-col justify-end overflow-hidden select-none bg-black text-white pb-14 sm:pb-20 pt-32 sm:pt-40">
  <!-- Hero Background Image (button-under-reception.jpg matching mock-up exactly) -->
  <div class="absolute inset-0 w-full h-full z-0 overflow-hidden">
    <img
      src="/button-under-reception.jpg"
      alt="Diskrétní tísňové tlačítko Vochránka pod stolem v ordinaci"
      class="w-full h-full object-cover object-top filter contrast-110 brightness-95"
      loading="eager"
      fetchpriority="high"
      width="1024"
      height="1024"
    />

    <!-- Dark gradient overlays for high-contrast white text -->
    <div class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/45 to-transparent pointer-events-none"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-black/80 via-transparent to-black/85 pointer-events-none"></div>
  </div>

  <!-- Hero Content Grid -->
  <div class="max-w-7xl mx-auto px-6 sm:px-10 lg:px-14 w-full relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-end">
      
      <!-- LEFT: Massive All-Caps Heading with rotating place -->
      <div class="lg:col-span-8 text-left">
        <h1 class="font-heading font-black text-4xl sm:text-6xl md:text-7xl lg:text-[5.5rem] tracking-tight text-white leading-[1.04] uppercase drop-shadow-md">
          <span class="block">OBTĚŽOVAL</span>
          <span class="block">VÁS NĚKDO</span>
          <span class="inline-block relative overflow-hidden align-bottom h-[1.15em] [perspective:800px]">
            <span
              id="hero-rotating-place"
              data-places={JSON.stringify(places)}
              class="inline-block whitespace-nowrap will-change-transform text-white"
            >
              {places[0]}
            </span>
          </span>
        </h1>
      </div>

      <!-- RIGHT: Paragraph & White Pill CTA -->
      <div class="lg:col-span-4 flex flex-col items-start lg:items-end text-left lg:text-right pb-2">
        <p class="text-xs sm:text-sm text-white/85 leading-relaxed max-w-xs mb-5 drop-shadow-sm font-normal">
          Diskrétní bezdrátové tísňové tlačítko pro masérky, kosmetičky a ordinace. Dvakrát stisknete – rozezní se siréna a blízcí dostanou nouzovou SMS do 2 vteřin.
        </p>

        <a
          href="#cenik"
          class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full text-xs sm:text-sm font-bold text-black bg-white hover:bg-white/90 active:scale-95 transition-all duration-200 shadow-md cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white"
        >
          <span>Objednat sadu</span>
          <ArrowRight class="w-3.5 h-3.5" />
        </a>
      </div>

    </div>
  </div>
</section>

<script>
  let intervalId: ReturnType<typeof setInterval> | null = null;

  function initRotatingPlace() {
    const el = document.getElementById("hero-rotating-place");
    if (!el || !el.dataset.places) return;

    if (intervalId) {
      clearInterval(intervalId);
      intervalId = null;
    }

    const places: string[] = JSON.parse(el.dataset.places);
    let index = 0;
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const rotate = () => {
      index = (index + 1) % places.length;

      if (prefersReducedMotion) {
        el.textContent = places[index];
        return;
      }

      el.animate(
        [
          { transform: "translateY(0%) rotateX(0deg)", opacity: 1 },
          { transform: "translateY(-110%) rotateX(65deg)", opacity: 0 }
        ],
        { duration: 420, easing: "cubic-bezier(0.4, 0, 0.2, 1)", fill: "forwards" }
      ).onfinish = () => {
        el.textContent = places[index];

        el.animate(
          [
            { transform: "translateY(110%) rotateX(-65deg)", opacity: 0 },
            { transform: "translateY(0%) rotateX(0deg)", opacity: 1 }
          ],
          { duration: 480, easing: "cubic-bezier(0.34, 1.56, 0.64, 1)", fill: "forwards" }
        );
      };
    };

    intervalId = setInterval(rotate, 2800);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initRotatingPlace);
  } else {
    initRotatingPlace();
  }
  document.addEventListener("astro:page-load", initRotatingPlace);
</script>

