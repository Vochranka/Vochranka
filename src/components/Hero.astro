---
import {
  Play,
  Pause,
  Volume2,
  VolumeX,
  ShieldCheck,
  Bell,
  MessageSquare,
  Check,
  Sparkles,
} from "lucide-astro";
---

<section
  class="relative w-full min-h-screen lg:h-screen flex flex-col justify-between pt-24 pb-6 md:pt-28 md:pb-8 overflow-hidden text-white"
>
  <!-- Full-Bleed Background Video with Overlays -->
  <div
    class="absolute inset-0 w-full h-full -z-20 overflow-hidden bg-anthracite-950"
  >
    <video
      id="hero-bg-video"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      class="w-full h-full object-cover opacity-90 transition-opacity duration-700"
    >
      <source src="/vochranka-video.mp4" type="video/mp4" />
      Váš prohlížeč nepodporuje přehrávání videa.
    </video>

    <!-- Deep cinematic gradient overlay for readability & contrast (fading to transparent on the right) -->
    <div
      class="absolute inset-0 bg-gradient-to-r from-anthracite-950/90 via-anthracite-950/50 to-transparent pointer-events-none"
    >
    </div>
    <div
      class="absolute inset-0 bg-gradient-to-t from-anthracite-950/80 via-transparent to-anthracite-950/25 pointer-events-none"
    >
    </div>
  </div>

  <!-- Left Content: Hesla pod sebou (posunutá více doleva) -->
  <div
    class="max-w-[1560px] mx-auto px-6 sm:px-10 lg:px-16 xl:px-20 w-full relative z-10 my-auto"
  >
    <div class="max-w-xl text-left">
      <!-- Main Heading (Hesla pod sebou) -->
      <h1
        class="text-4xl sm:text-5xl md:text-6xl lg:text-[4.5rem] font-extrabold font-display text-white tracking-tight leading-[1.08] drop-shadow-md"
      >
        <span class="block">Klik.</span>
        <span class="block text-red-300">Alarm.</span>
        <span class="block text-sage-300">SOS zpráva.</span>
      </h1>
    </div>
  </div>

  <!-- Bottom Centered Area: CTA Action Buttons + Scroll Down Indicator -->
  <div
    class="relative z-20 w-full px-4 flex flex-col items-center justify-center gap-4"
  >
    <!-- CTA Action Buttons -->
    <div
      class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 w-full sm:w-auto"
    >
      <a
        href="#objednavka"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-2xl text-base font-semibold text-white bg-sage-600 hover:bg-sage-500 active:scale-[0.99] transition-all duration-200 shadow-glow-sage hover:shadow-soft-xl hover:scale-105"
      >
        <span>Chci sadu do salónu</span>
        <span
          class="text-xs bg-sage-800/90 py-0.5 px-2 rounded-full font-medium text-sage-100"
          >2 990 Kč</span
        >
      </a>

      <button
        id="hero-unmute-btn"
        type="button"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-7 py-4 rounded-2xl text-base font-medium text-white bg-white/10 hover:bg-white/20 border border-white/20 active:scale-[0.99] backdrop-blur-md transition-all duration-200 group cursor-pointer shadow-soft-sm hover:scale-105"
      >
        <div
          class="w-7 h-7 rounded-full bg-white/20 flex items-center justify-center text-white group-hover:bg-sage-500 transition-colors"
        >
          <Volume2 class="w-3.5 h-3.5" id="hero-sound-icon-btn" />
        </div>
        <span id="hero-sound-text-btn">Pustit zvuk videa</span>
      </button>
    </div>

    <!-- Subtle scroll down mouse indicator on desktop -->
    <a
      href="#jak-to-funguje"
      class="hidden lg:flex flex-col items-center gap-1 text-stone-300 hover:text-white transition-all duration-300 hover:scale-105 group"
      aria-label="Přejít na další sekci"
    >
      <div
        class="w-5 h-7 rounded-full border-2 border-white/30 group-hover:border-sage-400 flex items-start justify-center p-1 transition-colors"
      >
        <span class="w-1 h-2 bg-sage-400 rounded-full animate-bounce"></span>
      </div>
    </a>
  </div>

  <!-- Ambient Video Controls Bar in Bottom-Right Corner of Hero -->
  <div
    class="absolute bottom-6 right-6 z-20 flex items-center gap-2 bg-black/60 backdrop-blur-md px-3.5 py-1.5 rounded-full border border-white/15 text-xs text-stone-300 shadow-soft-md"
  >
    <button
      id="video-toggle-play"
      type="button"
      class="hover:text-white transition-colors flex items-center gap-1 cursor-pointer focus:outline-none"
      title="Pozastavit / Spustit video"
      aria-label="Pozastavit nebo spustit video"
    >
      <Pause class="w-3.5 h-3.5" id="video-play-icon" />
      <span class="text-[11px]" id="video-play-label">Pozastavit</span>
    </button>
    <span class="text-stone-600">|</span>
    <button
      id="video-toggle-sound"
      type="button"
      class="hover:text-white transition-colors flex items-center gap-1 cursor-pointer focus:outline-none"
      title="Zapnout / Vypnout zvuk"
      aria-label="Zapnout nebo vypnout zvuk"
    >
      <VolumeX class="w-3.5 h-3.5" id="video-sound-icon" />
      <span class="text-[11px]" id="video-sound-label">Zvuk vypnut</span>
    </button>
  </div>
</section>

<script>
  const videoEl = document.getElementById("hero-bg-video") as HTMLVideoElement;
  const togglePlayBtn = document.getElementById("video-toggle-play");
  const toggleSoundBtn = document.getElementById("video-toggle-sound");
  const heroUnmuteBtn = document.getElementById("hero-unmute-btn");
  const heroSoundTextBtn = document.getElementById("hero-sound-text-btn");
  const playLabel = document.getElementById("video-play-label");
  const soundLabel = document.getElementById("video-sound-label");

  // Sound toggle logic
  function toggleAudio() {
    if (!videoEl) return;
    videoEl.muted = !videoEl.muted;
    updateSoundUI();
  }

  function updateSoundUI() {
    if (!videoEl) return;
    const isMuted = videoEl.muted;
    if (soundLabel) {
      soundLabel.textContent = isMuted ? "Zvuk vypnut" : "Zvuk zapnut";
    }
    if (heroSoundTextBtn) {
      heroSoundTextBtn.textContent = isMuted
        ? "Pustit zvuk videa"
        : "Ztlumit video";
    }
  }

  if (toggleSoundBtn) {
    toggleSoundBtn.addEventListener("click", toggleAudio);
  }

  if (heroUnmuteBtn) {
    heroUnmuteBtn.addEventListener("click", toggleAudio);
  }

  // Play/Pause toggle
  if (togglePlayBtn && videoEl) {
    togglePlayBtn.addEventListener("click", () => {
      if (videoEl.paused) {
        videoEl.play();
        if (playLabel) playLabel.textContent = "Pozastavit";
      } else {
        videoEl.pause();
        if (playLabel) playLabel.textContent = "Spustit";
      }
    });
  }

  // Interactive button test
  const demoBtn = document.getElementById("interactive-demo-btn");
  const alertBox = document.getElementById("demo-feedback-alert");

  if (demoBtn && alertBox) {
    demoBtn.addEventListener("click", () => {
      demoBtn.classList.add("opacity-50", "pointer-events-none");
      demoBtn.innerHTML = "<span>Odesílám signál...</span>";

      setTimeout(() => {
        alertBox.classList.remove("hidden");
        demoBtn.innerHTML = "<span>Vyzkoušeno ✓</span>";
        setTimeout(() => {
          demoBtn.classList.remove("opacity-50", "pointer-events-none");
          demoBtn.innerHTML =
            '<span class="w-2 h-2 rounded-full bg-sage-600"></span><span>Kliknout znovu</span>';
        }, 3000);
      }, 700);
    });
  }
</script>
