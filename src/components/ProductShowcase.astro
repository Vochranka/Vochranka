---
// src/components/ProductShowcase.astro
import { Magnet } from "lucide-astro";
---

<section
  id="vyuziti"
  class="bg-white min-h-screen flex flex-col justify-center py-20 md:py-28 px-6 sm:px-10 lg:px-16 xl:px-24 overflow-hidden relative"
>
  <div
    class="max-w-6xl lg:max-w-[max(64.5vw,56rem)] mx-auto w-full my-auto relative z-10"
  >
    <!-- Main 2-Column Grid: Left Copy & Right Interactive Button -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      <!-- LEFT COLUMN: Hardware & Ergonomie (7 cols) -->
      <div class="lg:col-span-7 text-left">
        <h2
          class="text-4xl md:text-[3.5rem] lg:text-[clamp(2.25rem,2.75vw,6rem)] font-bold tracking-tight text-zinc-950 leading-[1.12]"
        >
          Okamžitá pomoc<br />
          <span class="text-[#63625C]">na jedno stisknutí</span>
        </h2>

        <!-- Situace / Problém (Napětí) -->
        <p
          class="text-zinc-600 text-lg md:text-xl lg:text-[clamp(1rem,1.1vw,2.5rem)] mt-7 md:mt-9 max-w-xl lg:max-w-[max(34vw,28rem)] leading-relaxed"
        >
          Jste sami ve svém salonu, kavárně či večerce a zákazník se začne
          chovat divně? Podržením tlačítka spustíte výstražnou sirénu a pošlete
          nouzovou SMS.
        </p>

        <!-- Jak funguje v praxi: 2 přirozené akce -->
        <div
          class="dots-t mt-12 md:mt-16 pt-10 md:pt-12 grid grid-cols-1 sm:grid-cols-2 gap-8 max-w-xl lg:max-w-[max(37vw,32rem)]"
        >
          <div>
            <span
              class="text-2xl sm:text-3xl lg:text-[clamp(1.5rem,1.5vw,2.5rem)] font-extrabold text-[#c1471e] tracking-tight block"
            >
              2s
            </span>
            <h3
              class="text-base lg:text-[clamp(0.95rem,0.9vw,1.35rem)] font-bold text-zinc-950 mt-1"
            >
              Stisknutí
            </h3>
            <p
              class="text-xs sm:text-sm lg:text-[clamp(0.75rem,0.78vw,1.1rem)] text-zinc-600 mt-1.5 leading-relaxed"
            >
              Rozezní se hlasitá siréna a vašim blízkým se okamžitě odesílá
              nouzová SMS.
            </p>
          </div>

          <div>
            <span
              class="text-2xl sm:text-3xl lg:text-[clamp(1.5rem,1.5vw,2.5rem)] font-extrabold text-zinc-400 tracking-tight block"
            >
              2x
            </span>
            <h3
              class="text-base lg:text-[clamp(0.95rem,0.9vw,1.35rem)] font-bold text-zinc-950 mt-1"
            >
              Kliknutí
            </h3>
            <p
              class="text-xs sm:text-sm lg:text-[clamp(0.75rem,0.78vw,1.1rem)] text-zinc-600 mt-1.5 leading-relaxed"
            >
              Byl to omyl? Sirénu ztišíte pomocí tlačítka.
            </p>
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN: Frameless Interactive Button with Orange Glow (5 cols) -->
      <div
        class="lg:col-span-5 flex flex-col items-center justify-center relative"
      >
        <div
          class="w-full max-w-lg lg:max-w-[max(26vw,22rem)] relative flex flex-col items-center text-center"
        >
          <!-- Interactive Button Stage with Warm Orange Radiant Glow -->
          <div
            class="relative w-full h-80 sm:h-96 md:h-[420px] lg:h-[max(22vw,20rem)] flex items-center justify-center my-2 select-none"
          >
            <!-- Oranžové pozadí jako ozáření -->
            <div
              class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-80 h-80 sm:w-96 sm:h-96 md:w-[440px] md:h-[440px] rounded-full blur-3xl pointer-events-none opacity-85 bg-gradient-to-tr from-orange-500/35 via-amber-500/30 to-yellow-500/15"
            >
            </div>

            <!-- View 1: Button 1 (Přední strana) -->
            <img
              id="btn-view-1"
              src="/button1.png"
              alt="Tlačítko Vochranka - přední strana s logem"
              class="absolute inset-0 m-auto max-h-80 sm:max-h-96 md:max-h-[420px] lg:max-h-[max(20vw,18rem)] object-contain transition-all duration-500 ease-out drop-shadow-[0_20px_40px_rgba(0,0,0,0.14)] opacity-100 scale-100"
              loading="eager"
            />
          </div>

          <!-- 3 popisky dole -->
          <div
            class="grid grid-cols-3 w-full mt-10 sm:mt-14 md:mt-16 text-center"
          >
            <div class="px-1 sm:px-2.5">
              <span
                class="text-base sm:text-lg lg:text-[clamp(0.9rem,0.95vw,2rem)] font-bold text-zinc-950 block leading-tight tracking-tight whitespace-nowrap"
                >Kompaktní</span
              >
              <span
                class="text-xs sm:text-sm lg:text-[clamp(0.7rem,0.8vw,1.5rem)] text-zinc-500 font-medium block mt-1 whitespace-nowrap"
                >4,5 cm</span
              >
            </div>
            <div class="dots-x px-1 sm:px-2.5">
              <span
                class="text-base sm:text-lg lg:text-[clamp(0.9rem,0.95vw,2rem)] font-bold text-zinc-950 block leading-tight tracking-tight whitespace-nowrap"
                >Bezstarostné</span
              >
              <span
                class="text-xs sm:text-sm lg:text-[clamp(0.7rem,0.8vw,1.5rem)] text-zinc-500 font-medium block mt-1 whitespace-nowrap"
                >baterie až na 3 roky</span
              >
            </div>
            <div class="px-1 sm:px-2.5">
              <span
                class="text-base sm:text-lg lg:text-[clamp(0.9rem,0.95vw,2rem)] font-bold text-zinc-950 block leading-tight tracking-tight whitespace-nowrap"
                >Kamkoliv</span
              >
              <span
                class="text-xs sm:text-sm lg:text-[clamp(0.7rem,0.8vw,1.5rem)] text-zinc-500 font-medium block mt-1 whitespace-nowrap"
                >magnet i přilepení</span
              >
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Spodní rohová světle žlutá záře navazující do sekce Instalace -->
  <div
    class="absolute -bottom-20 -left-20 sm:-bottom-24 sm:-left-24 w-60 h-60 sm:w-72 sm:h-72 md:w-80 md:h-80 rounded-full bg-gradient-to-tr from-amber-400/25 via-yellow-300/15 to-transparent blur-[60px] sm:blur-[70px] md:blur-[80px] pointer-events-none"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute -bottom-20 -right-20 sm:-bottom-24 sm:-right-24 w-60 h-60 sm:w-72 sm:h-72 md:w-80 md:h-80 rounded-full bg-gradient-to-tl from-amber-400/25 via-yellow-300/15 to-transparent blur-[60px] sm:blur-[70px] md:blur-[80px] pointer-events-none"
    aria-hidden="true"
  >
  </div>
</section>

<style>
  /* Tečkované čáry z drobných kulatých teček (technický styl).
     Velikost tečky: poloměr 0.75px (~1.5px průměr). Rozestup: 8px. */
  section {
    --dot: #a1a1aa;
    --dots: radial-gradient(circle, var(--dot) 0.75px, transparent 1.1px);
  }

  /* horní čára */
  .dots-t {
    background-image: var(--dots);
    background-size: 8px 3px;
    background-repeat: repeat-x;
    background-position: top left;
  }

  /* svislé čáry vlevo a vpravo */
  .dots-x {
    background-image: var(--dots), var(--dots);
    background-size:
      3px 8px,
      3px 8px;
    background-repeat: repeat-y, repeat-y;
    background-position:
      left top,
      right top;
  }
</style>

<script>
  const toggleBtn1 = document.getElementById("toggle-btn-1");
  const toggleBtn2 = document.getElementById("toggle-btn-2");
  const img1 = document.getElementById("btn-view-1");
  const img2 = document.getElementById("btn-view-2");
  const caption1 = document.getElementById("view-caption-1");
  const caption2 = document.getElementById("view-caption-2");

  function setView(isFirst: boolean) {
    if (!toggleBtn1 || !toggleBtn2 || !img1 || !img2) return;

    if (isFirst) {
      // Show view 1: Přední strana
      img1.classList.remove("opacity-0", "scale-95", "pointer-events-none");
      img1.classList.add("opacity-100", "scale-100");

      img2.classList.remove("opacity-100", "scale-100");
      img2.classList.add("opacity-0", "scale-95", "pointer-events-none");

      if (caption1 && caption2) {
        caption1.classList.remove("hidden");
        caption2.classList.add("hidden");
      }

      toggleBtn1.setAttribute("aria-selected", "true");
      toggleBtn1.className =
        "px-4 py-2 rounded-full text-xs font-bold bg-white text-zinc-950 shadow-sm transition-all duration-200 cursor-pointer";

      toggleBtn2.setAttribute("aria-selected", "false");
      toggleBtn2.className =
        "px-4 py-2 rounded-full text-xs font-medium text-zinc-600 hover:text-zinc-950 transition-all duration-200 cursor-pointer";
    } else {
      // Show view 2: Magnetický profil
      img1.classList.remove("opacity-100", "scale-100");
      img1.classList.add("opacity-0", "scale-95", "pointer-events-none");

      img2.classList.remove("opacity-0", "scale-95", "pointer-events-none");
      img2.classList.add("opacity-100", "scale-100");

      if (caption1 && caption2) {
        caption1.classList.add("hidden");
        caption2.classList.remove("hidden");
      }

      toggleBtn1.setAttribute("aria-selected", "false");
      toggleBtn1.className =
        "px-4 py-2 rounded-full text-xs font-medium text-zinc-600 hover:text-zinc-950 transition-all duration-200 cursor-pointer";

      toggleBtn2.setAttribute("aria-selected", "true");
      toggleBtn2.className =
        "px-4 py-2 rounded-full text-xs font-bold bg-white text-zinc-950 shadow-sm transition-all duration-200 cursor-pointer";
    }
  }

  toggleBtn1?.addEventListener("click", () => setView(true));
  toggleBtn2?.addEventListener("click", () => setView(false));
</script>
