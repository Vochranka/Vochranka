---
// src/components/ProductShowcase.astro
import { Magnet } from "lucide-astro";
---

<section
  id="vyuziti"
  class="dots-b bg-white min-h-screen flex flex-col justify-center py-16 md:py-24 px-6 sm:px-10 lg:px-16 xl:px-24 overflow-hidden relative"
>
  <div class="max-w-5xl mx-auto w-full my-auto">
    <!-- Main 2-Column Grid: Left Copy & Right Interactive Button -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-15 items-center">
      <!-- LEFT COLUMN: Hardware & Ergonomie (7 cols) -->
      <div class="lg:col-span-7 text-left">
        <span
          class="text-xs font-mono tracking-[0.2em] text-zinc-400 uppercase font-medium block mb-3"
        >
          K čemu slouží
        </span>
        <h2
          class="text-3xl md:text-5xl font-bold tracking-tight text-zinc-950 leading-[1.15]"
        >
          Okamžitá pomoc<br />
          <span class="text-zinc-600">Na dva kliky</span>
        </h2>

        <!-- Situace / Problém (Napětí) -->
        <p
          class="text-zinc-600 text-base md:text-lg mt-7 md:mt-9 max-w-xl leading-relaxed"
        >
          Jste sami ve svém salonu, kavárně či večerce a zákazník se začne
          chovat divně? Stisknutím tlačítka spustíte výstražnou sirénu a pošlete
          nouzovou SMS.
        </p>

        <!-- Minimalistický slogan bez rámečků a boxů -->
        <p
          class="text-xl md:text-2xl font-bold tracking-tight text-zinc-950 mt-6"
        >
          VOCHRANKA. <span class="text-zinc-400 font-normal"
            >Stále v bezpečí</span
          >
        </p>

        <!-- Jak funguje v praxi: 2 přirozené akce -->
        <div
          class="dots-t mt-16 md:mt-24 pt-10 md:pt-12 grid grid-cols-1 sm:grid-cols-2 gap-8 max-w-xl"
        >
          <div>
            <span
              class="text-2xl sm:text-3xl font-extrabold text-red-500 tracking-tight block"
            >
              2x
            </span>
            <h3 class="text-base font-bold text-zinc-950 mt-1">Kliknutí</h3>
            <p class="text-sm text-zinc-600 mt-1 leading-relaxed">
              Rozezní se hlasitá siréna a vašim blízkým se okamžitě odesílá
              nouzová SMS.
            </p>
          </div>

          <div>
            <span
              class="text-2xl sm:text-3xl font-extrabold text-zinc-400 tracking-tight block"
            >
              3s
            </span>
            <h3 class="text-base font-bold text-zinc-950 mt-1">Podržení</h3>
            <p class="text-sm text-zinc-600 mt-1 leading-relaxed">
              Byl to omyl? Sirénu ztišíte pomocí tlačítka.
            </p>
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN: Frameless Interactive Button with Orange Glow (5 cols) -->
      <div
        class="lg:col-span-5 flex flex-col items-center justify-center relative"
      >
        <div
          class="w-full max-w-md sm:max-w-lg lg:max-w-[480px] relative flex flex-col items-center text-center"
        >
          <!-- Pill Toggle Switch NAHOŘE (Tlačítko / Magnetický profil) 
          <div
            class="bg-zinc-100 rounded-full p-1 inline-flex items-center gap-1 mb-4 shadow-sm"
            role="tablist"
            aria-label="Přepínač pohledu na tísňové tlačítko"
          >
            <button
              type="button"
              id="toggle-btn-1"
              role="tab"
              aria-selected="true"
              class="px-4 py-2 rounded-full text-xs font-bold bg-white text-zinc-950 shadow-sm transition-all duration-200 cursor-pointer"
            >
              Tlačítko
            </button>

            
            <button
              type="button"
              id="toggle-btn-2"
              role="tab"
              aria-selected="false"
              class="px-4 py-2 rounded-full text-xs font-medium text-zinc-600 hover:text-zinc-950 transition-all duration-200 cursor-pointer"
            >
              Magnetický profil
            </button>
          </div>
          -->

          <!-- Interactive Button Stage with Warm Orange Radiant Glow (Oranžové ozáření bez boxu) -->
          <div
            class="relative w-full h-64 sm:h-72 md:h-80 flex items-center justify-center my-2 select-none"
          >
            <!-- Oranžové pozadí jako ozáření -->
            <div
              class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-64 h-64 sm:w-80 sm:h-80 rounded-full blur-3xl pointer-events-none opacity-85 bg-gradient-to-tr from-orange-500/35 via-amber-500/30 to-yellow-500/15"
            >
            </div>

            <!-- View 1: Button 1 (Přední strana) -->
            <img
              id="btn-view-1"
              src="/button1.png"
              alt="Tlačítko Vochranka - přední strana s logem"
              class="absolute inset-0 m-auto max-h-64 sm:max-h-72 md:max-h-80 object-contain transition-all duration-500 ease-out drop-shadow-[0_20px_40px_rgba(0,0,0,0.14)] opacity-100 scale-100"
              loading="eager"
            />

            <!-- View 2: Button 2 (Magnetický profil) 
            <img
              id="btn-view-2"
              src="/button2.png"
              alt="Tlačítko Vochranka - magnetický profil"
              class="absolute inset-0 m-auto max-h-64 sm:max-h-72 md:max-h-80 object-contain transition-all duration-500 ease-out drop-shadow-[0_20px_40px_rgba(0,0,0,0.14)] opacity-0 scale-95 pointer-events-none"
              loading="eager"
            />
            -->
          </div>

          <!-- Dynamic Caption below Switcher (vždy na 1 řádce) 
          <div
            class="mt-3 min-h-[24px] flex items-center justify-center w-full px-2"
          >
            <p
              id="view-caption-1"
              class="text-xs sm:text-sm text-zinc-500 whitespace-nowrap transition-opacity duration-300"
            >
              Přední strana
            </p>
            <p
              id="view-caption-2"
              class="text-xs sm:text-sm text-zinc-500 whitespace-nowrap hidden transition-opacity duration-300"
            >
              Zadní profil na přilepení
            </p>
          </div>
          -->

          <!-- 3 popisky dole: větší text, vždy na jedné řádce bez zalamování -->
          <div
            class="grid grid-cols-3 w-full mt-10 sm:mt-14 md:mt-16 text-center"
          >
            <div class="px-1 sm:px-2.5">
              <span
                class="text-sm sm:text-base font-bold text-zinc-950 block leading-tight tracking-tight whitespace-nowrap"
                >Kompaktní</span
              >
              <span
                class="text-[11px] sm:text-xs text-zinc-500 font-medium block mt-1 whitespace-nowrap"
                >4,5 cm</span
              >
            </div>
            <div class="dots-x px-1 sm:px-2.5">
              <span
                class="text-sm sm:text-base font-bold text-zinc-950 block leading-tight tracking-tight whitespace-nowrap"
                >Bezstarostné</span
              >
              <span
                class="text-[11px] sm:text-xs text-zinc-500 font-medium block mt-1 whitespace-nowrap"
                >až 3 roky</span
              >
            </div>
            <div class="px-1 sm:px-2.5">
              <span
                class="text-sm sm:text-base font-bold text-zinc-950 block leading-tight tracking-tight whitespace-nowrap"
                >Kamkoliv</span
              >
              <span
                class="text-[11px] sm:text-xs text-zinc-500 font-medium block mt-1 whitespace-nowrap"
                >magnet i přilepení</span
              >
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Tečkované čáry z kulatých teček (místo border-dotted).
     Velikost tečky: poloměr 1.75px. Rozestup: 16px.
     Chcete větší/menší? Změňte 1.75px / 2.25px a 16px. Barvu měňte v --dot. */
  section {
    --dot: #a1a1aa;
    --dots: radial-gradient(circle, var(--dot) 1.75px, transparent 2.25px);
  }

  /* horní čára */
  .dots-t {
    background-image: var(--dots);
    background-size: 16px 6px;
    background-repeat: repeat-x;
    background-position: top left;
  }

  /* dolní čára (spodek sekce) */
  .dots-b {
    background-image: var(--dots);
    background-size: 16px 6px;
    background-repeat: repeat-x;
    background-position: bottom left;
  }

  /* svislé čáry vlevo a vpravo */
  .dots-x {
    background-image: var(--dots), var(--dots);
    background-size:
      6px 16px,
      6px 16px;
    background-repeat: repeat-y, repeat-y;
    background-position:
      left top,
      right top;
  }
</style>

<script>
  const toggleBtn1 = document.getElementById("toggle-btn-1");
  const toggleBtn2 = document.getElementById("toggle-btn-2");
  const img1 = document.getElementById("btn-view-1");
  const img2 = document.getElementById("btn-view-2");
  const caption1 = document.getElementById("view-caption-1");
  const caption2 = document.getElementById("view-caption-2");

  function setView(isFirst: boolean) {
    if (!toggleBtn1 || !toggleBtn2 || !img1 || !img2) return;

    if (isFirst) {
      // Show view 1: Přední strana
      img1.classList.remove("opacity-0", "scale-95", "pointer-events-none");
      img1.classList.add("opacity-100", "scale-100");

      img2.classList.remove("opacity-100", "scale-100");
      img2.classList.add("opacity-0", "scale-95", "pointer-events-none");

      if (caption1 && caption2) {
        caption1.classList.remove("hidden");
        caption2.classList.add("hidden");
      }

      toggleBtn1.setAttribute("aria-selected", "true");
      toggleBtn1.className =
        "px-4 py-2 rounded-full text-xs font-bold bg-white text-zinc-950 shadow-sm transition-all duration-200 cursor-pointer";

      toggleBtn2.setAttribute("aria-selected", "false");
      toggleBtn2.className =
        "px-4 py-2 rounded-full text-xs font-medium text-zinc-600 hover:text-zinc-950 transition-all duration-200 cursor-pointer";
    } else {
      // Show view 2: Magnetický profil
      img1.classList.remove("opacity-100", "scale-100");
      img1.classList.add("opacity-0", "scale-95", "pointer-events-none");

      img2.classList.remove("opacity-0", "scale-95", "pointer-events-none");
      img2.classList.add("opacity-100", "scale-100");

      if (caption1 && caption2) {
        caption1.classList.add("hidden");
        caption2.classList.remove("hidden");
      }

      toggleBtn1.setAttribute("aria-selected", "false");
      toggleBtn1.className =
        "px-4 py-2 rounded-full text-xs font-medium text-zinc-600 hover:text-zinc-950 transition-all duration-200 cursor-pointer";

      toggleBtn2.setAttribute("aria-selected", "true");
      toggleBtn2.className =
        "px-4 py-2 rounded-full text-xs font-bold bg-white text-zinc-950 shadow-sm transition-all duration-200 cursor-pointer";
    }
  }

  toggleBtn1?.addEventListener("click", () => setView(true));
  toggleBtn2?.addEventListener("click", () => setView(false));
</script>
