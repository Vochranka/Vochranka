---
// src/components/ProductShowcase.astro
import {
  Volume2,
  Smartphone,
  ArrowRight,
} from "lucide-astro";
---

<section
  id="vyuziti"
  class="bg-white py-24 md:py-32 px-4 sm:px-6 lg:px-8 border-b border-zinc-200/80 overflow-hidden relative"
>
  <div class="max-w-6xl mx-auto">
    
    <!-- 2-Column Editorial Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- LEFT: Honest, grounded storytelling (7 cols) -->
      <div class="lg:col-span-7 space-y-8 text-left">
        
        <div class="space-y-4">
          <p class="text-xs font-mono uppercase tracking-widest text-zinc-400">
            K čemu Vochranka slouží
          </p>
          <h2
            class="text-3xl sm:text-4xl md:text-[2.75rem] font-bold font-display text-zinc-950 tracking-tight leading-[1.12]"
          >
            Za vámi se zavřou dveře. <br />
            <span class="text-zinc-400 font-normal">A na salónu jste úplně sama.</span>
          </h2>
          <p class="text-base sm:text-lg text-zinc-600 leading-relaxed pt-1">
            Přijde nový klient, který začne překračovat hranice. Telefon leží na poličce nebo v kabelce. Nemáte šanci ho vytáhnout, odemknout a někou volat.
          </p>
          <p class="text-base text-zinc-600 leading-relaxed">
            Vochranka je malé tlačítko schované na dosah prstů. Stačí po paměti dvakrát kliknout:
          </p>
        </div>

        <!-- 2 Authentic Actions (No buzzwords, just what happens) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
          
          <div class="p-5 rounded-2xl bg-zinc-50 border border-zinc-200/70">
            <div class="text-zinc-950 font-bold text-base mb-1.5 flex items-center gap-2">
              <Volume2 class="w-4 h-4 text-zinc-950 shrink-0" />
              <span>110 dB siréna na místě</span>
            </div>
            <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed">
              Zásuvková siréna začne okamžitě houkat. Pro agresora je to šok a jasný signál, že o něm ví celá budova.
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-zinc-50 border border-zinc-200/70">
            <div class="text-zinc-950 font-bold text-base mb-1.5 flex items-center gap-2">
              <Smartphone class="w-4 h-4 text-zinc-950 shrink-0" />
              <span>Tichá SMS rodině s adresou</span>
            </div>
            <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed">
              Do 2 vteřin odejde zpráva na až 3 kontakty (partner, rodina, kolegyně) s přesnou adresou vašeho salónu.
            </p>
          </div>

        </div>

        <!-- Real situations where it protects -->
        <div class="pt-2">
          <p class="text-xs font-mono uppercase tracking-wider text-zinc-400 mb-3">
            Kde všude pomáhá:
          </p>
          <div class="flex flex-wrap gap-2 text-xs text-zinc-700">
            <span class="px-3 py-1.5 rounded-lg bg-zinc-100 border border-zinc-200/70 font-medium">
              Masérská lehátka
            </span>
            <span class="px-3 py-1.5 rounded-lg bg-zinc-100 border border-zinc-200/70 font-medium">
              Kosmetická & lash studia
            </span>
            <span class="px-3 py-1.5 rounded-lg bg-zinc-100 border border-zinc-200/70 font-medium">
              Manikúra & nehtový design
            </span>
            <span class="px-3 py-1.5 rounded-lg bg-zinc-100 border border-zinc-200/70 font-medium">
              Fyzioterapie & sólo praxe
            </span>
          </div>
        </div>

        <!-- Gestures -->
        <div class="pt-4 border-t border-zinc-100 flex flex-wrap items-center gap-6 text-xs text-zinc-500">
          <div>
            <strong class="font-mono text-zinc-900 bg-zinc-100 px-2 py-0.5 rounded border border-zinc-200 mr-1.5">2× klik</strong>
            Spustí sirénu & odešle SMS
          </div>
          <div>
            <strong class="font-mono text-zinc-900 bg-zinc-100 px-2 py-0.5 rounded border border-zinc-200 mr-1.5">3 sekundy</strong>
            Umlčí sirénu po zkoušce
          </div>
        </div>

      </div>

      <!-- RIGHT: Tactile Button Stage (5 cols) -->
      <div class="lg:col-span-5 flex flex-col items-center">
        
        <div
          class="w-full max-w-sm rounded-3xl p-6 sm:p-8 bg-gradient-to-b from-zinc-50 to-zinc-100/50 border border-zinc-200 shadow-sm relative flex flex-col items-center text-center"
        >
          <!-- Minimalist Toggle Switch -->
          <div
            class="bg-zinc-200/60 p-1 rounded-full inline-flex items-center gap-1 mb-6 border border-zinc-300/50"
            role="tablist"
          >
            <button
              type="button"
              id="toggle-btn-1"
              role="tab"
              aria-selected="true"
              class="px-4 py-1.5 rounded-full text-xs font-semibold bg-white text-zinc-950 shadow-xs transition-all cursor-pointer"
            >
              Přední strana
            </button>
            <button
              type="button"
              id="toggle-btn-2"
              role="tab"
              aria-selected="false"
              class="px-4 py-1.5 rounded-full text-xs font-medium text-zinc-500 hover:text-zinc-950 transition-all cursor-pointer"
            >
              Magnetický profil
            </button>
          </div>

          <!-- Product Image Viewport -->
          <div
            class="relative w-full h-60 sm:h-64 flex items-center justify-center my-1"
          >
            <img
              id="btn-view-1"
              src="/button1.png"
              alt="Tlačítko Vochranka zepředu"
              class="absolute inset-0 m-auto max-h-56 sm:max-h-64 object-contain transition-all duration-300 ease-out drop-shadow-[0_12px_24px_rgba(0,0,0,0.08)] opacity-100 scale-100"
              loading="eager"
            />

            <img
              id="btn-view-2"
              src="/button2.png"
              alt="Tlačítko Vochranka magnetická zadní strana"
              class="absolute inset-0 m-auto max-h-56 sm:max-h-64 object-contain transition-all duration-300 ease-out drop-shadow-[0_12px_24px_rgba(0,0,0,0.08)] opacity-0 scale-95 pointer-events-none"
              loading="eager"
            />
          </div>

          <!-- Specs row -->
          <div class="grid grid-cols-3 gap-2 w-full pt-6 mt-4 border-t border-zinc-200/80 text-center">
            <div>
              <span class="text-sm font-bold text-zinc-950 block">45 mm</span>
              <span class="text-[10px] text-zinc-400 block mt-0.5">Do dlaně</span>
            </div>
            <div>
              <span class="text-sm font-bold text-zinc-950 block">5 let</span>
              <span class="text-[10px] text-zinc-400 block mt-0.5">Bez nabíjení</span>
            </div>
            <div>
              <span class="text-sm font-bold text-zinc-950 block">Magnet & 3M</span>
              <span class="text-[10px] text-zinc-400 block mt-0.5">Bez vrtání</span>
            </div>
          </div>
        </div>

        <a
          href="#instalace"
          class="inline-flex items-center gap-1.5 text-xs font-semibold text-zinc-600 hover:text-zinc-950 transition-colors mt-4"
        >
          <span>Kam všude se dá tlačítko dát</span>
          <ArrowRight class="w-3.5 h-3.5" />
        </a>

      </div>

    </div>

  </div>
</section>

<script>
  const toggleBtn1 = document.getElementById("toggle-btn-1");
  const toggleBtn2 = document.getElementById("toggle-btn-2");
  const img1 = document.getElementById("btn-view-1");
  const img2 = document.getElementById("btn-view-2");

  function setView(isFirst: boolean) {
    if (!toggleBtn1 || !toggleBtn2 || !img1 || !img2) return;

    if (isFirst) {
      img1.classList.remove("opacity-0", "scale-95", "pointer-events-none");
      img1.classList.add("opacity-100", "scale-100");

      img2.classList.remove("opacity-100", "scale-100");
      img2.classList.add("opacity-0", "scale-95", "pointer-events-none");

      toggleBtn1.setAttribute("aria-selected", "true");
      toggleBtn1.className =
        "px-4 py-1.5 rounded-full text-xs font-semibold bg-white text-zinc-950 shadow-xs transition-all cursor-pointer";

      toggleBtn2.setAttribute("aria-selected", "false");
      toggleBtn2.className =
        "px-4 py-1.5 rounded-full text-xs font-medium text-zinc-500 hover:text-zinc-950 transition-all cursor-pointer";
    } else {
      img1.classList.remove("opacity-100", "scale-100");
      img1.classList.add("opacity-0", "scale-95", "pointer-events-none");

      img2.classList.remove("opacity-0", "scale-95", "pointer-events-none");
      img2.classList.add("opacity-100", "scale-100");

      toggleBtn1.setAttribute("aria-selected", "false");
      toggleBtn1.className =
        "px-4 py-1.5 rounded-full text-xs font-medium text-zinc-500 hover:text-zinc-950 transition-all cursor-pointer";

      toggleBtn2.setAttribute("aria-selected", "true");
      toggleBtn2.className =
        "px-4 py-1.5 rounded-full text-xs font-semibold bg-white text-zinc-950 shadow-xs transition-all cursor-pointer";
    }
  }

  toggleBtn1?.addEventListener("click", () => setView(true));
  toggleBtn2?.addEventListener("click", () => setView(false));
</script>
