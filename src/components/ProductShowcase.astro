---
// src/components/ProductShowcase.astro
import { Magnet } from "lucide-astro";
---

<section
  id="vyuziti"
  class="bg-cream-100 min-h-screen flex flex-col justify-center py-20 md:py-28 px-6 sm:px-10 lg:px-16 xl:px-24 overflow-hidden relative"
  aria-labelledby="showcase-heading"
>
  <div
    class="max-w-7xl lg:max-w-[max(72vw,64rem)] mx-auto w-full my-auto relative z-10"
  >
    <!-- Main 2-Column Grid -->
    <div
      class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center lg:items-stretch"
    >
      <!-- LEFT COLUMN: Hardware & Ergonomie (posunuté více doleva) -->
      <div class="lg:col-span-6 flex flex-col justify-between lg:-ml-2 xl:-ml-6">
        <div class="text-left">
          <h2
            id="showcase-heading"
            class="text-3xl md:text-5xl font-bold tracking-tight text-zinc-950 leading-[1.15]"
          >
            Okamžitá pomoc<br />
            <span class="text-[#63625C]">na jedno stisknutí</span>
          </h2>

          <!-- Situace / Problém (Napětí) -->
          <p
            class="text-zinc-600 text-lg md:text-xl lg:text-[clamp(1rem,1.1vw,2.5rem)] mt-8 md:mt-10 max-w-xl leading-relaxed [&>strong]:text-zinc-950 [&>strong]:font-bold"
          >
            Jste sami ve svém salonu, kavárně či večerce a zákazník se začne
            chovat divně? Podržením tlačítka spustíte <strong
              >výstražnou sirénu</strong
            > a pošlete
            <strong>nouzovou SMS.</strong>
          </p>
        </div>

        <!-- SPODNÍ ČÁST VLEVO: 2s a 2x -->
        <div
          class="mt-10 lg:mt-auto pt-8 grid grid-cols-1 sm:grid-cols-2 gap-8 max-w-xl items-start"
        >
          <div>
            <span
              class="text-2xl sm:text-3xl font-extrabold text-[#c1471e] tracking-tight block leading-none"
            >
              2s
            </span>
            <h3 class="text-base font-bold text-zinc-950 mt-2">Podržíte</h3>
            <p class="text-sm text-zinc-600 mt-1 leading-relaxed">
              Rozezní se hlasitá siréna a okamžitě se odesílají nouzové SMS
              zprávy.
            </p>
          </div>

          <div>
            <span
              class="text-2xl sm:text-3xl font-extrabold text-zinc-400 tracking-tight block leading-none"
            >
              2x
            </span>
            <h3 class="text-base font-bold text-zinc-950 mt-2">Kliknete</h3>
            <p class="text-sm text-zinc-600 mt-1 leading-relaxed">
              Nebezpečí pominulo nebo to byl omyl? Sirénu ztišíte opět pomocí
              tlačítka.
            </p>
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN: Větší video & 3 popisky (6 cols) -->
      <div
        class="lg:col-span-6 flex flex-col justify-between items-center relative"
      >
        <div
          class="w-full max-w-xl lg:max-w-none relative flex flex-col items-center mt-4 lg:mt-0"
        >
          <!-- Video Container with Warm Ambient Glow - větší rozměr -->
          <div class="relative w-full rounded-2xl sm:rounded-3xl overflow-hidden shadow-2xl border border-zinc-200/80 bg-black group select-none">
            <!-- Oranžová ambientní záře na pozadí videa -->
            <div
              class="absolute -inset-4 rounded-3xl blur-2xl pointer-events-none opacity-40 bg-gradient-to-tr from-orange-500/35 via-amber-500/25 to-yellow-500/15 z-0"
            >
            </div>

            <div class="relative z-10 w-full aspect-video overflow-hidden bg-black flex items-center justify-center">
              <video
                id="showcase-video"
                autoplay
                muted
                loop
                playsinline
                webkit-playsinline
                controls
                preload="metadata"
                class="w-full h-full object-cover"
              >
                <source src="/vochranka-video-optimized.mp4" type="video/mp4" />
                Váš prohlížeč nepodporuje přehrávání videa.
              </video>
            </div>
          </div>
        </div>

        <!-- SPODNÍ ČÁST VPRAVO: 3 popisky pod videem -->
        <div
          class="mt-8 lg:mt-auto pt-8 grid grid-cols-3 w-full max-w-full text-center items-start"
        >
          <div class="px-2 sm:px-4">
            <span
              class="text-sm sm:text-base font-bold text-zinc-950 block leading-tight tracking-tight"
              >Kompaktní</span
            >
            <span class="text-xs text-zinc-500 font-medium block mt-2"
              >4,5 cm malé</span
            >
          </div>
          <div class="dots-x px-2 sm:px-4">
            <span
              class="text-sm sm:text-base font-bold text-zinc-950 block leading-tight tracking-tight"
              >Bezstarostné</span
            >
            <span class="text-xs text-zinc-500 font-medium block mt-2"
              >až 3 roky bez nabíjení</span
            >
          </div>
          <div class="px-2 sm:px-4">
            <span
              class="text-sm sm:text-base font-bold text-zinc-950 block leading-tight tracking-tight"
              >Kamkoliv</span
            >
            <span class="text-xs text-zinc-500 font-medium block mt-2"
              >Pod stůl i do kapsy</span
            >
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Spodní rohová světle žlutá záře navazující do sekce Instalace -->
  <div
    class="absolute -bottom-20 -left-20 sm:-bottom-24 sm:-left-24 w-60 h-60 sm:w-72 sm:h-72 md:w-80 md:h-80 rounded-full bg-gradient-to-tr from-amber-400/25 via-yellow-300/15 to-transparent blur-[60px] sm:blur-[70px] md:blur-[80px] pointer-events-none"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute -bottom-20 -right-20 sm:-bottom-24 sm:-right-24 w-60 h-60 sm:w-72 sm:h-72 md:w-80 md:h-80 rounded-full bg-gradient-to-tl from-amber-400/25 via-yellow-300/15 to-transparent blur-[60px] sm:blur-[70px] md:blur-[80px] pointer-events-none"
    aria-hidden="true"
  >
  </div>
</section>

<style>
  /* Tečkované čáry z drobných kulatých teček (technický styl).
     Velikost tečky: poloměr 0.75px (~1.5px průměr). Rozestup: 8px. */
  section {
    --dot: #a1a1aa;
    --dots: radial-gradient(circle, var(--dot) 0.75px, transparent 1.1px);
  }

  /* horní čára */
  .dots-t {
    background-image: var(--dots);
    background-size: 8px 3px;
    background-repeat: repeat-x;
    background-position: top left;
  }

  /* svislé čáry vlevo a vpravo */
  .dots-x {
    background-image: var(--dots), var(--dots);
    background-size:
      3px 8px,
      3px 8px;
    background-repeat: repeat-y, repeat-y;
    background-position:
      left top,
      right top;
  }
</style>
