---
// src/components/Placement.astro

const placementItems = [
  {
    num: "01",
    title: "Na kovovém rámu",
    desc: 'Drží samo <strong class="font-semibold text-zinc-900"> na magnet</strong>. Nahmatáte ho poslepu a jedním stiskem aktivujete sirénu i SMS poplach.',
    image: "/button-under-table.webp",
    alt: "Tísňové tlačítko magneticky přichycené pod masérským stolem",
  },
  {
    num: "02",
    title: "V kapse",
    desc: 'Díky kompaktním rozměrům padne přesně <strong class="font-semibold text-zinc-900">do kapsy</strong> zástěry nebo kalhot.',
    image: "/button-pocket.webp",
    alt: "Diskrétní nošení tísňového tlačítka v kapse",
  },
  {
    num: "03",
    title: " Pod pultem nebo stolem",
    desc: 'Na <strong class="font-semibold text-zinc-900">nalepovací kovové destičce</strong> drží jako přibité, ale kdykoliv ho můžete sundat.',
    image: "/button-under-reception.webp",
    alt: "Umístění tísňového tlačítka pod deskou recepce na 3M destičku",
  },
];
---

<!-- 2. UMÍSTĚNÍ / VARIABILITA UCHYCENÍ -->
<section
  id="umisteni"
  class="py-20 sm:py-28 md:py-28 lg:py-32 bg-white relative overflow-hidden"
>
  <!-- Kotva pro případné starší odkazy -->
  <div id="variabilita" class="absolute -top-16 left-0 pointer-events-none"></div>

  <!-- Horní smaragdová záře navazující na Instalaci -->
  <div
    class="absolute -top-[200px] -left-32 w-80 h-[600px] sm:w-96 rounded-full bg-gradient-to-r from-emerald-500/20 via-green-400/10 to-transparent blur-[80px] sm:blur-[100px] pointer-events-none"
    aria-hidden="true"
  ></div>
  <div
    class="absolute -top-[200px] -right-32 w-80 h-[600px] sm:w-96 rounded-full bg-gradient-to-l from-emerald-500/20 via-green-400/10 to-transparent blur-[80px] sm:blur-[100px] pointer-events-none"
    aria-hidden="true"
  ></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Hlavička sekce -->
    <div class="max-w-3xl mx-auto text-center mb-12 sm:mb-16 md:mb-20">
      <h2
        class="text-center text-4xl sm:text-5xl md:text-5xl lg:text-[3.75rem] font-bold tracking-tight text-zinc-950 font-display leading-[1.08]"
      >
        Vždy na dosah
      </h2>
      
      <p
        class="text-center text-base sm:text-lg md:text-xl text-zinc-500 mt-4 leading-relaxed max-w-sm sm:max-w-xl md:max-w-2xl mx-auto font-normal"
      >
        Máte nespočet možností kam tlačítko umístit.
      </p>
    </div>

    <!-- 3 KARTY: na mobilu nativní Apple swipe carousel, na desktopu 3 sloupce -->
    <div
      id="slider-container"
      class="flex md:grid md:grid-cols-3 overflow-x-auto snap-x snap-mandatory -mx-4 px-4 sm:-mx-6 sm:px-6 gap-4 sm:gap-6 md:gap-8 lg:gap-10 items-start pb-4 scroll-smooth custom-scrollbar"
      style="-webkit-overflow-scrolling: touch;"
    >
      {
        placementItems.map((item, index) => (
          <div
            class={`flex flex-col w-[85vw] sm:w-[320px] shrink-0 snap-center md:w-auto ${index === 1 ? 'md:mt-6 lg:mt-8' : ''}`}
          >
            <!-- Obrázek -->
            <div class="relative w-full aspect-[4/3] sm:aspect-[4/5] md:aspect-[4/3.1] md:max-h-[340px] lg:max-h-[360px] rounded-2xl md:rounded-[1.75rem] overflow-hidden bg-zinc-100 shadow-sm transition-all duration-500 mb-4 sm:mb-5 md:mb-6">
              <!-- Fotka -->
              <img
                src={item.image}
                alt={item.alt}
                class="w-full h-full object-cover object-center"
                loading="eager"
              />
            </div>

            <!-- Text pod fotkou -->
            <div class="flex flex-col items-start text-left flex-1">
              <!-- Nadpis -->
              <h3 class="text-xl sm:text-2xl md:text-2xl lg:text-[1.65rem] font-bold tracking-tight text-zinc-950 mb-2 sm:mb-3 leading-snug">
                {item.title}
              </h3>

              <!-- Popis -->
              <p class="text-[15px] sm:text-lg md:text-base lg:text-[1.05rem] text-zinc-600 leading-relaxed" set:html={item.desc} />
            </div>
          </div>
        ))
      }
    </div>

    <!-- Mobilní indikátor / tečky -->
    <div class="flex md:hidden justify-center mt-6">
      <div
        id="slider-indicator"
        class="flex items-center gap-2 py-2 px-3.5 bg-zinc-100 rounded-full border border-zinc-200/80 shadow-sm"
        role="tablist"
        aria-label="Pozice v carouselu"
      >
        {
          placementItems.map((_, index) => (
            <button
              type="button"
              class={`dot h-2 rounded-full cursor-pointer transition-all duration-300 p-0 border-0 ${
                index === 0
                  ? "w-6 bg-zinc-950"
                  : "w-2 bg-zinc-300 hover:bg-zinc-400"
              }`}
              data-index={index}
              aria-label={`Přejít na kartu ${index + 1}`}
            />
          ))
        }
      </div>
    </div>

  </div>
</section>

<style>
  /* Vlastní styly scrollbaru pro mobilní carousel */
  .custom-scrollbar {
    scrollbar-width: thin;
    scrollbar-color: #d4d4d8 transparent;
  }
  .custom-scrollbar::-webkit-scrollbar {
    height: 5px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: #d4d4d8;
    border-radius: 9999px;
  }
</style>

<script>
  function initPlacementSlider() {
    const container = document.getElementById('slider-container');
    const dots = document.querySelectorAll('#slider-indicator .dot');

    if (!container || !dots.length) return;

    function setActive(activeIndex: number) {
      dots.forEach((dot, index) => {
        if (index === activeIndex) {
          dot.classList.remove('w-2', 'bg-zinc-300');
          dot.classList.add('w-6', 'bg-zinc-950');
        } else {
          dot.classList.remove('w-6', 'bg-zinc-950');
          dot.classList.add('w-2', 'bg-zinc-300');
        }
      });
    }

    function updateDots() {
      const scrollLeft = container.scrollLeft;
      const cards = container.querySelectorAll('.snap-center') as NodeListOf<HTMLElement>;
      if (!cards.length) return;

      const containerCenter = scrollLeft + container.clientWidth / 2;
      let closestIdx = 0;
      let minDiff = Infinity;

      cards.forEach((card, idx) => {
        const cardCenter = card.offsetLeft + card.offsetWidth / 2;
        const diff = Math.abs(containerCenter - cardCenter);
        if (diff < minDiff) {
          minDiff = diff;
          closestIdx = idx;
        }
      });

      setActive(closestIdx);
    }

    container.addEventListener('scroll', updateDots, { passive: true });
    container.addEventListener('touchmove', updateDots, { passive: true });
    window.addEventListener('resize', updateDots, { passive: true });

    dots.forEach((dot, index) => {
      dot.addEventListener('click', (e) => {
        e.preventDefault();
        const cards = container.querySelectorAll('.snap-center') as NodeListOf<HTMLElement>;
        if (cards[index]) {
          cards[index].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
          setActive(index);
        }
      });
    });

    updateDots();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initPlacementSlider);
  } else {
    initPlacementSlider();
  }
  document.addEventListener("astro:page-load", initPlacementSlider);
</script>


