---
interface PlacementOption {
  title: string;
  desc: string;
  image: string;
  alt: string;
  align: "left" | "right-shifted" | "reversed";
}

const placementOptions: PlacementOption[] = [
  {
    title: "Na kovový rám",
    desc: "Drží samo na silný neodymový magnet. Nahmatáte ho poslepu pod masérským stolem nebo kosmetickým křeslem.",
    image: "/button_undertable.jpg",
    alt: "Tísňové tlačítko magneticky přichycené na kovový rám stolu",
    align: "left",
  },
  {
    title: "Do kapsy",
    desc: "Díky kompaktním a tenkým rozměrům padne přesně do kapsy zástěry, pláště nebo kalhot. Ochrana stále s vámi.",
    image: "/button-pocket.jpg",
    alt: "Diskrétní nošení tísňového tlačítka v kapse zástěry",
    align: "right-shifted",
  },
  {
    title: "Pod pult nebo stůl",
    desc: "Na přiloženou samolepicí 3M destičku drží jako přibité na dřevěném, skleněném i laminátovém povrchu recepce.",
    image: "/button_underdesk.jpg",
    alt: "Umístění tísňového tlačítka pod deskou stolu či recepce",
    align: "reversed",
  },
];
---

<section id="umisteni" class="py-20 sm:py-28 lg:py-32 px-6 sm:px-12 lg:px-20 bg-white select-none" aria-labelledby="placement-heading">
  <div class="max-w-[1260px] mx-auto">
    
    <!-- Section Heading -->
    <div class="text-left mb-16 sm:mb-24">
      <h2 id="placement-heading" class="font-sans font-bold text-5xl sm:text-7xl lg:text-[84px] text-[#2B2523] tracking-[-0.05em] leading-[0.92]">
        Nespočet<br />
        možností kam<br />
        tlačítko umístit
      </h2>
    </div>

    <!-- Rows structure matching Figma node 4:25 / 7:51 -->
    <div class="divide-y divide-[#DDDDDD] border-b border-[#DDDDDD]">
      
      <!-- TOP BLOCK (Row 1 & 2 in Figma):
           Left photo [312px], Middle column with 2 stacked texts (Na kovový rám & Do kapsy), Right photo [312px] -->
      <div class="py-10 sm:py-14 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
        <!-- 1. Left Photo: Na kovový rám -->
        <div class="lg:col-span-3">
          <div class="w-full max-w-[312px] aspect-square rounded-2xl overflow-hidden bg-[#2B2420] shadow-sm">
            <img
              src="/placement-kovovy-ram.png"
              alt="Na kovový rám"
              class="w-full h-full object-cover"
              loading="lazy"
              width="312"
              height="312"
            />
          </div>
        </div>

        <!-- 2. Middle Column: Both "Na kovový rám" and "Do kapsy" text stacked -->
        <div class="lg:col-span-5 text-left flex flex-col justify-between py-2 space-y-10 sm:space-y-12">
          <!-- Item 1: Na kovový rám -->
          <div>
            <h3 class="font-sans font-medium text-2xl sm:text-[38px] text-[#2B2523] tracking-[-0.03em] leading-tight mb-3">
              Na kovový rám
            </h3>
            <p class="font-mono text-xs text-[#2B2523] leading-[1.5] max-w-md font-normal">
              Drží samo na magnet. Nepotřebuje montáž a jedním stiskem aktivujete sirénu i SMS poplach.
            </p>
          </div>

          <!-- Item 2: Do kapsy -->
          <div>
            <h3 class="font-sans font-medium text-2xl sm:text-[38px] text-[#2B2523] tracking-[-0.03em] leading-tight mb-3">
              Do kapsy
            </h3>
            <p class="font-mono text-xs text-[#2B2523] leading-[1.5] max-w-md font-normal">
              Díky kompaktním rozměrům padne přesně do kapsy zástěry nebo kalhot.
            </p>
          </div>
        </div>

        <!-- 3. Right Photo: Do kapsy -->
        <div class="lg:col-span-4 flex justify-start lg:justify-end">
          <div class="w-full max-w-[312px] aspect-square rounded-2xl overflow-hidden bg-[#8D7F73] shadow-sm">
            <img
              src="/placement-do-kapsy.png"
              alt="Do kapsy"
              class="w-full h-full object-cover"
              loading="lazy"
              width="312"
              height="312"
            />
          </div>
        </div>
      </div>

      <!-- BOTTOM BLOCK (Row 3 in Figma):
           Left column with "Pod pult nebo stůl" text, Center/Middle photo [312px], Empty right -->
      <div class="py-10 sm:py-14 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
        <!-- 1. Left: Pod pult nebo stůl Text -->
        <div class="lg:col-span-6 text-left">
          <h3 class="font-sans font-medium text-2xl sm:text-[38px] text-[#2B2523] tracking-[-0.03em] leading-tight mb-3">
            Pod pult nebo stůl
          </h3>
          <p class="font-mono text-xs text-[#2B2523] leading-[1.5] max-w-md font-normal">
            Na nalepovací kovové destičce drží jako přibitý, ale kdykoliv ho můžete sundat.
          </p>
        </div>

        <!-- 2. Middle: Photo Pod pult nebo stůl -->
        <div class="lg:col-span-6 flex justify-start lg:justify-start">
          <div class="w-full max-w-[312px] aspect-square rounded-2xl overflow-hidden bg-[#4A3F38] shadow-sm">
            <img
              src="/placement-pod-pult.png"
              alt="Pod pult nebo stůl"
              class="w-full h-full object-cover"
              loading="lazy"
              width="312"
              height="312"
            />
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

