---
// src/components/Placement.astro

const placementItems = [
  {
    num: "01",
    title: "Na kovovém rámu",
    desc: 'Drží samo <strong class="font-semibold text-zinc-900"> na magnet</strong>. Nahmatáte ho poslepu a jedním stiskem aktivujete sirénu i SMS poplach.',
    image: "/button-under-table.jpg",
    alt: "Tísňové tlačítko magneticky přichycené pod masérským stolem",
  },
  {
    num: "02",
    title: "V kapse",
    desc: 'Díky kompaktním rozměrům padne přesně <strong class="font-semibold text-zinc-900">do kapsy</strong> zástěry nebo kalhot.',
    image: "/button-pocket.jpg",
    alt: "Diskrétní nošení tísňového tlačítka v kapse",
  },
  {
    num: "03",
    title: " Pod pultem nebo stolem",
    desc: 'Na <strong class="font-semibold text-zinc-900">nalepovací kovové destičce</strong> drží jako přibité, ale kdykoliv ho můžete sundat.',
    image: "/button-under-reception.jpg",
    alt: "Umístění tísňového tlačítka pod deskou recepce na 3M destičku",
  },
];
---

<!-- 2. UMÍSTĚNÍ / VARIABILITA UCHYCENÍ -->
<section
  id="umisteni"
  class="py-24 sm:py-32 md:py-24 lg:py-28 bg-white relative min-h-[100svh] flex flex-col justify-center"
>
  <!-- Kotva pro případné starší odkazy -->
  <div id="variabilita" class="absolute -top-16 left-0 pointer-events-none"></div>

  <!-- Horní smaragdová záře navazující na Instalaci (stejný styl jako boční záře) -->
  <div
    class="absolute -top-[200px] -left-32 w-80 h-[600px] sm:w-96 rounded-full bg-gradient-to-r from-emerald-500/20 via-green-400/10 to-transparent blur-[80px] sm:blur-[100px] pointer-events-none"
    aria-hidden="true"
  ></div>
  <div
    class="absolute -top-[200px] -right-32 w-80 h-[600px] sm:w-96 rounded-full bg-gradient-to-l from-emerald-500/20 via-green-400/10 to-transparent blur-[80px] sm:blur-[100px] pointer-events-none"
    aria-hidden="true"
  ></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Hlavička sekce -->
    <div class="max-w-3xl mx-auto text-center mb-16 sm:mb-20 md:mb-20 lg:mb-24">
      <h2
        class="text-center text-4xl sm:text-5xl md:text-5xl lg:text-[3.75rem] font-bold tracking-tight text-zinc-950 font-display leading-[1.08]"
      >
        Vždy na dosah
      </h2>
      
      <p
        class="text-center text-base sm:text-lg md:text-xl text-zinc-500 mt-4 sm:mt-5 leading-relaxed max-w-sm sm:max-w-xl md:max-w-2xl mx-auto font-normal"
      >
       Máte nespočet možností kam tlačítko umístit. 
      </p>
    </div>

    <!-- 3 KARTY: na mobilu nativní Apple swipe carousel, na desktopu 3 sloupce -->
    <div
      id="slider-container"
      class="flex md:grid md:grid-cols-3 overflow-x-auto snap-x snap-mandatory no-scrollbar -mx-6 px-6 gap-6 md:gap-8 lg:gap-10 scroll-smooth items-start"
      style="-webkit-overflow-scrolling: touch;"
    >
      {
        placementItems.map((item, index) => (
          <div
            class={`flex flex-col select-none w-[85vw] shrink-0 snap-center md:w-auto ${index === 1 ? 'md:mt-6 lg:mt-8' : ''}`}
          >
            <!-- Text nad fotkou -->
            <div class="pb-4 sm:pb-5 md:pb-6 flex flex-col items-center text-center md:items-start md:text-left flex-1">
              <!-- Nadpis -->
              <h3 class="text-xl sm:text-2xl md:text-2xl lg:text-[1.65rem] font-bold tracking-tight text-zinc-950 mb-3 sm:mb-3.5 leading-snug">
                {item.title}
              </h3>

              <!-- Popis -->
              <p class="text-base sm:text-lg md:text-base lg:text-[1.05rem] text-zinc-600 leading-relaxed max-w-sm md:max-w-none" set:html={item.desc} />
            </div>

            <!-- Obrázek: na telefonu původní aspect-[4/3] sm:aspect-[4/5] a rounded-2xl, na desktopu citlivě zmenšeno na md:aspect-[4/3.1] md:max-h-[340px] -->
            <div class="relative w-full aspect-[4/3] sm:aspect-[4/5] md:aspect-[4/3.1] md:max-h-[340px] lg:max-h-[360px] rounded-2xl md:rounded-[1.75rem] overflow-hidden bg-zinc-100 shadow-sm group-hover:shadow-md transition-all duration-500">
              <!-- Fotka -->
              <img
                src={item.image}
                alt={item.alt}
                class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out"
                loading="lazy"
              />
            </div>
          </div>
        ))
      }
    </div>

    <!-- Plně funkční dynamický indikátor (pouze na mobilu) -->
    <div class="flex md:hidden justify-center mt-6">
      <div
        id="slider-indicator"
        class="flex items-center gap-2.5 py-2 px-4 bg-zinc-200/90 rounded-full border border-zinc-300/40 shadow-inner"
        role="tablist"
        aria-label="Pozice v carouselu"
      >
        {
          placementItems.map((_, index) => (
            <button
              type="button"
              class={`dot h-2 rounded-full cursor-pointer transition-all duration-300 p-0 border-0 ${
                index === 0
                  ? "w-6 bg-zinc-950"
                  : "w-2 bg-zinc-400 hover:bg-zinc-600"
              }`}
              data-index={index}
              aria-label={`Přejít na kartu ${index + 1}`}
            />
          ))
        }
      </div>
    </div>

  </div>

</section>

<style>
  /* Skrytí scrollbaru pro swipe carousel */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script>
  function initSliderIndicator() {
    const container = document.getElementById('slider-container');
    const dots = document.querySelectorAll('#slider-indicator .dot');

    if (!container || !dots.length) return;

    function setActive(activeIndex: number) {
      dots.forEach((dot, index) => {
        if (index === activeIndex) {
          dot.classList.remove('w-2', 'bg-zinc-400');
          dot.classList.add('w-6', 'bg-zinc-950');
        } else {
          dot.classList.remove('w-6', 'bg-zinc-950');
          dot.classList.add('w-2', 'bg-zinc-400');
        }
      });
    }

    function updateDots() {
      const scrollLeft = container.scrollLeft;
      const cards = container.querySelectorAll('.snap-center') as NodeListOf<HTMLElement>;
      if (!cards.length) return;

      const containerCenter = scrollLeft + container.clientWidth / 2;
      let closestIdx = 0;
      let minDiff = Infinity;

      cards.forEach((card, idx) => {
        const cardCenter = card.offsetLeft + card.offsetWidth / 2;
        const diff = Math.abs(containerCenter - cardCenter);
        if (diff < minDiff) {
          minDiff = diff;
          closestIdx = idx;
        }
      });

      setActive(closestIdx);
    }

    container.addEventListener('scroll', updateDots, { passive: true });
    container.addEventListener('touchmove', updateDots, { passive: true });
    container.addEventListener('touchend', () => {
      setTimeout(updateDots, 60);
      setTimeout(updateDots, 180);
      setTimeout(updateDots, 350);
    }, { passive: true });
    window.addEventListener('resize', updateDots, { passive: true });

    dots.forEach((dot, index) => {
      dot.addEventListener('click', (e) => {
        e.preventDefault();
        const cards = container.querySelectorAll('.snap-center') as NodeListOf<HTMLElement>;
        if (cards[index]) {
          cards[index].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
          setActive(index);
        }
      });
    });

    updateDots();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initSliderIndicator);
  } else {
    initSliderIndicator();
  }
  document.addEventListener("astro:page-load", initSliderIndicator);
</script>
