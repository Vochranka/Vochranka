---
/**
 * Pricing.astro
 *
 * Left column of the pricing section matching the new design template:
 * - Title: "Ceník"
 * - Subtitle: "Žádné pronájmy ani montáž zdarma. Osobní předvedení. 14 dní na vyzkoušení."
 * - Badge: "[-50 %] Nabídka pro prvních 100 klientů"
 * - Card 1: 2 990 Kč (5 980 Kč / první rok) [-50 %], Ušetříte 2 990 Kč, 1. rok provozu zdarma, + Co je v sadě
 * - Card 2: Provoz od 2. roku [-50 %], 83 Kč / měsíčně 167 Kč, 999 Kč ročně (původně 1 998 Kč), + Co je v ceně
 * - Footer note: Potřebujete více tlačítek?
 */
---

<div
  id="cenik"
  class="w-full flex flex-col items-center lg:items-end lg:pr-18 xl:pr-32 scroll-mt-2 sm:scroll-mt-4"
>
  <div class="w-full max-w-[460px]">
    <!-- Section Heading -->
    <h2
      class="text-4xl sm:text-5xl lg:text-[46px] xl:text-[56px] font-bold text-ink tracking-tight leading-[0.95] mb-2 sm:mb-2.5"
    >
      Ceník
    </h2>

    <!-- Subtitle -->
    <p
      class="text-[13px] sm:text-[14px] text-neutral-600 leading-relaxed max-w-[42ch] mb-3 sm:mb-3.5"
    >
      14 dní na vyzkoušení.
    </p>

    <!-- Top Promo Badge: Nabídka pro prvních 100 klientů -->
    <div
      class="inline-flex items-center gap-2 rounded-full border border-neutral-900 pl-1 pr-3 py-0.5 mb-3 sm:mb-3.5 select-none"
    >
      <span
        class="rounded-full bg-ink text-white font-bold text-[10px] sm:text-[11px] px-2 py-0.5 tracking-tight"
      >
        -50 %
      </span>
      <span class="text-[11px] sm:text-xs font-medium text-ink">
        Nabídka pro prvních 100 klientů
      </span>
    </div>

    <!-- Pricing Cards Stack -->
    <div class="space-y-2.5 sm:space-y-3">
      <!-- Card 1: Základní sada (White card with black border) -->
      <div
        class="relative bg-white rounded-xl sm:rounded-2xl border-[1.5px] border-neutral-900 p-4 sm:p-5 shadow-xs"
      >
        <!-- Price row + -50% badge -->
        <div class="flex items-start justify-between gap-3">
          <div>
            <div class="flex items-baseline gap-2 flex-wrap">
              <span
                class="text-2xl sm:text-3xl lg:text-[34px] xl:text-[38px] font-bold text-ink tracking-tight leading-none"
              >
                2 990 Kč
              </span>
              <span
                class="text-sm sm:text-base text-neutral-400 line-through font-normal"
              >
                5 980 Kč
              </span>
              <span class="text-xs sm:text-[13px] text-neutral-500 font-normal">
                / první rok
              </span>
            </div>
            <p class="text-[11px] sm:text-xs font-bold text-neutral-900 mt-1">
              Ušetříte 2 990 Kč
            </p>
          </div>
          <span
            class="inline-flex items-center justify-center rounded-full bg-[#FF4747] text-white text-[11px] font-bold px-2 py-0.5 tracking-tight shrink-0 shadow-xs"
          >
            -50 %
          </span>
        </div>

        <!-- Description -->
        <h3 class="text-sm sm:text-[15px] font-bold text-ink mt-3">
          1. rok provozu zdarma
        </h3>
        <p
          class="text-[11px] sm:text-xs text-neutral-600 mt-1 leading-relaxed max-w-[38ch]"
        >
          Kompletní fyzická sada Vochranka + 1. rok provozu bez dalších
          poplatků.
        </p>

        <!-- Toggle: Co je v sadě -->
        <div class="mt-3">
          <button
            type="button"
            class="accordion-toggle inline-flex items-center gap-1.5 rounded-full border border-neutral-300 bg-white px-3 py-0.5 text-[11px] sm:text-xs font-medium text-ink hover:bg-neutral-50 active:scale-95 transition-all cursor-pointer select-none"
            aria-expanded="false"
            aria-controls="co-je-v-sade-list"
          >
            <span class="toggle-icon text-xs font-light leading-none">+</span>
            <span>Co je v sadě</span>
          </button>
          <div id="co-je-v-sade-list" class="hidden pt-2.5 animate-fade-in">
            <div class="grid grid-cols-4 gap-2 sm:gap-2.5">
              <!-- 1. Tísňové tlačítko -->
              <div class="flex flex-col items-center text-center">
                <div
                  class="w-full aspect-square flex items-center justify-center p-1 overflow-hidden"
                >
                  <img
                    src="/button3.avif"
                    alt="Tísňové tlačítko"
                    class="w-[84%] h-[84%] object-contain drop-shadow-[0_3px_8px_rgba(0,0,0,0.16)] drop-shadow-[0_1px_2px_rgba(0,0,0,0.08)]"
                    loading="lazy"
                    width="120"
                    height="120"
                  />
                </div>
                <span
                  class="text-[10px] sm:text-[11px] font-medium text-ink mt-1.5 leading-tight"
                >
                  Tísňové tlačítko
                </span>
              </div>

              <!-- 2. Kovová podložka -->
              <div class="flex flex-col items-center text-center">
                <div
                  class="w-full aspect-square flex items-center justify-center p-1 overflow-hidden"
                >
                  <img
                    src="/underbutton.avif"
                    alt="Kovová podložka"
                    class="w-[115%] h-[115%] max-w-none object-contain drop-shadow-xs"
                    loading="lazy"
                    width="120"
                    height="120"
                  />
                </div>
                <span
                  class="text-[10px] sm:text-[11px] font-medium text-ink mt-1.5 leading-tight"
                >
                  Kovová podložka
                </span>
              </div>

              <!-- 3. Hlasitá siréna -->
              <div class="flex flex-col items-center text-center">
                <div
                  class="w-full aspect-square flex items-center justify-center p-1 overflow-hidden"
                >
                  <img
                    src="/siren.avif"
                    alt="Hlasitá siréna"
                    class="w-full h-full object-contain drop-shadow-xs"
                    loading="lazy"
                    width="120"
                    height="120"
                  />
                </div>
                <span
                  class="text-[10px] sm:text-[11px] font-medium text-ink mt-1.5 leading-tight"
                >
                  Hlasitá siréna
                </span>
              </div>

              <!-- 4. Vysílací brána -->
              <div class="flex flex-col items-center text-center">
                <div
                  class="w-full aspect-square flex items-center justify-center p-1 overflow-hidden"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="w-8 h-8 sm:w-9 sm:h-9 text-[#2A211D]"
                    aria-hidden="true"
                  >
                    <!-- Gateway base -->
                    <rect x="3" y="14" width="18" height="7" rx="2"></rect>
                    <line
                      x1="7"
                      y1="17.5"
                      x2="7.01"
                      y2="17.5"
                      stroke-width="2.5"></line>
                    <line
                      x1="10"
                      y1="17.5"
                      x2="10.01"
                      y2="17.5"
                      stroke-width="2.5"></line>
                    <!-- Center antenna -->
                    <line x1="12" y1="14" x2="12" y2="9"></line>
                    <!-- Broadcast signal waves -->
                    <path d="M8.5 7.5a5 5 0 0 1 7 0"></path>
                    <path d="M5.5 4.5a9.5 9.5 0 0 1 13 0"></path>
                  </svg>
                </div>
                <span
                  class="text-[10px] sm:text-[11px] font-medium text-ink mt-1.5 leading-tight"
                >
                  Vysílací brána
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Card 2: Provoz od 2. roku (Light gray card) -->
      <div class="relative bg-[#F5F5F5] rounded-xl sm:rounded-2xl p-4 sm:p-5">
        <!-- Top row: Heading + -50% badge -->
        <div class="flex items-center justify-between gap-3 mb-2">
          <h3 class="text-sm sm:text-[15px] font-bold text-ink">
            Provoz od 2. roku
          </h3>
          <span
            class="inline-flex items-center justify-center rounded-full bg-[#FF4747] text-white text-[11px] font-bold px-2 py-0.5 tracking-tight shrink-0 shadow-xs"
          >
            -50 %
          </span>
        </div>

        <!-- Price row -->
        <div class="flex items-baseline gap-2 flex-wrap">
          <span
            class="text-2xl sm:text-3xl lg:text-[34px] xl:text-[38px] font-bold text-ink tracking-tight leading-none"
          >
            83 Kč
          </span>
          <span
            class="text-sm sm:text-base text-neutral-400 line-through font-normal"
          >
            167 Kč
          </span>
          <span class="text-xs sm:text-[13px] text-neutral-500 font-normal">
            / měsíčně
          </span>
        </div>
        <p class="text-[11px] sm:text-xs text-neutral-500 mt-0.5">
          999 Kč ročně (původně 1 998 Kč)
        </p>

        <!-- Divider line -->
        <div class="border-t border-neutral-300/80 my-2.5 sm:my-3"></div>

        <!-- Description -->
        <p
          class="text-[11px] sm:text-xs text-neutral-600 leading-relaxed max-w-[40ch]"
        >
          Platí se až od druhého roku provozu – méně než jedno kafe měsíčně.
        </p>

        <!-- Toggle: Co je v ceně -->
        <div class="mt-2.5 sm:mt-3">
          <button
            type="button"
            class="accordion-toggle inline-flex items-center gap-1.5 rounded-full border border-neutral-300 bg-transparent px-3 py-0.5 text-[11px] sm:text-xs font-medium text-ink hover:bg-white active:scale-95 transition-all cursor-pointer select-none"
            aria-expanded="false"
            aria-controls="co-je-v-cene-list"
          >
            <span class="toggle-icon text-xs font-light leading-none">+</span>
            <span>Co je v ceně</span>
          </button>
          <div
            id="co-je-v-cene-list"
            class="hidden pt-2.5 mt-2 border-t border-line/60 text-[11px] sm:text-xs text-neutral-600 space-y-1 animate-fade-in"
          >
            <div class="flex items-center gap-2 text-ink">
              <span class="text-emerald-600 font-bold">✓</span>
              <span>Neomezené nouzové SMS až na 3 zvolená telefonní čísla</span>
            </div>
            <div class="flex items-center gap-2 text-ink">
              <span class="text-emerald-600 font-bold">✓</span>
              <span>Nepřetržitý monitoring funkčnosti</span>
            </div>
            <div class="flex items-center gap-2 text-ink">
              <span class="text-emerald-600 font-bold">✓</span>
              <span>Zákaznická a technická podpora v ČR</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Below Card 2: Potřebujete více tlačítek? -->
    <div class="mt-3.5 sm:mt-4 flex items-center gap-3 sm:gap-3.5">
      <img
        src="/button3.avif"
        alt="Tlačítko Vochranka"
        class="w-10 h-10 sm:w-11 sm:h-11 object-contain shrink-0 drop-shadow-[0_2px_6px_rgba(0,0,0,0.12)]"
        loading="lazy"
        width="44"
        height="44"
      />
      <div>
        <h4 class="text-xs sm:text-[13px] font-bold text-ink mb-0.5">
          Potřebujete více tlačítek?
        </h4>
        <p
          class="text-[11px] sm:text-xs text-neutral-600 leading-relaxed max-w-[42ch]"
        >
          Každé další tlačítko stojí jednorázově 699&nbsp;Kč s&nbsp;1.&nbsp;rokem provozu zdarma.
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  function setupPricingAccordions() {
    const buttons =
      document.querySelectorAll<HTMLButtonElement>(".accordion-toggle");

    buttons.forEach((btn) => {
      if (btn.dataset.bound === "true") return;
      btn.dataset.bound = "true";

      btn.addEventListener("click", () => {
        const targetId = btn.getAttribute("aria-controls");
        if (!targetId) return;
        const target = document.getElementById(targetId);
        const icon = btn.querySelector<HTMLElement>(".toggle-icon");
        if (!target) return;

        const isExpanded = btn.getAttribute("aria-expanded") === "true";
        if (isExpanded) {
          btn.setAttribute("aria-expanded", "false");
          target.classList.add("hidden");
          if (icon) icon.textContent = "+";
        } else {
          btn.setAttribute("aria-expanded", "true");
          target.classList.remove("hidden");
          if (icon) icon.textContent = "−";
        }
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupPricingAccordions);
  } else {
    setupPricingAccordions();
  }
  document.addEventListener("astro:page-load", setupPricingAccordions);
</script>
