---
// src/components/Pricing.astro
import {
  ChevronDown,
  Battery,
  BookOpen,
  MessageSquare,
  Activity,
  BatteryWarning,
  Headphones,
  Signal,
  ArrowRight,
} from "lucide-astro";

const hardwareItems = [
  {
    image: "/button1.png",
    alt: "Tísňové tlačítko",
    label: "1× Tlačítko",
  },
  {
    image: "/siren.png",
    alt: "Brána se sirénou",
    label: "1× Siréna",
  },
  {
    image: "/button2.png",
    alt: "Magnetické uchycení a 3M destička",
    label: "1× Magnetické uchycení",
    desc: "Drží na kovu samo. Na dřevěný stůl nalepíte tenkou kovovou 3M destičku z balení.",
  },
  {
    icon: Battery,
    alt: "Baterie",
    label: "1× Baterie",
  },
];

const serviceItems = [
  {
    tag: "SMS",
    title: "Neomezené tísňové SMS",
    subtitle: "Až 3 vybrané kontakty",
    detail: "Okamžité doručení rodině nebo kolegům do 2 vteřin od stisku.",
    icon: MessageSquare,
    badge: "Neomezeně",
  },
  {
    tag: "Dohled",
    title: "24/7 monitoring spojení",
    subtitle: "Nepřetržitá kontrola",
    detail: "Automatický dohled nad funkčností brány a dostupností sítě.",
    icon: Activity,
    badge: "24/7",
  },
  {
    tag: "Baterie",
    title: "Hlídání stavu baterie",
    subtitle: "Upozornění pod 15 %",
    detail: "Včasná SMS zpráva s předstihem několika týdnů před vybitím.",
    icon: BatteryWarning,
    badge: "Automaticky",
  },
  {
    tag: "Data",
    title: "Zabezpečená SIM a data",
    subtitle: "Šifrovaný přenos",
    detail: "Bezstarostné spojení bez nutnosti řešit vlastní mobilní tarif.",
    icon: Signal,
    badge: "V ceně",
  },
  {
    tag: "Podpora",
    title: "Česká telefonická podpora",
    subtitle: "Osobní přístup",
    detail: "Rychlá pomoc na telefonu i e-mailu kdykoliv potřebujete.",
    icon: Headphones,
    badge: "V češtině",
  },
];
---

<section
  id="cenik"
  class="py-16 sm:py-24 lg:py-28 bg-[#f4f3f0] relative overflow-hidden"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-14">
      <h2
        class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-zinc-950 font-display leading-[1.12]"
      >
        Jednoduchá cena.<br />
        <span class="text-[#63625C]">Bez skrytých kliček.</span>
      </h2>
      <p class="text-sm sm:text-base text-zinc-600 mt-3 leading-relaxed">
        Hardware navždy ve vašem vlastnictví. Žádné pronájmy ani montážní
        poplatky.
      </p>
    </div>

    <!-- Apple-style minimalistická karta -->
    <div
      class="bg-white rounded-3xl p-6 sm:p-10 md:p-12 border border-zinc-200/90 shadow-sm transition-all duration-300"
    >
      <div class="max-w-2xl mx-auto space-y-9">
        <!-- 1. Hardware 1 999 Kč / jednorázově -->
        <div>
          <div class="flex items-baseline flex-wrap gap-x-2.5 gap-y-1">
            <span
              class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-zinc-950 font-display"
            >
              1 999 Kč
            </span>
            <span
              class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-[#63625C] font-display"
            >
              / jednorázově
            </span>
            <span class="text-xs text-zinc-400 font-medium ml-1">vč. DPH</span>
          </div>
          <p class="text-xs sm:text-sm text-zinc-600 mt-1.5">
            Celá fyzická sada Vochranka je váš trvalý majetek.
          </p>
          <div class="mt-4">
            <button
              type="button"
              id="toggle-hardware-drawer"
              aria-expanded="false"
              class="group inline-flex items-center gap-2 px-4 py-2 rounded-full bg-zinc-100 hover:bg-zinc-200/80 active:scale-[0.98] text-xs font-semibold text-zinc-800 transition-all cursor-pointer"
            >
              <span>Co sada obsahuje</span>
              <ChevronDown
                class="w-3.5 h-3.5 text-zinc-500 group-hover:text-zinc-900 transition-transform duration-300"
                id="hardware-chevron"
              />
            </button>
          </div>

          <!-- Výsuvný blok: Hardware položky (přehledná mřížka bez scrollování) -->
          <div
            id="hardware-drawer"
            class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-500 ease-out"
          >
            <div class="overflow-hidden">
              <div class="pt-6">
                <div
                  class="grid grid-cols-2 sm:grid-cols-4 gap-4 sm:gap-6 items-start"
                >
                  {
                    hardwareItems.map((item) => {
                      const Icon = item.icon;
                      return (
                        <div class="flex flex-col items-center text-center">
                          <div class="h-24 sm:h-28 w-full flex items-center justify-center mb-2.5">
                            {item.image ? (
                              <img
                                src={item.image}
                                alt={item.alt}
                                class="max-h-24 sm:max-h-28 max-w-full object-contain drop-shadow-sm select-none"
                                loading="lazy"
                              />
                            ) : (
                              <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-zinc-100/90 flex items-center justify-center text-zinc-800">
                                <Icon class="w-6 h-6 sm:w-7 sm:h-7 stroke-[1.8]" />
                              </div>
                            )}
                          </div>
                          <span class="text-xs sm:text-sm font-bold text-zinc-950 font-display">
                            {item.label}
                          </span>
                          {item.desc && (
                            <p class="text-[11px] text-zinc-500 mt-1 leading-snug">
                              {item.desc}
                            </p>
                          )}
                        </div>
                      );
                    })
                  }
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- 2. Provoz 990 Kč / ročně -->
        <div>
          <div class="flex items-baseline flex-wrap gap-x-2.5 gap-y-1">
            <span
              class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-zinc-950 font-display"
            >
              990 Kč
            </span>
            <span
              class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-[#63625C] font-display"
            >
              / ročně
            </span>
            <span class="text-xs text-zinc-400 font-medium ml-1"
              >vč. DPH (82 Kč / měsíc)</span
            >
          </div>
          <p class="text-xs sm:text-sm text-zinc-600 mt-1.5">
            Neomezené tísňové SMS rodině, 24/7 monitoring a datové přenosy.
          </p>
          <div class="mt-4">
            <button
              type="button"
              id="toggle-service-drawer"
              aria-expanded="false"
              class="group inline-flex items-center gap-2 px-4 py-2 rounded-full bg-zinc-100 hover:bg-zinc-200/80 active:scale-[0.98] text-xs font-semibold text-zinc-800 transition-all cursor-pointer"
            >
              <span>Co provoz zahrnuje</span>
              <ChevronDown
                class="w-3.5 h-3.5 text-zinc-500 group-hover:text-zinc-900 transition-transform duration-300"
                id="service-chevron"
              />
            </button>
          </div>

          <!-- Výsuvný blok: Provoz položky (přehledný seznam/mřížka bez scrollování) -->
          <div
            id="service-drawer"
            class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-500 ease-out"
          >
            <div class="overflow-hidden">
              <div class="pt-6">
                <div
                  class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5 items-start text-left"
                >
                  {
                    serviceItems.map((item) => {
                      const Icon = item.icon;
                      return (
                        <div class="flex items-start gap-3">
                          <div class="w-9 h-9 rounded-xl bg-zinc-100 flex items-center justify-center shrink-0 text-zinc-900 mt-0.5">
                            <Icon class="w-4 h-4 stroke-[1.8]" />
                          </div>
                          <div>
                            <h4 class="text-xs sm:text-sm font-bold text-zinc-950 font-display">
                              {item.title}
                            </h4>
                            <p class="text-[11px] text-zinc-500 leading-snug mt-0.5">
                              {item.detail}
                            </p>
                          </div>
                        </div>
                      );
                    })
                  }
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Tlačítko Kontaktovat přímo dole -->
        <div class="pt-6 flex flex-col items-center justify-center gap-3">
          <a
            href="#kontakt"
            class="w-full sm:w-auto min-w-[260px] inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-full bg-zinc-950 text-white font-semibold text-base hover:bg-zinc-800 active:scale-[0.99] transition-all shadow-md hover:shadow-lg"
          >
            <span>Kontaktovat</span>
            <ArrowRight class="w-4 h-4" />
          </a>
          <p class="text-xs text-zinc-400 text-center">
            Nezávazná poptávka • Rádi vám vše předvedeme nebo zodpovíme dotazy
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function setupDrawer(btnId: string, drawerId: string, chevronId: string) {
    const btn = document.getElementById(btnId);
    const drawer = document.getElementById(drawerId);
    const chevron = document.getElementById(chevronId);

    if (!btn || !drawer || btn.dataset.drawerInit) return;
    btn.dataset.drawerInit = "true";

    btn.addEventListener("click", () => {
      const isExpanded = btn.getAttribute("aria-expanded") === "true";
      const nextState = !isExpanded;
      btn.setAttribute("aria-expanded", String(nextState));

      if (nextState) {
        drawer.classList.remove("grid-rows-[0fr]");
        drawer.classList.add("grid-rows-[1fr]");
        if (chevron) chevron.classList.add("rotate-180");
      } else {
        drawer.classList.remove("grid-rows-[1fr]");
        drawer.classList.add("grid-rows-[0fr]");
        if (chevron) chevron.classList.remove("rotate-180");
      }
    });
  }

  function initPricingDrawers() {
    setupDrawer(
      "toggle-hardware-drawer",
      "hardware-drawer",
      "hardware-chevron",
    );
    setupDrawer("toggle-service-drawer", "service-drawer", "service-chevron");
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initPricingDrawers);
  } else {
    initPricingDrawers();
  }
  document.addEventListener("astro:page-load", initPricingDrawers);
</script>
