---
/**
 * Pricing.astro
 * 
 * Component for the "Ceník" section (Left column of Frame #5:2).
 * Positioned on the left side with comfortable width and padding.
 */

import { SITE_CONFIG } from "@/data/siteConfig";

const { pricingTiers, pricingSubtitle } = SITE_CONFIG;
---

<div class="w-full flex flex-col items-start lg:pr-8 xl:pr-14">
  <div class="w-full max-w-[500px] lg:ml-auto">
    <h2
      class="text-4xl sm:text-5xl lg:text-[68px] xl:text-[76px] font-bold text-ink tracking-tight leading-[0.95] mb-4 sm:mb-6"
    >
      Ceník
    </h2>
    <p
      class="text-[15px] text-ink-muted leading-relaxed mb-8 sm:mb-10"
    >
      {pricingSubtitle}
    </p>

    <!-- Pricing Cards Stack -->
    <div class="space-y-3.5 sm:space-y-4">
      {
        pricingTiers.map((tier) => (
          <div class="bg-box rounded-lg p-5 sm:p-6 lg:p-7 flex flex-col justify-between gap-3 transition-transform hover:-translate-y-0.5">
            <div>
              <div class="flex items-baseline gap-2 flex-wrap mb-2.5">
                <span class="text-3xl sm:text-4xl lg:text-[42px] font-medium text-ink tracking-tight leading-none">
                  {tier.price}
                </span>
                <span class="text-sm text-ink-muted font-normal tracking-normal">
                  {tier.period}
                </span>
              </div>
              <h3 class="text-base font-bold text-ink leading-snug mb-1.5">
                {tier.title}
              </h3>
              <p class="text-[13px] text-ink-muted leading-relaxed">
                {tier.description}
              </p>
            </div>

            {tier.hasCta && (
              <div class="pt-2">
                <button
                  type="button"
                  data-action="focus-contact"
                  class="inline-flex items-center justify-center rounded-full px-6 py-2.5 bg-ink text-white font-medium text-sm hover:opacity-85 active:scale-95 transition-all shadow-xs cursor-pointer select-none"
                >
                  {tier.ctaText || "Mám zájem"}
                </button>
              </div>
            )}
          </div>
        ))
      }
    </div>
  </div>
</div>
