---
import { ShieldCheck, Menu, X, ArrowRight } from "lucide-astro";
---

<header
  id="main-navbar"
  class="fixed top-0 left-0 right-0 z-50 w-full pointer-events-none transition-all duration-500 ease-out pt-3 sm:pt-4 px-4 sm:px-6 lg:px-8"
>
  <div
    id="navbar-container"
    class="mx-auto w-full transition-all duration-500 ease-out pointer-events-auto"
  >
    <div
      id="navbar-pill"
      class="relative flex items-center justify-between w-full transition-all duration-500 ease-out px-4 sm:px-6 py-2 sm:py-3 rounded-2xl md:rounded-full"
    >
      <!-- Brand / Logo (Left) with hover scaling & animation -->
      <a
        href="#"
        class="flex items-center gap-2.5 group focus:outline-none rounded-lg p-1 transition-transform duration-300 hover:scale-105 active:scale-95 z-10 shrink-0"
      >
        <div
          class="nav-icon-box w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-white/10 border border-white/20 flex items-center justify-center text-white shadow-soft-sm backdrop-blur-md transition-all duration-300"
        >
          <ShieldCheck class="w-5 h-5" />
        </div>
        <div class="flex flex-col">
          <span
            class="nav-text-color text-lg sm:text-xl font-bold font-display tracking-tight text-white leading-none transition-colors duration-200"
          >
            Vochranka<span class="text-white">.</span>
          </span>
          <span
            class="nav-subtext-color text-[10px] sm:text-[11px] font-medium tracking-wide text-zinc-300 uppercase mt-0.5 transition-colors duration-200"
          >
            Diskrétní bezpečí
          </span>
        </div>
      </a>

      <!-- Desktop Nav (Exactly Centered) with animated underline -->
      <nav
        class="hidden md:flex items-center gap-6 lg:gap-8 text-[14px] lg:text-[15px] font-medium absolute left-1/2 -translate-x-1/2 z-10 whitespace-nowrap"
      >
        <a
          href="#vyuziti"
          class="nav-link nav-link-color relative py-1 text-zinc-200 hover:text-white transition-all duration-300 inline-block hover:scale-105 active:scale-95 group"
        >
          <span>K čemu slouží</span>
          <span
            class="nav-underline absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-white rounded-full transition-all duration-300 group-hover:w-full"
          ></span>
        </a>
        <a
          href="#instalace"
          class="nav-link nav-link-color relative py-1 text-zinc-200 hover:text-white transition-all duration-300 inline-block hover:scale-105 active:scale-95 group"
        >
          <span>Instalace & Umístění</span>
          <span
            class="nav-underline absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-white rounded-full transition-all duration-300 group-hover:w-full"
          ></span>
        </a>
        <a
          href="#faq"
          class="nav-link nav-link-color relative py-1 text-zinc-200 hover:text-white transition-all duration-300 inline-block hover:scale-105 active:scale-95 group"
        >
          <span>Časté dotazy</span>
          <span
            class="nav-underline absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-white rounded-full transition-all duration-300 group-hover:w-full"
          ></span>
        </a>
      </nav>

      <!-- Desktop CTA Button (Right) -->
      <div class="hidden md:flex items-center gap-3 z-10 shrink-0">
        <a
          href="#kontakt"
          class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-full text-xs sm:text-sm font-medium bg-zinc-950 hover:bg-zinc-800 text-white shadow-md active:scale-95 transition-all duration-300 group whitespace-nowrap border border-white/10"
        >
          <span>Objednat sadu</span>
          <ArrowRight
            class="w-3.5 h-3.5 sm:w-4 sm:h-4 transition-transform duration-300 group-hover:translate-x-1"
          />
        </a>
      </div>

      <!-- Mobile Menu Button (Hamburger) -->
      <div class="flex items-center md:hidden z-10 shrink-0">
        <button
          id="mobile-menu-toggle"
          type="button"
          class="nav-burger-btn w-10 h-10 rounded-full bg-white/15 hover:bg-white/25 border border-white/20 flex items-center justify-center text-white shadow-soft-sm backdrop-blur-md active:scale-90 transition-all duration-200 focus:outline-none cursor-pointer"
          aria-label="Otevřít menu"
        >
          <Menu class="w-5 h-5" />
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Mobile Fullscreen Overlay Navigation (Clean Light Mode) -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-[100] bg-white/95 backdrop-blur-xl flex flex-col justify-between h-screen w-screen p-6 md:hidden opacity-0 pointer-events-none transition-all duration-300 -translate-y-4 overflow-y-auto text-zinc-900"
>
  <!-- Top Section: Header + Navigation cards right below -->
  <div>
    <!-- 1. Top Bar: Logo (Left) + Close Button (Right) -->
    <div
      class="flex items-center justify-between w-full pb-4 border-b border-zinc-200"
    >
      <a href="#" class="mobile-nav-link flex items-center gap-2.5">
        <div
          class="w-9 h-9 rounded-xl bg-zinc-100 border border-zinc-200 flex items-center justify-center text-zinc-950 shadow-sm"
        >
          <ShieldCheck class="w-5 h-5" />
        </div>
        <div class="flex flex-col">
          <span
            class="text-xl font-bold font-display tracking-tight text-zinc-950 leading-none"
          >
            Vochranka<span class="text-zinc-950">.</span>
          </span>
          <span
            class="text-[10px] font-medium tracking-wide text-zinc-500 uppercase mt-0.5"
          >
            Diskrétní bezpečí
          </span>
        </div>
      </a>

      <button
        id="mobile-menu-close"
        type="button"
        class="w-10 h-10 rounded-full bg-zinc-100 hover:bg-zinc-200 active:scale-90 border border-zinc-200 flex items-center justify-center text-zinc-900 transition-all duration-200 cursor-pointer"
        aria-label="Zavřít menu"
      >
        <X class="w-5 h-5" />
      </button>
    </div>

    <!-- 2. Navigation cards -->
    <nav class="flex flex-col gap-2.5 pt-8">
      <a
        href="#vyuziti"
        class="mobile-nav-link p-4 rounded-2xl bg-zinc-50 hover:bg-zinc-100 active:bg-zinc-200/70 border border-zinc-200 transition-all flex items-center justify-between group"
      >
        <div class="flex items-center gap-3.5">
          <span class="text-xs font-mono text-zinc-400">01</span>
          <span
            class="text-xl font-medium text-zinc-900 group-hover:text-zinc-600 transition-colors"
            >K čemu slouží & Využití</span
          >
        </div>
        <div
          class="w-8 h-8 rounded-full bg-white border border-zinc-200 flex items-center justify-center text-zinc-400 group-hover:text-zinc-900 transition-all"
        >
          <span
            class="text-sm font-light transition-transform duration-200 group-hover:translate-x-0.5"
            >→</span
          >
        </div>
      </a>

      <a
        href="#instalace"
        class="mobile-nav-link p-4 rounded-2xl bg-zinc-50 hover:bg-zinc-100 active:bg-zinc-200/70 border border-zinc-200 transition-all flex items-center justify-between group"
      >
        <div class="flex items-center gap-3.5">
          <span class="text-xs font-mono text-zinc-400">02</span>
          <span
            class="text-xl font-medium text-zinc-900 group-hover:text-zinc-600 transition-colors"
            >Instalace & Kam tlačítko dát</span
          >
        </div>
        <div
          class="w-8 h-8 rounded-full bg-white border border-zinc-200 flex items-center justify-center text-zinc-400 group-hover:text-zinc-900 transition-all"
        >
          <span
            class="text-sm font-light transition-transform duration-200 group-hover:translate-x-0.5"
            >→</span
          >
        </div>
      </a>

      <a
        href="#faq"
        class="mobile-nav-link p-4 rounded-2xl bg-zinc-50 hover:bg-zinc-100 active:bg-zinc-200/70 border border-zinc-200 transition-all flex items-center justify-between group"
      >
        <div class="flex items-center gap-3.5">
          <span class="text-xs font-mono text-zinc-400">03</span>
          <span
            class="text-xl font-medium text-zinc-900 group-hover:text-zinc-600 transition-colors"
            >Časté dotazy (FAQ)</span
          >
        </div>
        <div
          class="w-8 h-8 rounded-full bg-white border border-zinc-200 flex items-center justify-center text-zinc-400 group-hover:text-zinc-900 transition-all"
        >
          <span
            class="text-sm font-light transition-transform duration-200 group-hover:translate-x-0.5"
            >→</span
          >
        </div>
      </a>

      <a
        href="#kontakt"
        class="mobile-nav-link p-4 rounded-2xl bg-zinc-50 hover:bg-zinc-100 active:bg-zinc-200/70 border border-zinc-200 transition-all flex items-center justify-between group"
      >
        <div class="flex items-center gap-3.5">
          <span class="text-xs font-mono text-zinc-400">04</span>
          <span
            class="text-xl font-medium text-zinc-900 group-hover:text-zinc-600 transition-colors"
            >Ceník & Nezávazná objednávka</span
          >
        </div>
        <div class="flex items-center gap-2">
          <span
            class="text-xs font-semibold text-zinc-800 bg-white border border-zinc-200 px-2.5 py-0.5 rounded-full"
            >2 990 Kč</span
          >
          <div
            class="w-8 h-8 rounded-full bg-white border border-zinc-200 flex items-center justify-center text-zinc-400 group-hover:text-zinc-900 transition-all"
          >
            <span
              class="text-sm font-light transition-transform duration-200 group-hover:translate-x-0.5"
              >→</span
            >
          </div>
        </div>
      </a>
    </nav>
  </div>

  <!-- Center/Bottom Section: Informační karta + CTA a kontakt -->
  <div class="pt-6 space-y-4">
    <!-- 3. Informační prvek -->
    <div
      class="p-4 rounded-2xl bg-zinc-100 border border-zinc-200 flex items-center gap-3.5 text-zinc-800"
    >
      <span class="relative flex h-3 w-3 shrink-0">
        <span
          class="animate-ping absolute inline-flex h-full w-full rounded-full bg-zinc-400 opacity-75"
        ></span>
        <span class="relative inline-flex rounded-full h-3 w-3 bg-zinc-700"
        ></span>
      </span>
      <div class="flex flex-col">
        <span class="text-xs font-semibold text-zinc-900 leading-tight"
          >Expresní doručení po celé ČR</span
        >
        <span class="text-[11px] text-zinc-600 mt-0.5"
          >Osobní předvedení v salónech po Praze</span
        >
      </div>
    </div>

    <!-- 4. Spodní tlačítko v menu -->
    <div class="space-y-3 pt-2">
      <a
        href="#kontakt"
        class="mobile-nav-link flex items-center justify-center gap-2 w-full py-4 rounded-xl font-semibold bg-zinc-950 hover:bg-zinc-800 text-white shadow-md active:scale-98 transition-all duration-200 text-base"
      >
        <span>Objednat sadu Vochranka →</span>
      </a>

      <div
        class="flex items-center justify-center gap-1.5 text-xs text-zinc-500"
      >
        <span>Potřebujete poradit?</span>
        <a
          href="tel:+420777123456"
          class="text-zinc-900 hover:text-zinc-600 font-medium underline underline-offset-2"
        >
          +420 777 123 456
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  /* Default Hero state: full-width transparent navbar */
  #navbar-container {
    max-width: 1720px;
  }
  #navbar-pill {
    background-color: transparent;
    border: 1px solid transparent;
    box-shadow: none;
  }

  /* Scrolled past Hero: Centered floating pill with high-contrast background */
  :global(#main-navbar.is-scrolled) #navbar-container {
    max-width: 58rem;
  }

  :global(#main-navbar.is-scrolled) #navbar-pill {
    background-color: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(228, 228, 231, 0.85);
    box-shadow:
      0 10px 30px -10px rgba(0, 0, 0, 0.08),
      0 1px 3px rgba(0, 0, 0, 0.04);
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
    padding-left: 1.25rem;
    padding-right: 1.25rem;
  }

  @media (min-width: 768px) {
    :global(#main-navbar.is-scrolled) #navbar-pill {
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }
  }

  /* Text color adaptivity when scrolled past Hero */
  :global(#main-navbar.is-scrolled) .nav-text-color {
    color: #09090b !important;
  }
  :global(#main-navbar.is-scrolled) .nav-text-color span {
    color: #09090b !important;
  }
  :global(#main-navbar.is-scrolled) .nav-subtext-color {
    color: #71717a !important;
  }
  :global(#main-navbar.is-scrolled) .nav-link-color {
    color: #3f3f46 !important;
  }
  :global(#main-navbar.is-scrolled) .nav-link-color:hover {
    color: #09090b !important;
  }
  :global(#main-navbar.is-scrolled) .nav-underline {
    background-color: #09090b !important;
  }
  :global(#main-navbar.is-scrolled) .nav-icon-box {
    background-color: #f4f4f5 !important;
    border-color: #e4e4e7 !important;
    color: #09090b !important;
  }
  :global(#main-navbar.is-scrolled) .nav-burger-btn {
    background-color: #f4f4f5 !important;
    border-color: #e4e4e7 !important;
    color: #09090b !important;
  }
</style>

<script>
  const header = document.getElementById("main-navbar");
  const toggleBtn = document.getElementById("mobile-menu-toggle");
  const closeBtn = document.getElementById("mobile-menu-close");
  const mobileMenu = document.getElementById("mobile-menu");
  const mobileLinks = document.querySelectorAll(".mobile-nav-link");

  // Calculates when the hero section ends
  function getHeroThreshold() {
    const hero = document.querySelector("section");
    if (hero) {
      return Math.max(hero.offsetHeight - 120, 250);
    }
    return window.innerHeight * 0.85;
  }

  // Dynamic navbar pill transition after hero section
  function updateNavbar() {
    if (!header) return;
    const isPastHero = window.scrollY > getHeroThreshold();
    if (isPastHero) {
      header.classList.add("is-scrolled");
    } else {
      header.classList.remove("is-scrolled");
    }
  }

  window.addEventListener("scroll", updateNavbar, { passive: true });
  window.addEventListener("resize", updateNavbar, { passive: true });
  updateNavbar();

  // Mobile menu open / close
  function openMobileMenu() {
    if (!mobileMenu) return;
    mobileMenu.classList.remove(
      "opacity-0",
      "pointer-events-none",
      "-translate-y-4",
    );
    mobileMenu.classList.add(
      "opacity-100",
      "pointer-events-auto",
      "translate-y-0",
    );
    document.body.style.overflow = "hidden";
  }

  function closeMobileMenu() {
    if (!mobileMenu) return;
    mobileMenu.classList.remove(
      "opacity-100",
      "pointer-events-auto",
      "translate-y-0",
    );
    mobileMenu.classList.add(
      "opacity-0",
      "pointer-events-none",
      "-translate-y-4",
    );
    document.body.style.overflow = "";
  }

  toggleBtn?.addEventListener("click", openMobileMenu);
  closeBtn?.addEventListener("click", closeMobileMenu);

  mobileLinks.forEach((link) => {
    link.addEventListener("click", closeMobileMenu);
  });

  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      closeMobileMenu();
    }
  });
</script>
