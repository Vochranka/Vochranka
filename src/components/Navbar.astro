---
import { ShieldCheck, Menu, X, ArrowRight } from 'lucide-astro';
---

<header 
  id="main-navbar" 
  class="fixed top-0 left-0 right-0 z-50 w-full transition-all duration-300 bg-transparent border-b border-transparent py-2"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-18 sm:h-20">
      
      <!-- Brand / Logo with hover scaling & animation -->
      <a 
        href="#" 
        class="flex items-center gap-2.5 group focus:outline-none focus:ring-2 focus:ring-sage-400 rounded-lg p-1 transition-transform duration-300 hover:scale-105 active:scale-95"
      >
        <div class="w-10 h-10 rounded-xl bg-white/10 border border-white/20 flex items-center justify-center text-sage-300 shadow-soft-sm backdrop-blur-md group-hover:bg-sage-600 group-hover:text-white group-hover:scale-110 group-hover:shadow-glow-sage transition-all duration-300">
          <ShieldCheck class="w-5 h-5" />
        </div>
        <div class="flex flex-col">
          <span class="text-xl font-bold font-display tracking-tight text-white leading-none group-hover:text-sage-300 transition-colors duration-200">
            Vochránka<span class="text-sage-400">.</span>
          </span>
          <span class="text-[11px] font-medium tracking-wide text-stone-300 uppercase mt-0.5">
            Diskrétní bezpečí
          </span>
        </div>
      </a>

      <!-- Desktop Nav with hover scaling & animated underline -->
      <nav class="hidden md:flex items-center gap-8 text-[15px] font-medium">
        <a 
          href="#jak-to-funguje" 
          class="nav-link relative py-1 text-stone-200 hover:text-white transition-all duration-300 inline-block hover:scale-110 active:scale-95 group"
        >
          <span>Jak to funguje</span>
          <span class="absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-sage-400 rounded-full transition-all duration-300 group-hover:w-full"></span>
        </a>
        <a 
          href="#instalace" 
          class="nav-link relative py-1 text-stone-200 hover:text-white transition-all duration-300 inline-block hover:scale-110 active:scale-95 group"
        >
          <span>Instalace</span>
          <span class="absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-sage-400 rounded-full transition-all duration-300 group-hover:w-full"></span>
        </a>
        <a 
          href="#cenik" 
          class="nav-link relative py-1 text-stone-200 hover:text-white transition-all duration-300 inline-block hover:scale-110 active:scale-95 group"
        >
          <span>Ceník</span>
          <span class="absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-sage-400 rounded-full transition-all duration-300 group-hover:w-full"></span>
        </a>
        <a 
          href="#faq" 
          class="nav-link relative py-1 text-stone-200 hover:text-white transition-all duration-300 inline-block hover:scale-110 active:scale-95 group"
        >
          <span>FAQ</span>
          <span class="absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-sage-400 rounded-full transition-all duration-300 group-hover:w-full"></span>
        </a>
      </nav>

      <!-- Desktop CTA Button with hover scale & glow animation -->
      <div class="hidden md:flex items-center gap-4">
        <a 
          href="#objednavka" 
          class="inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-full text-sm font-semibold text-white bg-sage-600 hover:bg-sage-500 active:scale-95 shadow-glow-sage hover:shadow-soft-xl hover:scale-105 transition-all duration-300 group"
        >
          <span>Objednat sadu</span>
          <ArrowRight class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1 group-hover:scale-110" />
        </a>
      </div>

      <!-- Mobile Menu Button with hover scale -->
      <div class="flex items-center md:hidden gap-3">
        <a 
          href="#objednavka" 
          class="inline-flex items-center justify-center px-3.5 py-1.5 rounded-full text-xs font-semibold text-white bg-sage-600 hover:bg-sage-500 shadow-soft-sm hover:scale-105 active:scale-95 transition-all duration-200"
        >
          Objednat
        </a>
        <button 
          id="mobile-menu-toggle"
          type="button" 
          class="p-2 rounded-xl text-stone-200 hover:text-white hover:bg-white/10 hover:scale-110 active:scale-95 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-sage-400"
          aria-label="Otevřít menu"
        >
          <Menu class="w-6 h-6" id="menu-open-icon" />
          <X class="w-6 h-6 hidden" id="menu-close-icon" />
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-white/10 bg-anthracite-950/95 backdrop-blur-xl px-4 pt-3 pb-6 space-y-3">
    <a href="#jak-to-funguje" class="mobile-nav-link block px-3 py-2.5 rounded-xl text-base font-medium text-stone-200 hover:bg-white/10 hover:text-white hover:translate-x-2 transition-all duration-200">
      Jak to funguje
    </a>
    <a href="#instalace" class="mobile-nav-link block px-3 py-2.5 rounded-xl text-base font-medium text-stone-200 hover:bg-white/10 hover:text-white hover:translate-x-2 transition-all duration-200">
      Instalace za 2 minuty
    </a>
    <a href="#cenik" class="mobile-nav-link block px-3 py-2.5 rounded-xl text-base font-medium text-stone-200 hover:bg-white/10 hover:text-white hover:translate-x-2 transition-all duration-200">
      Ceník
    </a>
    <a href="#faq" class="mobile-nav-link block px-3 py-2.5 rounded-xl text-base font-medium text-stone-200 hover:bg-white/10 hover:text-white hover:translate-x-2 transition-all duration-200">
      Časté dotazy (FAQ)
    </a>
    <div class="pt-2">
      <a 
        href="#objednavka" 
        class="mobile-nav-link flex items-center justify-center gap-2 w-full px-4 py-3.5 rounded-xl text-sm font-semibold text-white bg-sage-600 hover:bg-sage-500 hover:scale-[1.02] active:scale-98 shadow-soft-sm transition-all"
      >
        <span>Objednat sadu Vochránka</span>
        <ArrowRight class="w-4 h-4" />
      </a>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('main-navbar');
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-open-icon');
  const closeIcon = document.getElementById('menu-close-icon');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  // Dynamic navbar background transition on scroll
  function updateNavbar() {
    if (!header) return;
    if (window.scrollY > 30) {
      header.classList.add('bg-anthracite-950/85', 'backdrop-blur-md', 'border-white/10', 'shadow-soft-lg', 'py-0');
      header.classList.remove('bg-transparent', 'border-transparent', 'py-2');
    } else {
      header.classList.remove('bg-anthracite-950/85', 'backdrop-blur-md', 'border-white/10', 'shadow-soft-lg', 'py-0');
      header.classList.add('bg-transparent', 'border-transparent', 'py-2');
    }
  }

  window.addEventListener('scroll', updateNavbar, { passive: true });
  updateNavbar();

  // Mobile menu toggle
  if (toggleBtn && mobileMenu && openIcon && closeIcon) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = !mobileMenu.classList.contains('hidden');
      if (isExpanded) {
        mobileMenu.classList.add('hidden');
        openIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      } else {
        mobileMenu.classList.remove('hidden');
        openIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
      }
    });

    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        openIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      });
    });
  }
</script>
