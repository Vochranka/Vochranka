---
import { ShieldCheck, Menu, X, ArrowRight } from "lucide-astro";
---

<header
  id="main-navbar"
  class="fixed top-0 left-0 right-0 z-50 w-full pointer-events-none transition-all duration-500 ease-out pt-3 sm:pt-4 px-4 sm:px-6 lg:px-8"
>
  <div
    id="navbar-container"
    class="mx-auto w-full transition-all duration-500 ease-out pointer-events-auto"
  >
    <div
      id="navbar-pill"
      class="relative flex items-center justify-between w-full transition-all duration-500 ease-out px-4 sm:px-6 py-2 sm:py-3 rounded-2xl md:rounded-full"
    >
      <!-- Brand / Logo (Left) with hover scaling & animation -->
      <a
        href="#"
        class="flex items-center gap-2.5 group focus:outline-none focus:ring-2 focus:ring-sage-400 rounded-lg p-1 transition-transform duration-300 hover:scale-105 active:scale-95 z-10 shrink-0"
      >
        <div
          class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-white/10 border border-white/20 flex items-center justify-center text-sage-300 shadow-soft-sm backdrop-blur-md group-hover:bg-sage-600 group-hover:text-white group-hover:scale-110 group-hover:shadow-glow-sage transition-all duration-300"
        >
          <ShieldCheck class="w-5 h-5" />
        </div>
        <div class="flex flex-col">
          <span
            class="text-lg sm:text-xl font-bold font-display tracking-tight text-white leading-none group-hover:text-sage-300 transition-colors duration-200"
          >
            Vochranka<span class="text-sage-400">.</span>
          </span>
          <span
            class="text-[10px] sm:text-[11px] font-medium tracking-wide text-stone-300 uppercase mt-0.5"
          >
            Diskrétní bezpečí
          </span>
        </div>
      </a>

      <!-- Desktop Nav (Exactly Centered) with animated underline -->
      <nav
        class="hidden md:flex items-center gap-6 lg:gap-8 text-[14px] lg:text-[15px] font-medium absolute left-1/2 -translate-x-1/2 z-10 whitespace-nowrap"
      >
        <a
          href="#jak-to-funguje"
          class="nav-link relative py-1 text-stone-200 hover:text-white transition-all duration-300 inline-block hover:scale-105 active:scale-95 group"
        >
          <span>Jak to funguje</span>
          <span
            class="absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-sage-400 rounded-full transition-all duration-300 group-hover:w-full"
          ></span>
        </a>
        <a
          href="#instalace"
          class="nav-link relative py-1 text-stone-200 hover:text-white transition-all duration-300 inline-block hover:scale-105 active:scale-95 group"
        >
          <span>Instalace</span>
          <span
            class="absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-sage-400 rounded-full transition-all duration-300 group-hover:w-full"
          ></span>
        </a>
        <a
          href="#cenik"
          class="nav-link relative py-1 text-stone-200 hover:text-white transition-all duration-300 inline-block hover:scale-105 active:scale-95 group"
        >
          <span>Ceník</span>
          <span
            class="absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-sage-400 rounded-full transition-all duration-300 group-hover:w-full"
          ></span>
        </a>
        <a
          href="#faq"
          class="nav-link relative py-1 text-stone-200 hover:text-white transition-all duration-300 inline-block hover:scale-105 active:scale-95 group"
        >
          <span>FAQ</span>
          <span
            class="absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-sage-400 rounded-full transition-all duration-300 group-hover:w-full"
          ></span>
        </a>
      </nav>

      <!-- Desktop CTA Button (Right) with hover scale & glow animation -->
      <div class="hidden md:flex items-center gap-3 z-10 shrink-0">
        <a
          href="#objednavka"
          class="inline-flex items-center justify-center gap-2 px-5 py-2 sm:px-6 sm:py-2.5 rounded-full text-xs sm:text-sm font-semibold text-white bg-sage-600 hover:bg-sage-500 active:scale-95 shadow-glow-sage hover:shadow-soft-xl hover:scale-105 transition-all duration-300 group whitespace-nowrap"
        >
          <span>Objednat sadu</span>
          <ArrowRight
            class="w-3.5 h-3.5 sm:w-4 sm:h-4 transition-transform duration-300 group-hover:translate-x-1 group-hover:scale-110"
          />
        </a>
      </div>

      <!-- Mobile Menu Button (Hamburger) -->
      <div class="flex items-center md:hidden z-10 shrink-0">
        <button
          id="mobile-menu-toggle"
          type="button"
          class="w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 flex items-center justify-center text-white shadow-soft-sm backdrop-blur-md active:scale-90 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-sage-400 cursor-pointer"
          aria-label="Otevřít menu"
        >
          <Menu class="w-5 h-5" />
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Mobile Fullscreen Overlay Navigation (Apple / Linear style) -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-[100] bg-zinc-950/95 backdrop-blur-2xl flex flex-col justify-between h-screen w-screen p-6 md:hidden opacity-0 pointer-events-none transition-all duration-300 -translate-y-4 overflow-y-auto"
>
  <!-- Top Section: Header + Navigation cards right below -->
  <div>
    <!-- 1. Top Bar: Logo (Left) + Close Button (Right) -->
    <div class="flex items-center justify-between w-full pb-4 border-b border-white/10">
      <a href="#" class="mobile-nav-link flex items-center gap-2.5">
        <div class="w-9 h-9 rounded-xl bg-white/10 border border-white/20 flex items-center justify-center text-emerald-400 shadow-soft-sm">
          <ShieldCheck class="w-5 h-5" />
        </div>
        <div class="flex flex-col">
          <span class="text-xl font-bold font-display tracking-tight text-white leading-none">
            Vochranka<span class="text-emerald-400">.</span>
          </span>
          <span class="text-[10px] font-medium tracking-wide text-zinc-400 uppercase mt-0.5">
            Diskrétní bezpečí
          </span>
        </div>
      </a>

      <button
        id="mobile-menu-close"
        type="button"
        class="w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 active:scale-90 border border-white/15 flex items-center justify-center text-zinc-300 hover:text-white transition-all duration-200 cursor-pointer"
        aria-label="Zavřít menu"
      >
        <X class="w-5 h-5" />
      </button>
    </div>

    <!-- 2. Navigation cards (Apple / Linear card style, positioned right below header with pt-8) -->
    <nav class="flex flex-col gap-2.5 pt-8">
      <a
        href="#jak-to-funguje"
        class="mobile-nav-link p-4 rounded-2xl bg-zinc-900/40 hover:bg-zinc-800/60 active:bg-zinc-800/80 border border-white/5 transition-all flex items-center justify-between group"
      >
        <div class="flex items-center gap-3.5">
          <span class="text-xs font-mono text-emerald-500/70">01</span>
          <span class="text-lg font-medium text-zinc-100 group-hover:text-white">Jak to funguje</span>
        </div>
        <div class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center text-zinc-400 group-hover:text-emerald-400 group-hover:bg-emerald-500/10 transition-all">
          <span class="text-sm font-light transition-transform duration-200 group-hover:translate-x-0.5">→</span>
        </div>
      </a>

      <a
        href="#instalace"
        class="mobile-nav-link p-4 rounded-2xl bg-zinc-900/40 hover:bg-zinc-800/60 active:bg-zinc-800/80 border border-white/5 transition-all flex items-center justify-between group"
      >
        <div class="flex items-center gap-3.5">
          <span class="text-xs font-mono text-emerald-500/70">02</span>
          <span class="text-lg font-medium text-zinc-100 group-hover:text-white">Instalace za 2 minuty</span>
        </div>
        <div class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center text-zinc-400 group-hover:text-emerald-400 group-hover:bg-emerald-500/10 transition-all">
          <span class="text-sm font-light transition-transform duration-200 group-hover:translate-x-0.5">→</span>
        </div>
      </a>

      <a
        href="#cenik"
        class="mobile-nav-link p-4 rounded-2xl bg-zinc-900/40 hover:bg-zinc-800/60 active:bg-zinc-800/80 border border-white/5 transition-all flex items-center justify-between group"
      >
        <div class="flex items-center gap-3.5">
          <span class="text-xs font-mono text-emerald-500/70">03</span>
          <span class="text-lg font-medium text-zinc-100 group-hover:text-white">Ceník a obsah sady</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-xs font-semibold text-emerald-400/90 bg-emerald-950/60 border border-emerald-500/30 px-2 py-0.5 rounded-full">2 990 Kč</span>
          <div class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center text-zinc-400 group-hover:text-emerald-400 group-hover:bg-emerald-500/10 transition-all">
            <span class="text-sm font-light transition-transform duration-200 group-hover:translate-x-0.5">→</span>
          </div>
        </div>
      </a>

      <a
        href="#faq"
        class="mobile-nav-link p-4 rounded-2xl bg-zinc-900/40 hover:bg-zinc-800/60 active:bg-zinc-800/80 border border-white/5 transition-all flex items-center justify-between group"
      >
        <div class="flex items-center gap-3.5">
          <span class="text-xs font-mono text-emerald-500/70">04</span>
          <span class="text-lg font-medium text-zinc-100 group-hover:text-white">Časté dotazy (FAQ)</span>
        </div>
        <div class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center text-zinc-400 group-hover:text-emerald-400 group-hover:bg-emerald-500/10 transition-all">
          <span class="text-sm font-light transition-transform duration-200 group-hover:translate-x-0.5">→</span>
        </div>
      </a>
    </nav>
  </div>

  <!-- Center/Bottom Section: Informační karta + CTA a kontakt -->
  <div class="pt-6 space-y-4">
    <!-- 3. Informační prvek (vyplnění hluchého místa) -->
    <div class="p-4 rounded-2xl bg-emerald-950/20 border border-emerald-500/20 flex items-center gap-3.5 shadow-soft-sm">
      <span class="relative flex h-3 w-3 shrink-0">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
      </span>
      <div class="flex flex-col">
        <span class="text-xs font-semibold text-zinc-100 leading-tight">Expresní doručení po Praze</span>
        <span class="text-[11px] text-zinc-400 mt-0.5">Možnost předvedení přímo ve vašem salónu</span>
      </div>
    </div>

    <!-- 4. Spodní CTA tlačítko s gradientem & kontakt -->
    <div class="space-y-3 pt-2">
      <a
        href="#objednavka"
        class="mobile-nav-link flex items-center justify-center gap-2 w-full py-4 rounded-2xl font-semibold bg-gradient-to-r from-emerald-500 to-emerald-600 hover:from-emerald-400 hover:to-emerald-500 text-white shadow-lg shadow-emerald-500/20 active:scale-98 transition-all duration-200 text-base"
      >
        <span>Objednat sadu Vochranka →</span>
      </a>

      <div class="flex items-center justify-center gap-1.5 text-xs text-zinc-400">
        <span>Potřebujete poradit?</span>
        <a href="tel:+420777123456" class="text-emerald-400 hover:text-emerald-300 font-medium underline underline-offset-2">
          +420 777 123 456
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  /* Default Hero state: full-width transparent navbar */
  #navbar-container {
    max-width: 1720px;
  }
  #navbar-pill {
    background-color: transparent;
    border: 1px solid transparent;
    box-shadow: none;
  }

  /* Scrolled past Hero: Centered floating pill with high-contrast background */
  :global(#main-navbar.is-scrolled) #navbar-container {
    max-width: 58rem;
  }

  :global(#main-navbar.is-scrolled) #navbar-pill {
    background-color: rgba(17, 19, 21, 0.88);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow:
      0 20px 35px -10px rgba(0, 0, 0, 0.35),
      0 0 0 1px rgba(255, 255, 255, 0.05);
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
    padding-left: 1.25rem;
    padding-right: 1.25rem;
  }

  @media (min-width: 768px) {
    :global(#main-navbar.is-scrolled) #navbar-pill {
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }
  }
</style>

<script>
  const header = document.getElementById("main-navbar");
  const toggleBtn = document.getElementById("mobile-menu-toggle");
  const closeBtn = document.getElementById("mobile-menu-close");
  const mobileMenu = document.getElementById("mobile-menu");
  const mobileLinks = document.querySelectorAll(".mobile-nav-link");

  // Calculates when the hero section ends
  function getHeroThreshold() {
    const hero = document.querySelector("section");
    if (hero) {
      return Math.max(hero.offsetHeight - 120, 250);
    }
    return window.innerHeight * 0.85;
  }

  // Dynamic navbar pill transition after hero section
  function updateNavbar() {
    if (!header) return;
    const isPastHero = window.scrollY > getHeroThreshold();
    if (isPastHero) {
      header.classList.add("is-scrolled");
    } else {
      header.classList.remove("is-scrolled");
    }
  }

  window.addEventListener("scroll", updateNavbar, { passive: true });
  window.addEventListener("resize", updateNavbar, { passive: true });
  updateNavbar();

  // Mobile menu open / close
  function openMobileMenu() {
    if (!mobileMenu) return;
    mobileMenu.classList.remove("opacity-0", "pointer-events-none", "-translate-y-4");
    mobileMenu.classList.add("opacity-100", "pointer-events-auto", "translate-y-0");
    document.body.style.overflow = "hidden";
  }

  function closeMobileMenu() {
    if (!mobileMenu) return;
    mobileMenu.classList.remove("opacity-100", "pointer-events-auto", "translate-y-0");
    mobileMenu.classList.add("opacity-0", "pointer-events-none", "-translate-y-4");
    document.body.style.overflow = "";
  }

  if (toggleBtn) {
    toggleBtn.addEventListener("click", openMobileMenu);
  }

  if (closeBtn) {
    closeBtn.addEventListener("click", closeMobileMenu);
  }

  mobileLinks.forEach((link) => {
    link.addEventListener("click", closeMobileMenu);
  });
</script>
