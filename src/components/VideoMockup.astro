---
import { Play, Volume2, ShieldCheck, CheckCircle2 } from 'lucide-astro';
---

<section id="video" class="py-16 md:py-24 relative overflow-hidden">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="max-w-2xl mx-auto text-center mb-12">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-sage-100 text-sage-900 text-xs font-semibold mb-4">
        <Play class="w-3.5 h-3.5 text-sage-700 fill-current" />
        <span>Video demonstrace</span>
      </div>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold font-display text-anthracite-950 tracking-tight mb-4">
        Podívejte se na reálnou reakci v praxi
      </h2>
      <p class="text-base text-anthracite-600 leading-relaxed">
        Jak vypadá stisk tlačítka během běžné procedury a jak rychle systém zalarmuje okolí i vaše nejbližší.
      </p>
    </div>

    <!-- Video Container Mockup -->
    <div class="relative mx-auto rounded-3xl overflow-hidden bg-anthracite-950 border border-stone-800 shadow-2xl">
      
      <!-- Video Aspect Ratio Frame -->
      <div class="relative aspect-video w-full flex items-center justify-center bg-black overflow-hidden group">
        
        <video 
          id="main-section-video"
          src="/vochranka-video.mp4" 
          controls 
          playsinline 
          preload="metadata"
          class="w-full h-full object-cover"
        >
          Váš prohlížeč nepodporuje přehrávání videa.
        </video>

      </div>

      <!-- Video Bottom Info Bar -->
      <div class="p-4 sm:p-5 bg-anthracite-900 border-t border-stone-800 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-stone-300">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span>Autentická video ukázka použití Vochranky v salónu</span>
        </div>
        <div class="flex items-center gap-4 text-stone-400">
          <span>Formát: 16:9 MP4</span>
          <span>•</span>
          <span>Délka: ukázka</span>
        </div>
      </div>

    </div>

  </div>
</section>
