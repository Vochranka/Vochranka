---
// src/components/Faq.astro
import { ChevronDown } from "lucide-astro";

const faqs = [
  {
    q: "Co když tlačítko zmáčknu omylem?",
    a: "Aby se alarm spustil, musíte tlačítko stisknout dvakrát rychle za sebou (dvojklik). Běžné zavadění stehnem nebo úklid prostěradla poplach nespustí. Pokud byste ho přesto omylem spustila, podržením na 3 sekundy sirénu ihned umlčíte.",
  },
  {
    q: "Potřebuji v salónu Wi-Fi připojení?",
    a: "Ne. Siréna má v sobě vlastní zabezpečenou mobilní IoT SIM kartu. Funguje všude, kde máte alespoň základní signál v telefonu. Nemusíte řešit Wi-Fi hesla majitele budovy ani výpadky internetu.",
  },
  {
    q: "Můžu mít více tlačítek k jedné siréně?",
    a: "Ano. K jedné siréně lze připojit až 5 tlačítek. Často si masérky berou jedno tlačítko pod lehátko a druhé do kapsy nebo na recepční stolek. Přídavné tlačítko stojí 690 Kč a můžete si ho rovnou navolit ve formuláři.",
  },
  {
    q: "Jak často se mění baterie a jak poznám, že dochází?",
    a: "V tlačítku je lithiová baterie CR2477 s výdrží až 5 let. Nemusíte na nic myslet – systém stav baterie hlídá a včas vám pošle SMS upozornění několik týdnů dopředu. Baterii pak sama vyměníte za minutu.",
  },
];
---

<section id="faq" class="py-20 md:py-28 relative overflow-hidden bg-white border-b border-zinc-200/80">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-xl mx-auto mb-14">
      <p class="text-xs font-mono uppercase tracking-widest text-zinc-400 mb-3">
        Časté dotazy
      </p>
      <h2
        class="text-3xl sm:text-4xl font-bold font-display text-zinc-950 tracking-tight"
      >
        Co vás nejčastěji zajímá
      </h2>
    </div>

    <!-- Accordion List -->
    <div class="space-y-3 max-w-3xl mx-auto" id="faq-accordion-container">
      {
        faqs.map((faq, index) => (
          <div class="faq-item rounded-2xl bg-zinc-50 border border-zinc-200/80 transition-all overflow-hidden">
            <button
              type="button"
              class="faq-button w-full px-6 py-4 sm:py-5 text-left flex items-center justify-between gap-4 focus:outline-none cursor-pointer"
              aria-expanded={index === 0 ? "true" : "false"}
              aria-controls={`faq-answer-${index}`}
            >
              <span class="text-base font-semibold text-zinc-950">
                {faq.q}
              </span>
              <div class="w-7 h-7 rounded-full bg-white border border-zinc-200 flex items-center justify-center shrink-0 faq-icon">
                <ChevronDown
                  class={`w-3.5 h-3.5 text-zinc-600 transition-transform duration-200 ${index === 0 ? "rotate-180" : ""}`}
                />
              </div>
            </button>

            <div
              id={`faq-answer-${index}`}
              class={`faq-answer px-6 pb-5 pt-1 text-sm text-zinc-600 leading-relaxed border-t border-zinc-200/60 ${index === 0 ? "block" : "hidden"}`}
            >
              {faq.a}
            </div>
          </div>
        ))
      }
    </div>

  </div>
</section>

<script>
  const faqButtons = document.querySelectorAll(".faq-button");

  faqButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const isExpanded = btn.getAttribute("aria-expanded") === "true";
      const answer = btn.nextElementSibling;
      const chevron = btn.querySelector(".faq-icon svg");

      // Close other answers for clean accordion UX
      faqButtons.forEach((otherBtn) => {
        if (otherBtn !== btn) {
          otherBtn.setAttribute("aria-expanded", "false");
          const otherAnswer = otherBtn.nextElementSibling;
          const otherChevron = otherBtn.querySelector(".faq-icon svg");
          if (otherAnswer) otherAnswer.classList.add("hidden");
          if (otherChevron) otherChevron.classList.remove("rotate-180");
        }
      });

      if (isExpanded) {
        btn.setAttribute("aria-expanded", "false");
        if (answer) answer.classList.add("hidden");
        if (chevron) chevron.classList.remove("rotate-180");
      } else {
        btn.setAttribute("aria-expanded", "true");
        if (answer) answer.classList.remove("hidden");
        if (chevron) chevron.classList.add("rotate-180");
      }
    });
  });
</script>
