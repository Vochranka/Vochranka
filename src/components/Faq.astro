---
const faqs = [
  {
    q: "Kolik to stojí?",
    a: "Nynější cena pro našich prvních 100 klientů je 2 990 Kč a první rok provozu je v ceně. Od druhého roku budete platit 999 Kč ročně.",
  },
  {
    q: "Můžu si systém vyzkoušet?",
    a: "Ano, máte možnost do 14 dnů zařízení nepoškozené vrátit. My vám obratem pošleme zaplacenou částku zpět.",
  },
  {
    q: "Co se stane po stisknutí tlačítka?",
    a: "Rozezní se hlasitá siréna a odešlou se nouzové SMS zprávy. Sirénu ztišíte dvojitým kliknutím.",
  },
  {
    q: "Potřebuju montáž?",
    a: "Ne. Sirénu a centrálu zasunete do zásuvky, spárují se samy a tlačítko přicvaknete.",
  },
];
---

<section
  id="faq"
  class="bg-white select-none py-16 sm:py-24 px-6 sm:px-[5.5%]"
  aria-label="Často kladené otázky"
>
  <div class="max-w-7xl mx-auto">
    <div class="text-center flex flex-col items-center">
      <h2
        class="text-4xl sm:text-6xl lg:text-[76px] font-bold text-ink tracking-tight mb-4 sm:mb-6"
      >
        Často kladené dotazy
      </h2>
      <p
        class="text-[15px] text-ink-muted max-w-[56ch] leading-relaxed mb-12 text-center"
      >
        Rychlé odpovědi na nejčastější dotazy. Máte jiný dotaz? <a
          href="#footer-kontakt"
          class="underline underline-offset-4 decoration-ink-muted hover:text-brown transition-colors"
          >Napište nám</a
        >
      </p>
    </div>

    <div class="border-b border-line">
      {
        faqs.map((faq) => (
          <details class="border-t border-line py-5 sm:py-6 group">
            <summary class="cursor-pointer list-none flex justify-between items-center text-xl sm:text-2xl lg:text-[32px] font-medium tracking-tight text-ink">
              <span>{faq.q}</span>
              <span class="text-2xl font-light text-ink select-none ml-4 transition-transform group-open:hidden">
                +
              </span>
              <span class="text-2xl font-light text-ink select-none ml-4 transition-transform hidden group-open:inline">
                –
              </span>
            </summary>
            <p class="mt-3.5 text-sm sm:text-[15px] text-ink-muted max-w-[60ch] leading-relaxed">
              {faq.a}
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>
