---
import { ChevronDown, CheckCircle2 } from "lucide-astro";

const faqs = [
  {
    q: "Co když tlačítko zmáčknu omylem?",
    a: "Tlačítko je navrženo tak, aby k nechtěnému sepnutí nedocházelo – aktivace alarmu vyžaduje vědomé podržení tlačítka, takže letmý dotyk či úklid poplach nespustí. Pokud by se to přesto stalo, sirénu lze ihned ztišit dvěma rychlými kliknutími přímo na tlačítku (případně vytažením ze zásuvky) a vašim nouzovým kontaktům můžete obratem zaslat zprávu, že šlo o omyl.",
  },
  {
    q: "Je v mém salónu potřeba Wi-Fi síť?",
    a: "Vůbec ne! Centrála Vochranka má integrovanou vlastní zabezpečenou mobilní IoT konektivitu. Funguje všude tam, kde máte v mobilu alespoň základní signál. Nemusíte znát Wi-Fi hesla pronajímatele, konfigurovat routery ani řešit výpadky internetu. Stačí zasunout do zásuvky 230V.",
  },
  {
    q: "Lze spárovat více tlačítek k jedné siréně?",
    a: "Ano. K jedné centrální siréně lze připojit až 5 nezávislých tlačítek. Běžná praxe je mít jedno tlačítko pod hlavním lehátkem, druhé pod recepčním stolkem a třetí v zázemí nebo koupelně. Každé tlačítko lze v nouzové SMS pojmenovat (např. „Lehátko 1“, „Recepce“). Přídavné tlačítko lze doobjednat za 590 Kč.",
  },
  {
    q: "Jaká je výdrž baterie v tlačítku a jak poznám, že dochází?",
    a: "V tlačítku je lithiová baterie typu CR2032, která díky nízkoenergetickému protokolu vydrží 2 až 3 roky nepřetržitého provozu. Nemusíte si psát upomínky do kalendáře – centrála stav baterie hlídá a při poklesu pod 15 % vám automaticky pošle SMS upozornění s dostatečným předstihem několika týdnů. Baterii pak vyměníte sama během 60 vteřin.",
  },
];
---

<section id="faq" class="py-24 sm:py-32 md:py-36 relative overflow-hidden bg-white min-h-[100svh] flex flex-col justify-center">
  <!-- Horní rohová světle žlutá záře navazující ze sekce Variabilita 
  <div
    class="absolute -top-20 -left-20 sm:-top-24 sm:-left-24 w-60 h-60 sm:w-72 sm:h-72 md:w-80 md:h-80 rounded-full bg-gradient-to-br from-amber-400/25 via-yellow-300/15 to-transparent blur-[60px] sm:blur-[70px] md:blur-[80px] pointer-events-none"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute -top-20 -right-20 sm:-top-24 sm:-right-24 w-60 h-60 sm:w-72 sm:h-72 md:w-80 md:h-80 rounded-full bg-gradient-to-bl from-amber-400/25 via-yellow-300/15 to-transparent blur-[60px] sm:blur-[70px] md:blur-[80px] pointer-events-none"
    aria-hidden="true"
  >
  </div>
  
 Spodní rohová zelená záře navazující do sekce Objednávka
  <div
  class="absolute -bottom-20 -left-20 sm:-bottom-24 sm:-left-24 w-60 h-60 sm:w-72 sm:h-72 md:w-80 md:h-80 rounded-full bg-gradient-to-tr from-emerald-400/25 via-emerald-300/10 to-transparent blur-[60px] sm:blur-[70px] md:blur-[80px] pointer-events-none"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute -bottom-20 -right-20 sm:-bottom-24 sm:-right-24 w-60 h-60 sm:w-72 sm:h-72 md:w-80 md:h-80 rounded-full bg-gradient-to-tl from-emerald-400/25 via-emerald-300/10 to-transparent blur-[60px] sm:blur-[70px] md:blur-[80px] pointer-events-none"
    aria-hidden="true"
  >
  </div>
-->

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header (Podle předlohy: velký čistý nadpis a decentní podtitul) -->
    <div class="text-center max-w-3xl mx-auto mb-16 sm:mb-20">
      <h2
        class="text-4xl sm:text-5xl md:text-6xl lg:text-[4.25rem] font-bold tracking-tight text-zinc-950 font-display leading-[1.08]"
      >
        Často kladené otázky
      </h2>
      <p class="text-base sm:text-lg md:text-xl text-zinc-500 mt-4 font-normal leading-relaxed">
        Rychlé odpovědi na nejčastější dotazy.
      </p>
    </div>

    <!-- Accordion List v minimalistickém stylu s fialovým "+" vlevo a jemnými dělícími linkami -->
    <div class="border-t border-zinc-200/90 divide-y divide-zinc-200/90" id="faq-accordion-container">
      {
        faqs.map((faq, index) => (
          <div class="faq-item group">
            <button
              type="button"
              class="faq-button w-full py-6 sm:py-7 text-left flex items-start gap-4 sm:gap-5 focus:outline-none cursor-pointer transition-colors duration-200 select-none"
              aria-expanded="false"
              aria-controls={`faq-answer-${index}`}
            >
              <!-- Fialový + symbol, který se při otevření plynule otočí do x -->
              <span
                class="faq-icon text-[#8b5cf6] text-2xl sm:text-3xl font-light leading-none select-none shrink-0 transition-transform duration-300 ease-out inline-block w-6 text-center"
                aria-hidden="true"
              >
                +
              </span>

              <!-- Text otázky -->
              <span class="text-lg sm:text-xl md:text-[1.35rem] font-semibold text-zinc-950 tracking-tight leading-snug group-hover:text-zinc-800 transition-colors">
                {faq.q}
              </span>
            </button>

            <!-- Hladce vysouvací kontejner s CSS grid animací -->
            <div
              id={`faq-answer-${index}`}
              class="faq-drawer grid grid-rows-[0fr] transition-[grid-template-rows] duration-350 ease-out"
            >
              <div class="overflow-hidden">
                <div class="faq-content opacity-0 -translate-y-1.5 transition-all duration-300 ease-out pb-7 pl-10 sm:pl-11 pr-2 sm:pr-8 text-base sm:text-lg text-zinc-500 leading-relaxed font-normal">
                  {faq.a}
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Spodní doplňující text -->
    <div class="mt-14 text-center">
      <p class="text-sm sm:text-base text-zinc-500">
        Máte jiný dotaz?{" "}
        <a
          href="#kontakt"
          class="text-zinc-950 font-semibold underline underline-offset-4 hover:text-zinc-700 transition-colors"
        >
          Napište nám
        </a>
      </p>
    </div>
  </div>
</section>

<script>
  const faqButtons = document.querySelectorAll(".faq-button");

  faqButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const isExpanded = btn.getAttribute("aria-expanded") === "true";
      const drawer = btn.nextElementSibling as HTMLElement | null;
      const content = drawer?.querySelector(".faq-content") as HTMLElement | null;
      const icon = btn.querySelector(".faq-icon") as HTMLElement | null;

      // Zavřít ostatní otevřené položky s plynulou animací
      faqButtons.forEach((otherBtn) => {
        if (otherBtn !== btn) {
          otherBtn.setAttribute("aria-expanded", "false");
          const otherDrawer = otherBtn.nextElementSibling as HTMLElement | null;
          const otherContent = otherDrawer?.querySelector(".faq-content") as HTMLElement | null;
          const otherIcon = otherBtn.querySelector(".faq-icon") as HTMLElement | null;

          if (otherDrawer) {
            otherDrawer.classList.remove("grid-rows-[1fr]");
            otherDrawer.classList.add("grid-rows-[0fr]");
          }
          if (otherContent) {
            otherContent.classList.remove("opacity-100", "translate-y-0");
            otherContent.classList.add("opacity-0", "-translate-y-1.5");
          }
          if (otherIcon) {
            otherIcon.classList.remove("rotate-45");
          }
        }
      });

      if (isExpanded) {
        btn.setAttribute("aria-expanded", "false");
        if (drawer) {
          drawer.classList.remove("grid-rows-[1fr]");
          drawer.classList.add("grid-rows-[0fr]");
        }
        if (content) {
          content.classList.remove("opacity-100", "translate-y-0");
          content.classList.add("opacity-0", "-translate-y-1.5");
        }
        if (icon) {
          icon.classList.remove("rotate-45");
        }
      } else {
        btn.setAttribute("aria-expanded", "true");
        if (drawer) {
          drawer.classList.remove("grid-rows-[0fr]");
          drawer.classList.add("grid-rows-[1fr]");
        }
        if (content) {
          content.classList.remove("opacity-0", "-translate-y-1.5");
          content.classList.add("opacity-100", "translate-y-0");
        }
        if (icon) {
          icon.classList.add("rotate-45");
        }
      }
    });
  });
</script>
