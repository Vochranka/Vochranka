---

---

<section
  id="kontakt"
  class="bg-white select-none pt-4 sm:pt-6 lg:pt-8 pb-16 sm:pb-24 px-6 sm:px-[5.5%]"
  aria-label="Kontakt"
>
  <div class="max-w-7xl mx-auto">
    <h2
      class="text-4xl sm:text-6xl lg:text-[76px] font-bold text-ink tracking-tight mb-4 sm:mb-6"
    >
      Mám zájem
    </h2>
    <p class="text-[15px] text-ink-muted max-w-[56ch] leading-relaxed mb-8 sm:mb-10">
      Zanechte nám na sebe kontakt. My se vám obratem ozveme a dokončíme spolu
      potřebnou konfiguraci před odesláním.
    </p>

    <form
      id="fm"
      class="grid grid-cols-1 md:grid-cols-2 gap-x-10 max-w-[900px]"
    >
      <label
        class="block border-b border-line py-3.5 sm:py-4 text-[13px] text-ink focus-within:border-brown transition-colors"
      >
        <span class="block text-ink-muted text-xs mb-1">Jméno</span>
        <input
          name="jmeno"
          required
          autocomplete="name"
          class="block w-full border-0 bg-transparent text-xl sm:text-2xl font-medium tracking-tight text-ink outline-none mt-1"
        />
      </label>

      <label
        class="block border-b border-line py-3.5 sm:py-4 text-[13px] text-ink focus-within:border-brown transition-colors"
      >
        <span class="block text-ink-muted text-xs mb-1"
          >E-mail nebo telefon</span
        >
        <input
          name="kontakt"
          required
          autocomplete="email"
          class="block w-full border-0 bg-transparent text-xl sm:text-2xl font-medium tracking-tight text-ink outline-none mt-1"
        />
      </label>

      <label
        class="block border-b border-line md:border-transparent py-3.5 sm:py-4 text-[13px] text-ink focus-within:border-brown transition-colors"
      >
        <span class="block text-ink-muted text-xs mb-1">Město</span>
        <input
          name="mesto"
          autocomplete="address-level2"
          class="block w-full border-0 bg-transparent text-xl sm:text-2xl font-medium tracking-tight text-ink outline-none mt-1"
        />
      </label>

      <div
        class="block border-b border-transparent py-3.5 sm:py-4 text-[13px] text-ink focus-within:border-brown transition-colors"
      >
        <label for="pocet-input" class="block text-ink-muted text-xs mb-1 cursor-pointer">
          Počet tlačítek
        </label>
        <div class="flex items-center justify-between mt-1">
          <input
            id="pocet-input"
            name="pocet"
            type="number"
            min="1"
            value="1"
            class="w-20 border-0 bg-transparent text-xl sm:text-2xl font-medium tracking-tight text-ink outline-none [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none"
          />
          <div class="flex items-center gap-2">
            <button
              id="pocet-minus"
              type="button"
              class="w-8 h-8 rounded-full border border-line flex items-center justify-center text-ink hover:bg-neutral-100 active:scale-90 transition-all cursor-pointer select-none text-base font-medium"
              aria-label="Snížit počet tlačítek"
            >
              –
            </button>
            <button
              id="pocet-plus"
              type="button"
              class="w-8 h-8 rounded-full bg-ink text-white flex items-center justify-center hover:bg-neutral-800 active:scale-90 transition-all cursor-pointer select-none text-base font-medium shadow-xs"
              aria-label="Zvýšit počet tlačítek"
            >
              +
            </button>
          </div>
        </div>
      </div>

      <div
        class="col-span-full pt-6 mt-2 flex items-center gap-4 sm:gap-6 text-[12px] sm:text-[13px]"
      >
        <button
          type="submit"
          class="inline-block rounded-full px-7 py-3.5 bg-ink text-white font-medium text-sm hover:opacity-85 active:scale-95 transition-all shadow-sm cursor-pointer shrink-0"
        >
          Odeslat
        </button>
        <span class="text-ink-muted max-w-[42ch] leading-snug">
          Nezávazně. Rádi vám vše předvedeme nebo zodpovíme dotazy!
        </span>
      </div>
    </form>

    <div id="ok" class="hidden py-8" role="status">
      <h3 class="text-3xl sm:text-5xl font-bold tracking-tight text-ink mb-2">
        Odesláno!
      </h3>
      <p class="text-base text-ink-muted">Děkujeme, brzy se vám ozveme.</p>
    </div>
  </div>
</section>

<script>
  function setupOrderForm() {
    const fm = document.getElementById("fm") as HTMLFormElement | null;
    const ok = document.getElementById("ok") as HTMLElement | null;
    const pocetInput = document.getElementById("pocet-input") as HTMLInputElement | null;
    const pocetPlus = document.getElementById("pocet-plus");
    const pocetMinus = document.getElementById("pocet-minus");

    if (!fm || !ok || fm.dataset.initialized) return;
    fm.dataset.initialized = "true";

    pocetPlus?.addEventListener("click", () => {
      if (!pocetInput) return;
      const val = parseInt(pocetInput.value, 10) || 1;
      pocetInput.value = String(val + 1);
    });

    pocetMinus?.addEventListener("click", () => {
      if (!pocetInput) return;
      const val = parseInt(pocetInput.value, 10) || 1;
      if (val > 1) {
        pocetInput.value = String(val - 1);
      }
    });

    fm.addEventListener("submit", (e) => {
      e.preventDefault();
      fm.classList.add("hidden");
      ok.classList.remove("hidden");
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupOrderForm);
  } else {
    setupOrderForm();
  }
  document.addEventListener("astro:page-load", setupOrderForm);
</script>
