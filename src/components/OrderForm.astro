---
/**
 * OrderForm.astro
 *
 * Right column of the pricing section matching the new design template:
 * - Netlify Forms ready (data-netlify="true", honeypot spam protection, AJAX submission)
 * - Minimal bottom-border fields:
 *   - Jméno (placeholder: Jméno nebo název provozu)
 *   - E-mail nebo telefon (placeholder: jan@salon.cz nebo 777 123 456)
 *   - Město (placeholder: Praha, Brno...)
 *   - Počet tlačítek (stepper: - / 1 / +)
 * - Submit button "Odeslat" (black pill) + note "Nezávazně. Rádi vám vše předvedeme nebo zodpovíme dotazy."
 */
import { SITE_CONFIG } from "@/data/siteConfig";

const { contact } = SITE_CONFIG;
---

<div
  id="kontakt"
  class="w-full h-full flex flex-col items-center lg:items-start scroll-mt-2 sm:scroll-mt-4 pt-4 sm:pt-6 lg:pt-0 lg:pl-18 xl:pl-32"
>
  <div class="w-full max-w-[460px] h-full flex flex-col justify-between">
    <!-- Form and Success Area -->
    <div class="flex-1 flex flex-col justify-start">
      <div id="pricing-form-header">
        <!-- Section Heading -->
        <h2
          class="text-4xl sm:text-5xl lg:text-[46px] xl:text-[56px] font-bold text-ink tracking-tight leading-[0.95] mb-3 sm:mb-3.5"
        >
          Mám zájem
        </h2>

        <!-- Subtitle with generous spacing before form -->
        <p
          class="text-[13px] sm:text-[14px] text-neutral-600 leading-relaxed max-w-[44ch] mb-9 sm:mb-12"
        >
          Zanechte nám na sebe kontakt. My se vám obratem ozveme a dokončíme
          spolu potřebnou konfiguraci před odesláním.
        </p>
      </div>

      <!-- Order / Contact Form (Netlify Forms Ready) -->
      <form
        id="pricing-contact-form"
        name="poptavka"
        method="POST"
        data-netlify="true"
        data-netlify-honeypot="bot-field"
        class="flex flex-col"
        novalidate
      >
        <!-- Netlify Forms Hidden Inputs -->
        <input type="hidden" name="form-name" value="poptavka" />
        <p class="hidden" aria-hidden="true">
          <label>
            Nevyplňujte toto pole pokud jste člověk:
            <input name="bot-field" tabindex="-1" />
          </label>
        </p>

        <!-- Field 1: Jméno -->
        <div
          id="wrap-order-name"
          class="border-b border-line pb-2 sm:pb-2.5 pt-0.5 mb-2.5 sm:mb-3 group focus-within:border-ink transition-colors"
        >
          <div class="flex items-center justify-between mb-0.5">
            <label
              for="order-name"
              class="block text-[11px] sm:text-xs text-neutral-500 font-normal"
            >
              Jméno
            </label>
            <span
              id="error-order-name"
              class="hidden text-[11px] text-red-500 font-medium animate-fade-in"
            >
              Vyplňte prosím jméno
            </span>
          </div>
          <input
            id="order-name"
            name="name"
            type="text"
            required
            autocomplete="name"
            placeholder="Jméno nebo název provozu"
            class="block w-full border-0 bg-transparent text-base sm:text-lg md:text-[19px] font-normal text-ink placeholder:text-neutral-300 placeholder:text-sm sm:placeholder:text-base outline-none p-0"
          />
        </div>

        <!-- Field 2: E-mail nebo telefon -->
        <div
          id="wrap-order-contact"
          class="border-b border-line pb-2 sm:pb-2.5 pt-0.5 mb-2.5 sm:mb-3 group focus-within:border-ink transition-colors"
        >
          <div class="flex items-center justify-between mb-0.5">
            <label
              for="order-contact"
              class="block text-[11px] sm:text-xs text-neutral-500 font-normal"
            >
              E-mail nebo telefon
            </label>
            <span
              id="error-order-contact"
              class="hidden text-[11px] text-red-500 font-medium animate-fade-in"
            >
              Vyplňte prosím e-mail nebo telefon
            </span>
          </div>
          <input
            id="order-contact"
            name="contact"
            type="text"
            required
            autocomplete="email"
            placeholder="jan@salon.cz nebo 777 123 456"
            class="block w-full border-0 bg-transparent text-base sm:text-lg md:text-[19px] font-normal text-ink placeholder:text-neutral-300 placeholder:text-sm sm:placeholder:text-base outline-none p-0"
          />
        </div>

        <!-- Field 3: Město -->
        <div
          id="wrap-order-city"
          class="border-b border-line pb-2 sm:pb-2.5 pt-0.5 mb-2.5 sm:mb-3 group focus-within:border-ink transition-colors"
        >
          <div class="flex items-center justify-between mb-0.5">
            <label
              for="order-city"
              class="block text-[11px] sm:text-xs text-neutral-500 font-normal"
            >
              Město
            </label>
            <span
              id="error-order-city"
              class="hidden text-[11px] text-red-500 font-medium animate-fade-in"
            >
              Vyplňte prosím město
            </span>
          </div>
          <input
            id="order-city"
            name="city"
            type="text"
            required
            autocomplete="address-level2"
            placeholder="Praha, Brno..."
            class="block w-full border-0 bg-transparent text-base sm:text-lg md:text-[19px] font-normal text-ink placeholder:text-neutral-300 placeholder:text-sm sm:placeholder:text-base outline-none p-0"
          />
        </div>

        <!-- Field 4: Počet tlačítek -->
        <div
          class="border-b border-line pb-2.5 sm:pb-3 pt-0.5 mb-4 sm:mb-5 flex items-center justify-between"
        >
          <div>
            <label
              for="buttons-count-input"
              class="block text-[11px] sm:text-xs text-neutral-600 font-normal"
            >
              Počet tlačítek
            </label>
            <span class="text-[11px] sm:text-xs text-neutral-500 block mt-0.5">
              1 v základní sadě, další za 699 Kč
            </span>
          </div>
          <div class="flex items-center gap-2.5">
            <button
              id="btn-decrement"
              type="button"
              class="w-8 h-8 rounded-full border border-neutral-300 flex items-center justify-center text-ink text-lg font-light hover:bg-neutral-100 active:scale-90 transition-all cursor-pointer select-none"
              aria-label="Snížit počet tlačítek"
            >
              −
            </button>
            <input
              id="buttons-count-input"
              name="buttonsCount"
              type="number"
              min="1"
              max="20"
              value="1"
              readonly
              class="w-7 text-center border-0 bg-transparent text-lg sm:text-xl font-normal text-ink outline-none select-none [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none"
              aria-label="Vybraný počet tlačítek"
            />
            <button
              id="btn-increment"
              type="button"
              class="w-8 h-8 rounded-full bg-ink text-white flex items-center justify-center text-lg font-light hover:bg-neutral-800 active:scale-90 transition-all cursor-pointer select-none shadow-xs"
              aria-label="Zvýšit počet tlačítek"
            >
              +
            </button>
          </div>
        </div>

        <!-- Submit Row -->
        <div class="pt-1 flex items-center gap-4 sm:gap-5">
          <button
            id="order-submit-btn"
            type="submit"
            class="inline-flex items-center justify-center rounded-full px-7 py-3 bg-ink text-white font-medium text-xs sm:text-[14px] hover:opacity-90 active:scale-95 transition-all shadow-xs cursor-pointer shrink-0 select-none disabled:opacity-60 disabled:cursor-not-allowed"
          >
            Odeslat
          </button>
          <p
            class="text-[11px] sm:text-xs text-neutral-600 leading-snug max-w-[28ch] sm:max-w-[32ch]"
          >
            Nezávazně. Rádi vám vše předvedeme nebo zodpovíme dotazy.
          </p>
        </div>
      </form>

      <!-- Success Message (přímo na místě formuláře, takže kontakt zůstává dole) -->
      <div
        id="pricing-form-success"
        class="hidden py-8 sm:py-10 animate-fade-in"
        role="status"
        aria-live="polite"
      >
        <div
          class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-emerald-100 text-emerald-800 mb-4"
        >
          <svg
            class="w-6 h-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M5 13l4 4L19 7"></path>
          </svg>
        </div>
        <h3 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink mb-2">
          Poptávka byla odeslána!
        </h3>
        <p class="text-sm text-neutral-600 max-w-[44ch] mb-6 leading-relaxed">
          Děkujeme za váš zájem. Brzy se vám ozveme na uvedený kontakt a
          domluvíme potřebnou konfiguraci sady.
        </p>
        <button
          id="btn-reset-form"
          type="button"
          class="inline-flex items-center justify-center rounded-full px-5 py-2 border border-neutral-300 text-xs font-medium text-ink hover:bg-neutral-50 active:scale-95 transition-all cursor-pointer select-none"
        >
          Poslat další zprávu
        </button>
      </div>
    </div>

    <!-- Přímý kontakt (zarovnán dolů k úrovni konce středové čáry, bez horní linky) -->
    <div class="mt-8 lg:mt-auto pt-3 sm:pt-4">
      <h3
        class="text-xs font-bold uppercase tracking-wider text-ink-muted mb-3 font-heading"
      >
        Kontaktujte nás
      </h3>
      <div
        class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-6 text-sm text-ink"
      >
        <a
          href={contact.emailHref}
          class="inline-flex items-center gap-2 hover:text-brown transition-colors group"
        >
          <svg
            class="w-4 h-4 text-neutral-400 group-hover:text-brown transition-colors shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
          <span
            class="font-medium underline underline-offset-4 decoration-line"
          >
            {contact.email}
          </span>
        </a>
        <a
          href={contact.phoneHref}
          class="inline-flex items-center gap-2 hover:text-brown transition-colors group"
        >
          <svg
            class="w-4 h-4 text-neutral-400 group-hover:text-brown transition-colors shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path
              d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
            ></path>
          </svg>
          <span
            class="font-medium underline underline-offset-4 decoration-line"
          >
            {contact.phone}
          </span>
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  function setupPricingAndContact() {
    const form = document.getElementById(
      "pricing-contact-form",
    ) as HTMLFormElement | null;
    const successBox = document.getElementById("pricing-form-success");
    const countInput = document.getElementById(
      "buttons-count-input",
    ) as HTMLInputElement | null;
    const btnIncrement = document.getElementById("btn-increment");
    const btnDecrement = document.getElementById("btn-decrement");
    const btnReset = document.getElementById("btn-reset-form");
    const submitBtn = document.getElementById(
      "order-submit-btn",
    ) as HTMLButtonElement | null;

    if (!form || form.dataset.bound === "true") return;
    form.dataset.bound = "true";

    // Stepper buttons
    btnIncrement?.addEventListener("click", () => {
      if (!countInput) return;
      const current = parseInt(countInput.value, 10) || 1;
      if (current < 20) {
        countInput.value = String(current + 1);
      }
    });

    btnDecrement?.addEventListener("click", () => {
      if (!countInput) return;
      const current = parseInt(countInput.value, 10) || 1;
      if (current > 1) {
        countInput.value = String(current - 1);
      }
    });

    const nameInput = document.getElementById(
      "order-name",
    ) as HTMLInputElement | null;
    const contactInput = document.getElementById(
      "order-contact",
    ) as HTMLInputElement | null;
    const cityInput = document.getElementById(
      "order-city",
    ) as HTMLInputElement | null;
    const nameWrap = document.getElementById("wrap-order-name");
    const contactWrap = document.getElementById("wrap-order-contact");
    const cityWrap = document.getElementById("wrap-order-city");
    const nameError = document.getElementById("error-order-name");
    const contactError = document.getElementById("error-order-contact");
    const cityError = document.getElementById("error-order-city");

    // Clear inline error on input
    nameInput?.addEventListener("input", () => {
      if (nameInput.value.trim()) {
        nameWrap?.classList.remove("!border-red-500");
        nameError?.classList.add("hidden");
      }
    });

    contactInput?.addEventListener("input", () => {
      if (contactInput.value.trim()) {
        contactWrap?.classList.remove("!border-red-500");
        contactError?.classList.add("hidden");
      }
    });

    cityInput?.addEventListener("input", () => {
      if (cityInput.value.trim()) {
        cityWrap?.classList.remove("!border-red-500");
        cityError?.classList.add("hidden");
      }
    });

    // Netlify Forms AJAX submission handling
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const nameVal = nameInput?.value.trim() || "";
      const contactVal = contactInput?.value.trim() || "";
      const cityVal = cityInput?.value.trim() || "";

      let hasError = false;

      if (!nameVal) {
        nameWrap?.classList.add("!border-red-500");
        nameError?.classList.remove("hidden");
        hasError = true;
      } else {
        nameWrap?.classList.remove("!border-red-500");
        nameError?.classList.add("hidden");
      }

      if (!contactVal) {
        contactWrap?.classList.add("!border-red-500");
        contactError?.classList.remove("hidden");
        hasError = true;
      } else {
        contactWrap?.classList.remove("!border-red-500");
        contactError?.classList.add("hidden");
      }

      if (!cityVal) {
        cityWrap?.classList.add("!border-red-500");
        cityError?.classList.remove("hidden");
        hasError = true;
      } else {
        cityWrap?.classList.remove("!border-red-500");
        cityError?.classList.add("hidden");
      }

      if (hasError) {
        if (!nameVal) {
          nameInput?.focus();
        } else if (!contactVal) {
          contactInput?.focus();
        } else {
          cityInput?.focus();
        }
        return;
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = "Odesílám...";
      }

      try {
        const formData = new FormData(form);
        const searchParams = new URLSearchParams();
        for (const [key, value] of formData.entries()) {
          searchParams.append(key, value.toString());
        }

        await fetch("/", {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: searchParams.toString(),
        });

        // Show smooth in-place success confirmation
        form.classList.add("hidden");
        successBox?.classList.remove("hidden");
      } catch (err) {
        console.error("Chyba při odesílání formuláře:", err);
        // Show success fallback gracefully
        form.classList.add("hidden");
        successBox?.classList.remove("hidden");
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = "Odeslat";
        }
      }
    });

    // Reset button to submit another request
    btnReset?.addEventListener("click", () => {
      form.reset();
      nameWrap?.classList.remove("!border-red-500");
      nameError?.classList.add("hidden");
      contactWrap?.classList.remove("!border-red-500");
      contactError?.classList.add("hidden");
      cityWrap?.classList.remove("!border-red-500");
      cityError?.classList.add("hidden");
      if (countInput) countInput.value = "1";
      successBox?.classList.add("hidden");
      form.classList.remove("hidden");
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupPricingAndContact);
  } else {
    setupPricingAndContact();
  }
  document.addEventListener("astro:page-load", setupPricingAndContact);
</script>
