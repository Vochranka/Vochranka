---
import { Check, Plus, Minus } from "lucide-astro";
import { SITE_CONFIG } from "@/data/siteConfig";

const { pricing } = SITE_CONFIG;
---

<section id="kontakt" class="py-20 sm:py-28 lg:py-32 px-6 sm:px-12 lg:px-20 bg-white select-none">
  <div class="max-w-[1260px] mx-auto text-left">
    
    <!-- Heading -->
    <div class="mb-14 sm:mb-16">
      <h2 class="font-sans font-bold text-6xl sm:text-8xl lg:text-[100px] text-[#2B2523] tracking-[-0.05em] leading-none mb-4">
        Mám zájem
      </h2>
      <p class="font-mono text-xs sm:text-[13px] text-[#2B2523] max-w-xl font-normal leading-[1.5]">
        Zanechte nám na sebe kontakt. My se vám obratem ozveme a dokončíme spolu potřebnou konfiguraci před odesláním.
      </p>
    </div>

    <!-- Form: 2-column grid matching Figma node 7:7 -->
    <form
      id="contact-order-form"
      class="space-y-8"
      data-base-price={pricing.basePrice}
      data-extra-price={pricing.extraButtonPrice}
    >
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-14">
        <!-- Sloupec 1 -->
        <div class="space-y-6">
          <!-- Jméno -->
          <div class="border-b border-[#CFCFCF] pb-3">
            <label for="order-name" class="block font-mono text-[10px] text-[#6B6560] mb-2 uppercase">
              Jméno
            </label>
            <input
              type="text"
              id="order-name"
              name="name"
              placeholder=""
              autocomplete="name"
              required
              class="w-full bg-transparent text-sm sm:text-base text-[#2B2523] font-medium focus:outline-none"
            />
          </div>

          <!-- Město -->
          <div class="border-b border-[#CFCFCF] pb-3">
            <label for="order-city" class="block font-mono text-[10px] text-[#6B6560] mb-2 uppercase">
              Město
            </label>
            <input
              type="text"
              id="order-city"
              name="city"
              placeholder=""
              autocomplete="address-level2"
              required
              class="w-full bg-transparent text-sm sm:text-base text-[#2B2523] font-medium focus:outline-none"
            />
          </div>
        </div>

        <!-- Sloupec 2 -->
        <div class="space-y-6">
          <!-- E-mail nebo telefon -->
          <div class="border-b border-[#CFCFCF] pb-3">
            <label for="order-contact" class="block font-mono text-[10px] text-[#6B6560] mb-2 uppercase">
              E-mail nebo telefon
            </label>
            <input
              type="text"
              id="order-contact"
              name="contact"
              placeholder=""
              autocomplete="email"
              required
              class="w-full bg-transparent text-sm sm:text-base text-[#2B2523] font-medium focus:outline-none"
            />
          </div>

          <!-- Počet tlačítek Counter -->
          <div class="border-b border-[#CFCFCF] pb-3 flex items-center justify-between">
            <div>
              <label class="block font-mono text-[10px] text-[#6B6560] mb-1 uppercase">
                Počet tlačítek
              </label>
              <span id="order-count" class="font-sans font-normal text-lg text-[#2B2523]" aria-live="polite">1</span>
            </div>

            <div class="flex items-center gap-2">
              <button
                type="button"
                id="order-btn-dec"
                disabled
                class="w-7 h-7 rounded-full bg-black/5 hover:bg-black/10 flex items-center justify-center text-[#2B2523] cursor-pointer active:scale-90 transition-all disabled:opacity-30 disabled:cursor-not-allowed focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-black"
                aria-label="Odebrat tlačítko"
              >
                <Minus class="w-3 h-3" />
              </button>
              <button
                type="button"
                id="order-btn-inc"
                class="w-7 h-7 rounded-full bg-black/5 hover:bg-black/10 flex items-center justify-center text-[#2B2523] cursor-pointer active:scale-90 transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-black"
                aria-label="Přidat tlačítko"
              >
                <Plus class="w-3 h-3" />
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Action & disclaimer matching Figma node 7:19 -->
      <div class="pt-6 flex flex-col sm:flex-row items-start sm:items-center gap-6">
        <button
          type="submit"
          id="order-submit-btn"
          class="inline-flex items-center justify-center px-7 py-2.5 rounded-full text-sm font-medium text-white bg-[#2B2523] hover:bg-black active:scale-95 transition-all shadow-sm"
        >
          <span>Odeslat</span>
        </button>
        <span class="font-mono text-[11px] text-[#6B6560] leading-tight">
          Nezávazně. Rádi vám vše předvedeme nebo zodpovíme dotazy.
        </span>
      </div>
    </form>

    <!-- Success Feedback State -->
    <div
      id="order-success-state"
      class="hidden max-w-xl py-8 text-left animate-fade-in"
      role="alert"
    >
      <div class="w-12 h-12 rounded-full bg-emerald-100 text-emerald-800 flex items-center justify-center mb-4">
        <Check class="w-6 h-6 stroke-[3]" />
      </div>
      <h3 class="font-sans font-bold text-2xl sm:text-3xl text-[#2B2523] mb-2">
        Děkujeme za poptávku!
      </h3>
      <p class="font-mono text-xs text-[#6B6560] leading-relaxed mb-6">
        Vaši zprávu jsme v pořádku přijali. Během několika hodin vás budeme kontaktovat a domluvíme podrobnosti.
      </p>
      <button
        type="button"
        id="order-reset-btn"
        class="px-5 py-2 rounded-full text-xs font-bold text-[#2B2523] bg-black/5 hover:bg-black/10 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-black"
      >
        Odeslat další poptávku
      </button>
    </div>

  </div>
</section>

<script>
  function setupOrderForm() {
    const form = document.getElementById("contact-order-form") as HTMLFormElement | null;
    if (!form || form.dataset.initialized) return;
    form.dataset.initialized = "true";

    let count = 1;
    const decBtn = document.getElementById("order-btn-dec") as HTMLButtonElement | null;
    const incBtn = document.getElementById("order-btn-inc") as HTMLButtonElement | null;
    const countDisplay = document.getElementById("order-count");
    const success = document.getElementById("order-success-state");
    const submitBtn = document.getElementById("order-submit-btn");
    const resetBtn = document.getElementById("order-reset-btn");

    const update = () => {
      if (countDisplay) countDisplay.textContent = String(count);
      if (decBtn) decBtn.disabled = count <= 1;
    };

    incBtn?.addEventListener("click", () => {
      if (count < 8) {
        count++;
        update();
      }
    });

    decBtn?.addEventListener("click", () => {
      if (count > 1) {
        count--;
        update();
      }
    });

    if (form && success) {
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        if (submitBtn) {
          submitBtn.setAttribute("disabled", "true");
          submitBtn.textContent = "Odesílám...";
        }

        setTimeout(() => {
          form.classList.add("hidden");
          success.classList.remove("hidden");
        }, 500);
      });
    }

    if (resetBtn && form && success) {
      resetBtn.addEventListener("click", () => {
        form.reset();
        count = 1;
        update();
        form.classList.remove("hidden");
        success.classList.add("hidden");
        if (submitBtn) {
          submitBtn.removeAttribute("disabled");
          submitBtn.textContent = "Odeslat poptávku";
        }
      });
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupOrderForm);
  } else {
    setupOrderForm();
  }
  document.addEventListener("astro:page-load", setupOrderForm);
</script>

