---
/**
 * OrderForm.astro
 * 
 * Component for the "Mám zájem" order & contact form (Right column of Frame #5:2).
 * Positioned more to the right with lg:items-end.
 */

import { SITE_CONFIG } from "@/data/siteConfig";

const { contactSubtitle } = SITE_CONFIG;
---

<div
  id="kontakt"
  class="w-full flex flex-col items-start scroll-mt-24 pt-10 lg:pt-0 lg:pl-8 xl:pl-14"
>
  <div class="w-full max-w-[480px]">
    <h2
      class="text-4xl sm:text-5xl lg:text-[68px] xl:text-[76px] font-normal text-ink tracking-tight leading-[0.95] mb-4 sm:mb-6"
    >
      Mám zájem
    </h2>
    <p
      class="text-[15px] text-ink-muted leading-relaxed mb-8 sm:mb-10"
    >
      {contactSubtitle}
    </p>

    <!-- Order / Contact Form -->
    <form
      id="pricing-contact-form"
      class="flex flex-col border-t border-line"
      novalidate
    >
      <!-- Field 1: Jméno -->
      <div
        class="border-b border-line py-3.5 sm:py-4 group focus-within:border-ink transition-colors"
      >
        <label
          for="order-name"
          class="block text-[13px] text-ink-muted mb-1 group-focus-within:text-ink transition-colors"
        >
          Jméno
        </label>
        <input
          id="order-name"
          name="name"
          type="text"
          required
          autocomplete="name"
          placeholder="Vaše jméno nebo název provozu"
          class="block w-full border-0 bg-transparent text-xl sm:text-2xl font-medium tracking-tight text-ink placeholder:text-neutral-400 outline-none"
        />
      </div>

      <!-- Field 2: E-mail nebo telefon -->
      <div
        class="border-b border-line py-3.5 sm:py-4 group focus-within:border-ink transition-colors"
      >
        <label
          for="order-contact"
          class="block text-[13px] text-ink-muted mb-1 group-focus-within:text-ink transition-colors"
        >
          E-mail nebo telefon
        </label>
        <input
          id="order-contact"
          name="contact"
          type="text"
          required
          autocomplete="email"
          placeholder="např. jan@salon.cz nebo 777 123 456"
          class="block w-full border-0 bg-transparent text-xl sm:text-2xl font-medium tracking-tight text-ink placeholder:text-neutral-400 outline-none"
        />
      </div>

      <!-- Field 3: Město -->
      <div
        class="border-b border-line py-3.5 sm:py-4 group focus-within:border-ink transition-colors"
      >
        <label
          for="order-city"
          class="block text-[13px] text-ink-muted mb-1 group-focus-within:text-ink transition-colors"
        >
          Město
        </label>
        <input
          id="order-city"
          name="city"
          type="text"
          autocomplete="address-level2"
          placeholder="např. Praha, Brno..."
          class="block w-full border-0 bg-transparent text-xl sm:text-2xl font-medium tracking-tight text-ink placeholder:text-neutral-400 outline-none"
        />
      </div>

      <!-- Field 4: Počet tlačítek -->
      <div class="border-b border-line py-3.5 sm:py-4 flex items-center justify-between">
        <div>
          <label
            for="buttons-count-input"
            class="block text-[13px] text-ink-muted mb-0.5 cursor-pointer"
          >
            Počet tlačítek
          </label>
          <span class="text-xs text-ink-muted block">
            1 v základní sadě, další za 699 Kč
          </span>
        </div>
        <div class="flex items-center gap-3">
          <button
            id="btn-decrement"
            type="button"
            class="w-9 h-9 rounded-full border border-line flex items-center justify-center text-ink hover:bg-neutral-100 active:scale-90 transition-all cursor-pointer text-lg font-medium select-none"
            aria-label="Snížit počet tlačítek"
          >
            −
          </button>
          <input
            id="buttons-count-input"
            name="buttonsCount"
            type="number"
            min="1"
            max="20"
            value="1"
            readonly
            class="w-12 text-center border-0 bg-transparent text-2xl font-medium text-ink outline-none select-none [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none"
            aria-label="Vybraný počet tlačítek"
          />
          <button
            id="btn-increment"
            type="button"
            class="w-9 h-9 rounded-full bg-ink text-white flex items-center justify-center hover:bg-neutral-800 active:scale-90 transition-all cursor-pointer text-lg font-medium select-none shadow-xs"
            aria-label="Zvýšit počet tlačítek"
          >
            +
          </button>
        </div>
      </div>

      <!-- Submit Row -->
      <div
        class="pt-7 sm:pt-8 flex flex-col sm:flex-row items-start sm:items-center gap-4 sm:gap-6"
      >
        <button
          type="submit"
          class="inline-flex items-center justify-center rounded-full px-8 py-3.5 bg-ink text-white font-medium text-sm hover:opacity-85 active:scale-95 transition-all shadow-sm cursor-pointer shrink-0 select-none"
        >
          Odeslat
        </button>
        <p
          class="text-[13px] text-ink-muted leading-relaxed max-w-[40ch]"
        >
          Nezávazně. Rádi vám vše předvedeme nebo zodpovíme dotazy.
        </p>
      </div>
    </form>

    <!-- Success Message -->
    <div
      id="pricing-form-success"
      class="hidden py-12 animate-fade-in"
      role="status"
      aria-live="polite"
    >
      <div
        class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-emerald-100 text-emerald-800 mb-4"
      >
        <svg
          class="w-6 h-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M5 13l4 4L19 7"></path>
        </svg>
      </div>
      <h3 class="text-2xl sm:text-4xl font-bold tracking-tight text-ink mb-2">
        Poptávka byla odeslána!
      </h3>
      <p class="text-sm text-ink-muted max-w-[44ch] mb-6">
        Děkujeme za váš zájem. Brzy se vám ozveme na uvedený kontakt a domluvíme
        konfiguraci sady.
      </p>
      <button
        id="btn-reset-form"
        type="button"
        class="text-xs underline text-ink-muted hover:text-ink cursor-pointer select-none"
      >
        Poslat další zprávu
      </button>
    </div>
  </div>
</div>

<script>
  function setupPricingAndContact() {
    const form = document.getElementById("pricing-contact-form") as HTMLFormElement | null;
    const successBox = document.getElementById("pricing-form-success");
    const countInput = document.getElementById("buttons-count-input") as HTMLInputElement | null;
    const btnIncrement = document.getElementById("btn-increment");
    const btnDecrement = document.getElementById("btn-decrement");
    const btnReset = document.getElementById("btn-reset-form");
    const nameInput = document.getElementById("order-name") as HTMLInputElement | null;
    const contactCtaButtons = document.querySelectorAll<HTMLButtonElement>('[data-action="focus-contact"]');

    if (!form || form.dataset.bound === "true") return;
    form.dataset.bound = "true";

    // Stepper buttons
    btnIncrement?.addEventListener("click", () => {
      if (!countInput) return;
      const current = parseInt(countInput.value, 10) || 1;
      if (current < 20) {
        countInput.value = String(current + 1);
      }
    });

    btnDecrement?.addEventListener("click", () => {
      if (!countInput) return;
      const current = parseInt(countInput.value, 10) || 1;
      if (current > 1) {
        countInput.value = String(current - 1);
      }
    });

    // "Mám zájem" button in pricing card scrolls and focuses contact form
    contactCtaButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const contactSection = document.getElementById("kontakt");
        if (contactSection) {
          contactSection.scrollIntoView({ behavior: "smooth", block: "start" });
        }
        setTimeout(() => {
          nameInput?.focus();
        }, 400);
      });
    });

    // Form submission handling
    form.addEventListener("submit", (e) => {
      e.preventDefault();

      const nameVal = (document.getElementById("order-name") as HTMLInputElement)?.value.trim();
      const contactVal = (document.getElementById("order-contact") as HTMLInputElement)?.value.trim();

      if (!nameVal || !contactVal) {
        alert("Prosím vyplňte jméno a e-mail nebo telefon.");
        return;
      }

      form.classList.add("hidden");
      successBox?.classList.remove("hidden");
    });

    // Reset button to submit another request
    btnReset?.addEventListener("click", () => {
      form.reset();
      if (countInput) countInput.value = "1";
      successBox?.classList.add("hidden");
      form.classList.remove("hidden");
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupPricingAndContact);
  } else {
    setupPricingAndContact();
  }
  document.addEventListener("astro:page-load", setupPricingAndContact);
</script>
