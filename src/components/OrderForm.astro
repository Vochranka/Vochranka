---
import {
  Send,
  ShieldCheck,
  CheckCircle2,
  Lock,
  Sparkles,
  MessageCircleQuestion,
} from "lucide-astro";
---

<section
  id="objednavka"
  class="py-16 md:py-24 bg-zinc-50 border-t border-zinc-200/80 relative scroll-mt-10"
>
  <div id="objednat" class="absolute -top-16 left-0"></div>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-xl mx-auto mb-10">
      <div
        class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-100 text-zinc-900 text-xs font-semibold mb-4 border border-zinc-200"
      >
        <Sparkles class="w-3.5 h-3.5 text-zinc-800" />
        <span>Rychlá a nezávazná objednávka</span>
      </div>
      <h2
        class="text-2xl sm:text-3xl md:text-4xl font-bold font-display text-zinc-950 tracking-tight mb-3"
      >
        Získejte bezpečí pro svůj salón
      </h2>
      <p class="text-sm sm:text-base text-zinc-600 leading-relaxed">
        Vyplňte krátký formulář. Neplatíte nic předem – ozveme se vám pro
        potvrzení adresy a domluvíme doručení nebo osobní vyzkoušení.
      </p>
    </div>

    <!-- Form Container -->
    <div
      class="rounded-3xl bg-white p-6 sm:p-10 border border-zinc-200 shadow-xl relative"
    >
      <!-- Live Feedback Alert (hidden by default) -->
      <div id="form-success-state" class="hidden text-center py-10">
        <div
          class="w-16 h-16 rounded-full bg-zinc-100 text-zinc-950 flex items-center justify-center mx-auto mb-5 border border-zinc-200"
        >
          <CheckCircle2 class="w-9 h-9 text-zinc-950" />
        </div>
        <h3 class="text-2xl font-bold font-display text-zinc-950 mb-2">
          Děkujeme za vaši zprávu!
        </h3>
        <p
          class="text-sm sm:text-base text-zinc-600 max-w-md mx-auto mb-6 leading-relaxed"
        >
          Vaši poptávku jsme v pořádku přijali. Ozveme se vám do 2 hodin (v
          pracovní dny) na uvedený telefon nebo e-mail pro doladění detailů a
          diskrétní odeslání.
        </p>
        <button
          id="form-reset-btn"
          type="button"
          class="inline-flex items-center justify-center px-6 py-2.5 rounded-xl text-xs font-semibold text-zinc-900 bg-zinc-100 hover:bg-zinc-200 border border-zinc-200 transition-colors"
        >
          Zadat další požadavek
        </button>
      </div>

      <!-- Actual Form -->
      <form id="order-inquiry-form" class="space-y-6">
        <!-- Choice Segment: Order vs Inquiry -->
        <div>
          <label
            class="block text-xs font-bold uppercase tracking-wider text-zinc-800 mb-3"
          >
            Zvolte typ požadavku *
          </label>
          <div
            class="grid grid-cols-1 sm:grid-cols-2 gap-3"
            id="intent-options"
          >
            <label
              class="intent-card relative flex items-start gap-3 p-4 rounded-2xl border-2 border-zinc-950 bg-zinc-50 cursor-pointer transition-all"
            >
              <input
                type="radio"
                name="intent"
                value="order"
                checked
                class="mt-1 text-zinc-950 focus:ring-zinc-400"
              />
              <div class="text-left">
                <span class="block text-sm font-bold text-zinc-950"
                  >Chci rovnou objednat sadu</span
                >
                <span class="block text-xs text-zinc-800 font-semibold mt-0.5"
                  >2 990 Kč (vč. 14denní záruky)</span
                >
              </div>
            </label>

            <label
              class="intent-card relative flex items-start gap-3 p-4 rounded-2xl border border-zinc-200 bg-white hover:bg-zinc-50 cursor-pointer transition-all"
            >
              <input
                type="radio"
                name="intent"
                value="question_or_trial"
                class="mt-1 text-zinc-950 focus:ring-zinc-400"
              />
              <div class="text-left">
                <span class="block text-sm font-bold text-zinc-950"
                  >Chci se zeptat / vyzkoušet v Praze</span
                >
                <span class="block text-xs text-zinc-500 mt-0.5"
                  >Nezávazné předvedení v salónu</span
                >
              </div>
            </label>
          </div>
        </div>

        <!-- Name & Salon Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label
              for="name"
              class="block text-xs font-semibold text-zinc-800 mb-1.5"
            >
              Vaše jméno a příjmení *
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="Např. Kateřina Nováková"
              class="w-full px-4 py-3 rounded-xl border border-zinc-300 focus:border-zinc-950 focus:ring-2 focus:ring-zinc-200 outline-none text-sm text-zinc-900 bg-white transition-all"
            />
          </div>

          <div>
            <label
              for="salon"
              class="block text-xs font-semibold text-zinc-800 mb-1.5"
            >
              Název salónu / studia *
            </label>
            <input
              type="text"
              id="salon"
              name="salon"
              required
              placeholder="Např. Masáže Harmonie, Kosmetika Luna"
              class="w-full px-4 py-3 rounded-xl border border-zinc-300 focus:border-zinc-950 focus:ring-2 focus:ring-zinc-200 outline-none text-sm text-zinc-900 bg-white transition-all"
            />
          </div>
        </div>

        <!-- Phone & Email Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label
              for="phone"
              class="block text-xs font-semibold text-zinc-800 mb-1.5"
            >
              Telefonní číslo (pro SMS/WhatsApp) *
            </label>
            <input
              type="tel"
              id="phone"
              name="phone"
              required
              placeholder="+420 777 123 456"
              class="w-full px-4 py-3 rounded-xl border border-zinc-300 focus:border-zinc-950 focus:ring-2 focus:ring-zinc-200 outline-none text-sm text-zinc-900 bg-white transition-all"
            />
          </div>

          <div>
            <label
              for="email"
              class="block text-xs font-semibold text-zinc-800 mb-1.5"
            >
              E-mailová adresa *
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="katerina@masaze-harmonie.cz"
              class="w-full px-4 py-3 rounded-xl border border-zinc-300 focus:border-zinc-950 focus:ring-2 focus:ring-zinc-200 outline-none text-sm text-zinc-900 bg-white transition-all"
            />
          </div>
        </div>

        <!-- Note / Address -->
        <div>
          <label
            for="note"
            class="block text-xs font-semibold text-zinc-800 mb-1.5"
          >
            Doručovací adresa nebo vaše poznámka / dotaz
          </label>
          <textarea
            id="note"
            name="note"
            rows="3"
            placeholder="Pokud si přejete sadu poslat, uveďte adresu salónu či Zásilkovnu. Pokud máte dotaz, napište jej sem..."
            class="w-full px-4 py-3 rounded-xl border border-zinc-300 focus:border-zinc-950 focus:ring-2 focus:ring-zinc-200 outline-none text-sm text-zinc-900 bg-white transition-all resize-none"
          ></textarea>
        </div>

        <!-- Privacy & Packaging Reassurance -->
        <div
          class="p-4 rounded-2xl bg-zinc-50 border border-zinc-200 flex items-start gap-3"
        >
          <Lock class="w-5 h-5 text-zinc-900 shrink-0 mt-0.5" />
          <div class="text-xs text-zinc-700 leading-relaxed">
            <strong class="text-zinc-950">100% diskrétní doručení:</strong> Balíček odesíláme v obyčejné neutrální krabici bez jakýchkoliv nápisů o tísňovém tlačítku či bezpečnosti. Vaše údaje jsou u nás v naprostém bezpečí.
          </div>
        </div>

        <!-- Submit Button -->
        <div>
          <button
            type="submit"
            id="submit-form-btn"
            class="w-full inline-flex items-center justify-center gap-3 px-8 py-4 rounded-full text-base font-semibold text-white bg-zinc-950 hover:bg-zinc-800 active:scale-[0.99] transition-all duration-200 shadow-lg hover:scale-[1.01] cursor-pointer"
          >
            <span id="submit-btn-text">Odeslat nezávaznou objednávku</span>
            <Send class="w-4 h-4" />
          </button>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("order-inquiry-form") as HTMLFormElement;
  const successState = document.getElementById("form-success-state");
  const resetBtn = document.getElementById("form-reset-btn");
  const submitBtn = document.getElementById("submit-form-btn");
  const submitBtnText = document.getElementById("submit-btn-text");
  const radioInputs = document.querySelectorAll('input[name="intent"]');
  const intentCards = document.querySelectorAll(".intent-card");

  // Handle radio selection styling
  radioInputs.forEach((input) => {
    input.addEventListener("change", (e) => {
      const target = e.target as HTMLInputElement;
      intentCards.forEach((card) => {
        card.classList.remove("border-2", "border-zinc-950", "bg-zinc-50");
        card.classList.add("border", "border-zinc-200", "bg-white");
      });
      const selectedLabel = target.closest(".intent-card");
      if (selectedLabel) {
        selectedLabel.classList.add(
          "border-2",
          "border-zinc-950",
          "bg-zinc-50",
        );
        selectedLabel.classList.remove("border-zinc-200", "bg-white");
      }
      if (submitBtnText) {
        submitBtnText.textContent =
          target.value === "order"
            ? "Odeslat nezávaznou objednávku"
            : "Odeslat dotaz / zájem o vyzkoušení";
      }
    });
  });

  if (form && successState) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      if (submitBtn) {
        submitBtn.setAttribute("disabled", "true");
        submitBtn.classList.add("opacity-70");
      }

      setTimeout(() => {
        form.classList.add("hidden");
        successState.classList.remove("hidden");
        successState.scrollIntoView({ behavior: "smooth", block: "center" });
      }, 600);
    });
  }

  if (resetBtn && form && successState) {
    resetBtn.addEventListener("click", () => {
      form.reset();
      form.classList.remove("hidden");
      successState.classList.add("hidden");
      if (submitBtn) {
        submitBtn.removeAttribute("disabled");
        submitBtn.classList.remove("opacity-70");
      }
    });
  }
</script>
