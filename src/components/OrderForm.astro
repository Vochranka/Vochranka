---
// src/components/OrderForm.astro
import {
  Send,
  ShieldCheck,
  CheckCircle2,
  Lock,
  Sparkles,
  Phone,
  Mail,
  MapPin,
  Clock,
  MessageCircle,
  Truck,
  RotateCcw,
  BadgePercent,
  HelpCircle,
  ArrowRight,
  Plus,
} from "lucide-astro";
---

<section
  id="kontakt"
  class="py-20 md:py-28 bg-white relative overflow-hidden scroll-mt-10"
>
  <!-- Invisible anchor for legacy links -->
  <div id="objednavka" class="absolute -top-16 left-0 pointer-events-none">
  </div>
  <div id="objednat" class="absolute -top-16 left-0 pointer-events-none"></div>

  <!-- Horní rohová modrá záře navazující ze sekce FAQ -->
  <div
    class="absolute -top-20 -left-20 sm:-top-24 sm:-left-24 w-60 h-60 sm:w-72 sm:h-72 md:w-80 md:h-80 rounded-full bg-gradient-to-br from-blue-500/20 via-sky-400/15 to-transparent blur-[60px] sm:blur-[70px] md:blur-[80px] pointer-events-none"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute -top-20 -right-20 sm:-top-24 sm:-right-24 w-60 h-60 sm:w-72 sm:h-72 md:w-80 md:h-80 rounded-full bg-gradient-to-bl from-blue-500/20 via-sky-400/15 to-transparent blur-[60px] sm:blur-[70px] md:blur-[80px] pointer-events-none"
    aria-hidden="true"
  >
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Top Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2
        class="text-3xl sm:text-4xl md:text-5xl font-bold font-display text-slate-950 tracking-tight"
      >
        Získejte bezpečí pro svůj salón ještě dnes.
      </h2>
      <p
        class="text-base sm:text-lg text-slate-600 mt-4 leading-relaxed max-w-2xl mx-auto"
      >
        Vyberte si složení sady, spočítejte si okamžitou cenu a odešlete
        nezávaznou poptávku. Neplatíte nic předem – zboží hradíte až při
        převzetí.
      </p>
    </div>

    <!-- 2-Column Layout: Left Form & Price Calculator, Right Direct Contacts & Trust -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
      <!-- ========================================== -->
      <!-- LEFT COLUMN (7 cols): Order Form + Live Calc -->
      <!-- ========================================== -->
      <div
        class="lg:col-span-7 bg-slate-50/80 rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-xl relative"
      >
        <!-- Live Feedback Alert (hidden by default) -->
        <div id="form-success-state" class="hidden text-center py-12">
          <div
            class="w-16 h-16 rounded-full bg-blue-600 text-white flex items-center justify-center mx-auto mb-5 shadow-lg shadow-blue-500/30"
          >
            <CheckCircle2 class="w-9 h-9 text-white" />
          </div>
          <h3
            class="text-2xl sm:text-3xl font-bold font-display text-slate-950 mb-3"
          >
            Děkujeme za vaši objednávku!
          </h3>
          <p
            class="text-sm sm:text-base text-slate-600 max-w-md mx-auto mb-6 leading-relaxed"
          >
            Vaši nezávaznou objednávku jsme v pořádku přijali. Ozveme se vám do
            2 hodin (v pracovní dny) pro potvrzení doručení a diskrétní
            odeslání.
          </p>
          <button
            id="form-reset-btn"
            type="button"
            class="inline-flex items-center justify-center px-6 py-3 rounded-xl text-xs font-semibold text-blue-700 bg-blue-50 hover:bg-blue-100 border border-blue-200 transition-colors shadow-xs cursor-pointer"
          >
            Zadat další požadavek
          </button>
        </div>

        <!-- The Interactive Form -->
        <form id="order-inquiry-form" class="space-y-7">
          <!-- KROK 1: VÝBĚR HARDWARU & PŘÍDAVNÝCH TLAČÍTEK -->
          <div>
            <div class="flex items-center justify-between mb-3">
              <label
                class="block text-xs font-bold uppercase tracking-wider text-slate-900"
              >
                Nezávazná objednávka
              </label>
            </div>

            <!-- Základní balíček (vždy aktivní) -->
            <div
              class="p-4 rounded-2xl bg-white border-2 border-blue-600 shadow-xs mb-3 flex items-center justify-between"
            >
              <div class="flex items-center gap-3">
                <div
                  class="w-9 h-9 rounded-xl bg-blue-600 flex items-center justify-center text-white shrink-0 font-bold text-sm shadow-sm"
                >
                  1×
                </div>
                <div>
                  <h4 class="text-sm font-bold text-slate-950">
                    Sada Vochranka (Siréna + 1× Tlačítko)
                  </h4>
                  <p class="text-xs text-slate-500">
                    Siréna 110 dB do zásuvky, magnetické tísňové tlačítko,
                    baterie, 3M páska
                  </p>
                </div>
              </div>
              <div class="text-right shrink-0 pl-3">
                <span class="text-sm font-bold text-blue-600">2 990 Kč</span>
                <span class="block text-[10px] text-slate-500">vč. DPH</span>
              </div>
            </div>

            <!-- Volba přídavných tlačítek -->
            <div class="p-4 rounded-2xl bg-white border border-slate-200">
              <div
                class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-3"
              >
                <div>
                  <span class="text-xs font-bold text-slate-900 block"
                    >Přejete si další tlačítka navíc?</span
                  >
                  <span class="text-[11px] text-slate-500 block"
                    >Např. jedno pod masérský stůl a druhé do kapsy nebo na
                    recepci (+690 Kč/ks)</span
                  >
                </div>
                <!-- Buttons selector -->
                <div
                  class="flex items-center gap-1.5 bg-slate-100 p-1 rounded-xl shrink-0 self-start sm:self-auto"
                >
                  <button
                    type="button"
                    class="extra-btn-opt px-3 py-1.5 rounded-lg text-xs font-bold bg-blue-600 text-white shadow-xs transition-all cursor-pointer"
                    data-count="0"
                  >
                    0 ks
                  </button>
                  <button
                    type="button"
                    class="extra-btn-opt px-3 py-1.5 rounded-lg text-xs font-medium text-slate-600 hover:text-blue-600 transition-all cursor-pointer"
                    data-count="1"
                  >
                    +1 ks
                  </button>
                  <button
                    type="button"
                    class="extra-btn-opt px-3 py-1.5 rounded-lg text-xs font-medium text-slate-600 hover:text-blue-600 transition-all cursor-pointer"
                    data-count="2"
                  >
                    +2 ks
                  </button>
                </div>
              </div>
            </div>
          </div>

          <!-- KROK 2: ŽIVÝ KALKULÁTOR CENY (Live Calculation Summary Box) -->
          <div
            class="p-5 rounded-2xl bg-white border border-blue-100 shadow-sm space-y-3"
          >
            <div
              class="flex items-center justify-between pb-2 border-b border-slate-100"
            >
              <span
                class="text-xs font-bold uppercase tracking-wider text-slate-700"
              >
                Přehled
              </span>
            </div>

            <!-- Rozpad položek -->
            <div class="space-y-1.5 text-xs text-slate-600">
              <div class="flex items-center justify-between">
                <span>Sada Vochranka:</span>
                <span class="font-medium text-slate-900">2 990 Kč</span>
              </div>
              <div
                class="flex items-center justify-between"
                id="row-extra-buttons"
              >
                <span
                  >Přídavná tlačítka (<span id="label-extra-count">0 ks</span
                  >):</span
                >
                <span class="font-medium text-slate-900" id="label-extra-price"
                  >0 Kč</span
                >
              </div>
              <div class="flex items-center justify-between">
                <span class="flex items-center gap-1">
                  <span
                    >Roční provoz & neomezené SOS SMS (cca 82 Kč/měsíc):</span
                  >
                </span>
                <span class="font-medium text-slate-900">990 Kč / rok</span>
              </div>
            </div>

            <!-- Celkový součet -->
            <div
              class="pt-3 border-t border-slate-200 flex items-baseline justify-between"
            >
              <div>
                <span
                  class="text-xs font-bold uppercase tracking-wider text-slate-900 block"
                  >Celková částka</span
                >
                <span class="text-[11px] text-slate-500"
                  >včetně DPH, dopravy a ročního provozu</span
                >
              </div>
              <div class="text-right">
                <span
                  id="calc-total-display"
                  class="text-2xl sm:text-3xl font-extrabold font-display text-blue-600 tracking-tight"
                >
                  3 980 Kč
                </span>
              </div>
            </div>
          </div>

          <!-- KROK 3: DORUČOVACÍ & KONTAKTNÍ ÚDAJE -->
          <div class="space-y-4">
            <!-- Jméno & Salón -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label
                  for="name"
                  class="block text-xs font-semibold text-slate-800 mb-1"
                >
                  Vaše jméno a příjmení *
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="Např. Lenka Dvořáková"
                  class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:border-blue-600 focus:ring-2 focus:ring-blue-100 outline-none text-sm text-slate-900 bg-white transition-all"
                />
              </div>

              <div>
                <label
                  for="salon"
                  class="block text-xs font-semibold text-slate-800 mb-1"
                >
                  Název salónu / studia *
                </label>
                <input
                  type="text"
                  id="salon"
                  name="salon"
                  required
                  placeholder="Např. Masáže Harmonie"
                  class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:border-blue-600 focus:ring-2 focus:ring-blue-100 outline-none text-sm text-slate-900 bg-white transition-all"
                />
              </div>
            </div>

            <!-- Telefon & E-mail -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label
                  for="phone"
                  class="block text-xs font-semibold text-slate-800 mb-1"
                >
                  Telefonní číslo (pro potvrzení) *
                </label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  required
                  placeholder="+420 777 123 456"
                  class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:border-blue-600 focus:ring-2 focus:ring-blue-100 outline-none text-sm text-slate-900 bg-white transition-all"
                />
              </div>

              <div>
                <label
                  for="email"
                  class="block text-xs font-semibold text-slate-800 mb-1"
                >
                  E-mailová adresa *
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="lenka@studio-harmonie.cz"
                  class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:border-blue-600 focus:ring-2 focus:ring-blue-100 outline-none text-sm text-slate-900 bg-white transition-all"
                />
              </div>
            </div>

            <!-- Doručovací adresa / Poznámka -->
            <div>
              <label
                for="address"
                class="block text-xs font-semibold text-slate-800 mb-1"
              >
                Doručovací adresa
              </label>
              <textarea
                id="address"
                name="address"
                rows="2"
                placeholder="Uveďte adresu salónu nebo název výdejního místa Zásilkovny. Zde můžete připsat i případný dotaz..."
                class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:border-blue-600 focus:ring-2 focus:ring-blue-100 outline-none text-sm text-slate-900 bg-white transition-all resize-none"
              ></textarea>
            </div>

            <!-- Checkbox: Osobní předvedení v Praze -->
            <label
              class="flex items-start gap-3 p-3 rounded-xl bg-white border border-slate-200 cursor-pointer hover:bg-slate-50 transition-colors"
            >
              <input
                type="checkbox"
                id="trial-checkbox"
                name="trial_request"
                class="mt-1 rounded text-blue-600 focus:ring-blue-400"
              />
              <div class="text-xs leading-relaxed">
                <strong class="text-slate-950 block"
                  >Mám zájem o bezplatné předvedení přímo v salónu (pouze Praha
                  a okolí)</strong
                >
                <span class="text-slate-500"
                  >Přijedeme za vámi, sadu ukážeme v praxi na 5 minut a sami se
                  rozhodnete.</span
                >
              </div>
            </label>
          </div>
          <!-- Odesílací tlačítko s dynamickou cenou -->
          <div>
            <button
              type="submit"
              id="submit-form-btn"
              class="w-full inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-full text-base font-bold text-white bg-blue-600 hover:bg-blue-700 active:scale-[0.99] transition-all duration-200 shadow-xl shadow-blue-600/30 hover:scale-[1.01] cursor-pointer"
            >
              <span id="submit-btn-label"
                >Nezávazně objednat sadu (3 980 Kč)</span
              >
              <ArrowRight class="w-4 h-4" />
            </button>
            <p class="text-[11px] text-slate-500 text-center mt-2.5">
              Odesláním objednávky souhlasíte se zpracováním údajů pro doručení.
              14 dní záruka vrácení peněz.
            </p>
          </div>
        </form>
      </div>

      <!-- ========================================== -->
      <!-- RIGHT COLUMN (5 cols): Direct Contacts & Trust -->
      <!-- ========================================== -->
      <div class="lg:col-span-5 space-y-6 text-left">
        <!-- DIRECT CONTACT CARD -->
        <div
          class="rounded-3xl bg-gradient-to-br from-[#071328] via-[#0c2040] to-[#081832] text-white p-6 sm:p-8 shadow-xl border border-blue-900/40 relative overflow-hidden"
        >
          <div class="relative z-10 space-y-6">
            <div>
              <h3 class="text-2xl font-bold font-display text-white">
                Rádi vám poradíme nebo sadu předvedeme.
              </h3>
              <p class="text-xs sm:text-sm text-blue-200/70 mt-2 leading-relaxed">
                Máte dotaz? Ozvěte se nám přímo – mluvíte vždy přímo s naším
                českým týmem.
              </p>
            </div>

            <div class="space-y-3 pt-2">
              <!-- Telefon -->
              <a
                href="tel:+420777123456"
                class="flex items-center gap-3.5 p-3.5 rounded-2xl bg-white/10 hover:bg-blue-900/40 border border-white/10 hover:border-blue-400/30 transition-colors group"
              >
                <div
                  class="w-10 h-10 rounded-xl bg-blue-600 text-white flex items-center justify-center shrink-0 shadow-sm"
                >
                  <Phone class="w-5 h-5 text-white" />
                </div>
                <div>
                  <span class="text-[11px] text-blue-200/70 block font-medium"
                    >Telefonní linka (Po–Pá 9–18h)</span
                  >
                  <span
                    class="text-base font-bold text-white group-hover:text-blue-200 transition-colors"
                  >
                    +420 777 123 456
                  </span>
                </div>
              </a>

              <!-- E-mail -->
              <a
                href="mailto:info@vochranka.cz"
                class="flex items-center gap-3.5 p-3.5 rounded-2xl bg-white/10 hover:bg-blue-900/40 border border-white/10 hover:border-blue-400/30 transition-colors group"
              >
                <div
                  class="w-10 h-10 rounded-xl bg-blue-600 text-white flex items-center justify-center shrink-0 shadow-sm"
                >
                  <Mail class="w-5 h-5 text-white" />
                </div>
                <div>
                  <span class="text-[11px] text-blue-200/70 block font-medium"
                    >Oficiální e-mail</span
                  >
                  <span
                    class="text-base font-bold text-white group-hover:text-blue-200 transition-colors"
                  >
                    info@vochranka.cz
                  </span>
                </div>
              </a>

              <!-- Osobní zkouška v Praze -->
              <div
                class="flex items-center gap-3.5 p-3.5 rounded-2xl bg-white/5 border border-white/10"
              >
                <div
                  class="w-10 h-10 rounded-xl bg-blue-500/20 text-blue-300 flex items-center justify-center shrink-0"
                >
                  <MapPin class="w-5 h-5 text-blue-300" />
                </div>
                <div>
                  <span class="text-[11px] text-blue-200/70 block font-medium"
                    >Osobní zkoušky v salónech</span
                  >
                  <span class="text-sm font-semibold text-white">
                    Praha a Středočeský kraj (přijedeme k vám)
                  </span>
                </div>
              </div>
            </div>

            <!-- Provozní doba -->
            <div
              class="pt-2 border-t border-blue-900/40 text-xs text-blue-200/60 flex items-center gap-2"
            >
              <Clock class="w-4 h-4 text-blue-300" />
              <span>Odpovídáme v průměru do 2 hodin v pracovní dny</span>
            </div>
          </div>
        </div>

        <!-- 4 SILNÉ DŮVODY PROČ OBJEDNAT HNED -->
        <div
          class="rounded-3xl bg-slate-50/80 p-6 sm:p-7 border border-slate-200/90 shadow-sm space-y-4"
        >
          <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900">
            Proč si Vochranku pořídit ještě dnes:
          </h4>

          <div class="space-y-3 text-xs sm:text-sm text-slate-700">
            <div class="flex items-start gap-3">
              <div
                class="w-7 h-7 rounded-lg bg-blue-50 border border-blue-200 flex items-center justify-center shrink-0 mt-0.5 text-blue-600"
              >
                <RotateCcw class="w-4 h-4 text-blue-600" />
              </div>
              <div>
                <strong class="text-slate-950 block"
                  >14 dní na vyzkoušení bez rizika</strong
                >
                <p class="text-slate-500 text-xs mt-0.5">
                  Nainstalujte si ji do salónu. Pokud nebudete 100% spokojena,
                  vrátíme vám plnou částku.
                </p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div
                class="w-7 h-7 rounded-lg bg-blue-50 border border-blue-200 flex items-center justify-center shrink-0 mt-0.5 text-blue-600"
              >
                <Truck class="w-4 h-4 text-blue-600" />
              </div>
              <div>
                <strong class="text-slate-950 block"
                  >Doručení do 24–48 hodin</strong
                >
                <p class="text-slate-500 text-xs mt-0.5">
                  Sady máme skladem v ČR. Odesíláme obratem Zásilkovnou i
                  kurýrem zdarma.
                </p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div
                class="w-7 h-7 rounded-lg bg-blue-50 border border-blue-200 flex items-center justify-center shrink-0 mt-0.5 text-blue-600"
              >
                <ShieldCheck class="w-4 h-4 text-blue-600" />
              </div>
              <div>
                <strong class="text-slate-950 block"
                  >Žádné skryté poplatky</strong
                >
                <p class="text-slate-500 text-xs mt-0.5">
                  Hardware je trvale váš. Provoz zahrnuje neomezené SMS a
                  nepřetržitý monitoring.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Firemní fakturační údaje -->
        <div class="px-3 text-[11px] text-slate-400 space-y-1">
          <p><strong>Provozovatel:</strong> Vochranka • IČO: 19842531</p>
          <p>Sídlo v Praze, Česká republika. Zboží s plnou 2letou zárukou.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Price Calculator Logic
  const BASE_KIT_PRICE = 2990;
  const ANNUAL_SERVICE_PRICE = 990;
  const EXTRA_BUTTON_PRICE = 690;

  let extraCount = 0;

  const extraBtnOptions = document.querySelectorAll(".extra-btn-opt");
  const labelExtraCount = document.getElementById("label-extra-count");
  const labelExtraPrice = document.getElementById("label-extra-price");
  const calcTotalDisplay = document.getElementById("calc-total-display");
  const submitBtnLabel = document.getElementById("submit-btn-label");
  const trialCheckbox = document.getElementById(
    "trial-checkbox",
  ) as HTMLInputElement;

  function updatePrice() {
    const hardwareTotal = BASE_KIT_PRICE + extraCount * EXTRA_BUTTON_PRICE;
    const grandTotal = hardwareTotal + ANNUAL_SERVICE_PRICE;

    if (labelExtraCount) labelExtraCount.textContent = `${extraCount} ks`;
    if (labelExtraPrice)
      labelExtraPrice.textContent = `${extraCount * EXTRA_BUTTON_PRICE} Kč`;

    if (calcTotalDisplay) {
      calcTotalDisplay.textContent = `${grandTotal.toLocaleString("cs-CZ")} Kč`;
    }

    if (submitBtnLabel) {
      if (trialCheckbox && trialCheckbox.checked) {
        submitBtnLabel.textContent = "Objednat bezplatné předvedení v Praze";
      } else {
        submitBtnLabel.textContent = `Nezávazně objednat sadu (${grandTotal.toLocaleString("cs-CZ")} Kč)`;
      }
    }
  }

  extraBtnOptions.forEach((btn) => {
    btn.addEventListener("click", () => {
      extraBtnOptions.forEach((b) => {
        b.classList.remove(
          "bg-blue-600",
          "text-white",
          "shadow-xs",
          "font-bold",
        );
        b.classList.add("text-slate-600", "font-medium");
      });

      btn.classList.remove("text-slate-600", "font-medium");
      btn.classList.add("bg-blue-600", "text-white", "shadow-xs", "font-bold");

      extraCount = parseInt(btn.getAttribute("data-count") || "0", 10);
      updatePrice();
    });
  });

  trialCheckbox?.addEventListener("change", () => {
    updatePrice();
  });

  // Form Submission
  const orderForm = document.getElementById(
    "order-inquiry-form",
  ) as HTMLFormElement;
  const successState = document.getElementById("form-success-state");
  const resetBtn = document.getElementById("form-reset-btn");
  const submitBtn = document.getElementById("submit-form-btn");

  if (orderForm && successState) {
    orderForm.addEventListener("submit", (e) => {
      e.preventDefault();
      if (submitBtn) {
        submitBtn.setAttribute("disabled", "true");
        submitBtn.classList.add("opacity-70");
      }

      setTimeout(() => {
        orderForm.classList.add("hidden");
        successState.classList.remove("hidden");
        successState.scrollIntoView({ behavior: "smooth", block: "center" });
      }, 500);
    });
  }

  if (resetBtn && orderForm && successState) {
    resetBtn.addEventListener("click", () => {
      orderForm.reset();
      extraCount = 0;
      extraBtnOptions.forEach((b, idx) => {
        if (idx === 0) {
          b.classList.add(
            "bg-blue-600",
            "text-white",
            "shadow-xs",
            "font-bold",
          );
          b.classList.remove("text-slate-600", "font-medium");
        } else {
          b.classList.remove(
            "bg-blue-600",
            "text-white",
            "shadow-xs",
            "font-bold",
          );
          b.classList.add("text-slate-600", "font-medium");
        }
      });
      updatePrice();
      orderForm.classList.remove("hidden");
      successState.classList.add("hidden");
      if (submitBtn) {
        submitBtn.removeAttribute("disabled");
        submitBtn.classList.remove("opacity-70");
      }
    });
  }
</script>
