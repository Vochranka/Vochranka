---
// src/components/OrderForm.astro
import {
  Phone,
  Mail,
  MapPin,
  ArrowRight,
  CheckCircle2,
} from "lucide-astro";
---

<section
  id="kontakt"
  class="py-24 md:py-32 bg-white border-t border-zinc-200/80 relative scroll-mt-10"
>
  <div id="objednavka" class="absolute -top-16 left-0 pointer-events-none"></div>
  <div id="objednat" class="absolute -top-16 left-0 pointer-events-none"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-2xl mx-auto text-center mb-16">
      <p class="text-xs font-mono uppercase tracking-widest text-zinc-400 mb-3">
        Nezávazná objednávka & kontakt
      </p>
      <h2
        class="text-3xl sm:text-4xl md:text-5xl font-bold font-display text-zinc-950 tracking-tight"
      >
        Objednejte si sadu do salónu.
      </h2>
      <p class="text-base sm:text-lg text-zinc-600 mt-4 leading-relaxed">
        Neplatíte nic předem. Před odesláním se vám ozveme a vše potvrdíme. Máte 14 dní na to si sadu v klidu vyzkoušet přímo ve své praxi.
      </p>
    </div>

    <!-- 2 Columns: Order Form + Calculator (Left) & Direct Contacts (Right) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
      
      <!-- ========================================== -->
      <!-- LEFT: Order Form & Live Price Calculator   -->
      <!-- ========================================== -->
      <div class="lg:col-span-7 bg-zinc-50 rounded-3xl p-6 sm:p-9 border border-zinc-200/90 relative">
        
        <!-- Success Confirmation State -->
        <div id="form-success-state" class="hidden text-center py-12">
          <div
            class="w-12 h-12 rounded-full bg-zinc-950 text-white flex items-center justify-center mx-auto mb-4"
          >
            <CheckCircle2 class="w-6 h-6 text-white" />
          </div>
          <h3 class="text-2xl font-bold font-display text-zinc-950 mb-2">
            Objednávka přijata
          </h3>
          <p class="text-sm text-zinc-600 max-w-sm mx-auto mb-6">
            Děkujeme. Ozveme se vám do 2 hodin pro potvrzení doručení a sadu vám diskrétně odešleme.
          </p>
          <button
            id="form-reset-btn"
            type="button"
            class="px-5 py-2.5 rounded-xl text-xs font-semibold text-zinc-900 bg-white border border-zinc-200 cursor-pointer hover:bg-zinc-100"
          >
            Zadat další požadavek
          </button>
        </div>

        <!-- The Form -->
        <form id="order-inquiry-form" class="space-y-6">
          
          <!-- Extra Button Selector -->
          <div class="p-4 rounded-2xl bg-white border border-zinc-200/80">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              <div>
                <span class="text-sm font-bold text-zinc-950 block">Sada Vochranka (2 990 Kč)</span>
                <span class="text-xs text-zinc-500 block mt-0.5">1× siréna do zásuvky, 1× tísňové tlačítko, baterie, 3M páska</span>
              </div>
              <div class="flex items-center gap-1 bg-zinc-100 p-1 rounded-xl shrink-0">
                <button
                  type="button"
                  class="extra-btn-opt px-3 py-1.5 rounded-lg text-xs font-bold bg-white text-zinc-950 shadow-xs cursor-pointer"
                  data-count="0"
                >
                  Základ
                </button>
                <button
                  type="button"
                  class="extra-btn-opt px-3 py-1.5 rounded-lg text-xs font-medium text-zinc-500 hover:text-zinc-950 cursor-pointer"
                  data-count="1"
                >
                  +1 tlačítko
                </button>
                <button
                  type="button"
                  class="extra-btn-opt px-3 py-1.5 rounded-lg text-xs font-medium text-zinc-500 hover:text-zinc-950 cursor-pointer"
                  data-count="2"
                >
                  +2 tlačítka
                </button>
              </div>
            </div>
          </div>

          <!-- Live Price Breakdown -->
          <div class="p-4 rounded-2xl bg-white border border-zinc-200/80 space-y-2 text-xs">
            <div class="flex justify-between text-zinc-600">
              <span>Hardware (siréna + tísňové tlačítko):</span>
              <span class="text-zinc-950 font-medium">2 990 Kč</span>
            </div>
            <div class="flex justify-between text-zinc-600" id="extra-calc-row">
              <span>Přídavná tlačítka (<span id="label-extra-count">0 ks</span>):</span>
              <span class="text-zinc-950 font-medium" id="label-extra-price">0 Kč</span>
            </div>
            <div class="flex justify-between text-zinc-600">
              <span>Roční SIM & neomezené nouzové SMS:</span>
              <span class="text-zinc-950 font-medium">990 Kč / rok</span>
            </div>
            <div class="flex justify-between text-zinc-600">
              <span>Diskrétní doručení Zásilkovnou:</span>
              <span class="text-zinc-950 font-bold">Zdarma</span>
            </div>
            <div class="pt-3 border-t border-zinc-100 flex items-baseline justify-between">
              <div>
                <span class="text-xs font-bold text-zinc-950 block">Celkem k úhradě</span>
                <span class="text-[11px] text-zinc-400">Platíte až při převzetí (dobírkou nebo na fakturu)</span>
              </div>
              <span id="calc-total-display" class="text-2xl font-bold font-display text-zinc-950">
                3 980 Kč
              </span>
            </div>
          </div>

          <!-- Input Fields -->
          <div class="space-y-3">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label for="name" class="block text-xs font-medium text-zinc-700 mb-1">Jméno a příjmení *</label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="Lenka Dvořáková"
                  class="w-full px-3.5 py-2.5 rounded-xl border border-zinc-200 focus:border-zinc-950 outline-none text-sm bg-white"
                />
              </div>
              <div>
                <label for="salon" class="block text-xs font-medium text-zinc-700 mb-1">Název salónu / studia *</label>
                <input
                  type="text"
                  id="salon"
                  name="salon"
                  required
                  placeholder="Masáže Harmonie"
                  class="w-full px-3.5 py-2.5 rounded-xl border border-zinc-200 focus:border-zinc-950 outline-none text-sm bg-white"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label for="phone" class="block text-xs font-medium text-zinc-700 mb-1">Telefonní číslo *</label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  required
                  placeholder="+420 777 123 456"
                  class="w-full px-3.5 py-2.5 rounded-xl border border-zinc-200 focus:border-zinc-950 outline-none text-sm bg-white"
                />
              </div>
              <div>
                <label for="email" class="block text-xs font-medium text-zinc-700 mb-1">E-mail *</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="lenka@harmonie.cz"
                  class="w-full px-3.5 py-2.5 rounded-xl border border-zinc-200 focus:border-zinc-950 outline-none text-sm bg-white"
                />
              </div>
            </div>

            <div>
              <label for="address" class="block text-xs font-medium text-zinc-700 mb-1">Doručovací adresa nebo výdejní místo Zásilkovny</label>
              <input
                type="text"
                id="address"
                name="address"
                placeholder="Ulice, město nebo název Zásilkovny..."
                class="w-full px-3.5 py-2.5 rounded-xl border border-zinc-200 focus:border-zinc-950 outline-none text-sm bg-white"
              />
            </div>
          </div>

          <!-- Submit Button -->
          <div>
            <button
              type="submit"
              id="submit-form-btn"
              class="w-full inline-flex items-center justify-center gap-2 px-8 py-4 rounded-full text-sm font-bold text-white bg-zinc-950 hover:bg-zinc-800 active:scale-[0.99] transition-all cursor-pointer shadow-sm hover:scale-[1.01]"
            >
              <span id="submit-btn-label">Odeslat nezávaznou objednávku (3 980 Kč)</span>
              <ArrowRight class="w-4 h-4" />
            </button>
            <p class="text-[11px] text-zinc-400 text-center mt-3">
              14 dní záruka vrácení peněz • 100% diskrétní balení v neutrální krabici • Neplatíte nic předem
            </p>
          </div>

        </form>
      </div>

      <!-- ========================================== -->
      <!-- RIGHT: Human Contacts & Personal Trial     -->
      <!-- ========================================== -->
      <div class="lg:col-span-5 space-y-6 text-left">
        
        <div class="space-y-2">
          <h3 class="text-xl font-bold font-display text-zinc-950">
            Máte dotaz nebo chcete sadu předvést?
          </h3>
          <p class="text-sm text-zinc-600 leading-relaxed">
            Zavolejte nám nebo napište. Zvedáme to my, žádný automat.
          </p>
        </div>

        <div class="space-y-3">
          <!-- Telefon -->
          <a
            href="tel:+420777123456"
            class="flex items-center gap-3.5 p-4 rounded-2xl bg-zinc-50 border border-zinc-200/80 hover:border-zinc-300 transition-colors group"
          >
            <div class="w-10 h-10 rounded-xl bg-white border border-zinc-200 flex items-center justify-center text-zinc-950 shrink-0">
              <Phone class="w-4 h-4 text-zinc-950" />
            </div>
            <div>
              <span class="text-[11px] text-zinc-400 block font-medium">Telefonní linka (Po–Pá 9:00–18:00)</span>
              <span class="text-sm font-bold text-zinc-950 group-hover:text-zinc-600 transition-colors">+420 777 123 456</span>
            </div>
          </a>

          <!-- E-mail -->
          <a
            href="mailto:info@vochranka.cz"
            class="flex items-center gap-3.5 p-4 rounded-2xl bg-zinc-50 border border-zinc-200/80 hover:border-zinc-300 transition-colors group"
          >
            <div class="w-10 h-10 rounded-xl bg-white border border-zinc-200 flex items-center justify-center text-zinc-950 shrink-0">
              <Mail class="w-4 h-4 text-zinc-950" />
            </div>
            <div>
              <span class="text-[11px] text-zinc-400 block font-medium">E-mail</span>
              <span class="text-sm font-bold text-zinc-950 group-hover:text-zinc-600 transition-colors">info@vochranka.cz</span>
            </div>
          </a>

          <!-- Osobní vyzkoušení po Praze -->
          <div class="p-4 rounded-2xl bg-zinc-50 border border-zinc-200/80 space-y-1">
            <div class="flex items-center gap-2 text-zinc-950 font-bold text-xs">
              <MapPin class="w-3.5 h-3.5 text-zinc-950 shrink-0" />
              <span>Osobní předvedení po Praze</span>
            </div>
            <p class="text-xs text-zinc-600 leading-relaxed pl-5">
              Pokud máte salón v Praze a okolí, rádi se za vámi na 5 minut zastavíme a tlačítko vám nezávazně předvedeme přímo na vašem lehátku nebo stolku.
            </p>
          </div>
        </div>

        <!-- Direct assurances -->
        <div class="pt-2 text-xs text-zinc-500 space-y-2 border-t border-zinc-100">
          <p>✓ <strong>Expedice do 24 hodin</strong> – Sady máme skladem v ČR.</p>
          <p>✓ <strong>Plná 2letá záruka</strong> – V případě jakéhokoliv problému okamžitá výměna kus za kus.</p>
          <p>✓ <strong>14denní zkušební lhůta</strong> – Pokud vám tlačítko nesedne, vrátíme vám 100 % peněz.</p>
        </div>

      </div>

    </div>

  </div>
</section>

<script>
  const BASE_KIT_PRICE = 2990;
  const ANNUAL_SERVICE_PRICE = 990;
  const EXTRA_BUTTON_PRICE = 690;

  let extraCount = 0;

  const extraBtnOptions = document.querySelectorAll(".extra-btn-opt");
  const labelExtraCount = document.getElementById("label-extra-count");
  const labelExtraPrice = document.getElementById("label-extra-price");
  const calcTotalDisplay = document.getElementById("calc-total-display");
  const submitBtnLabel = document.getElementById("submit-btn-label");

  function updatePrice() {
    const hardwareTotal = BASE_KIT_PRICE + (extraCount * EXTRA_BUTTON_PRICE);
    const grandTotal = hardwareTotal + ANNUAL_SERVICE_PRICE;

    if (labelExtraCount) labelExtraCount.textContent = `${extraCount} ks`;
    if (labelExtraPrice) labelExtraPrice.textContent = `${extraCount * EXTRA_BUTTON_PRICE} Kč`;
    
    if (calcTotalDisplay) {
      calcTotalDisplay.textContent = `${grandTotal.toLocaleString("cs-CZ")} Kč`;
    }

    if (submitBtnLabel) {
      submitBtnLabel.textContent = `Odeslat nezávaznou objednávku (${grandTotal.toLocaleString("cs-CZ")} Kč)`;
    }
  }

  extraBtnOptions.forEach((btn) => {
    btn.addEventListener("click", () => {
      extraBtnOptions.forEach((b) => {
        b.classList.remove("bg-white", "text-zinc-950", "shadow-xs", "font-bold");
        b.classList.add("text-zinc-500", "font-medium");
      });

      btn.classList.remove("text-zinc-500", "font-medium");
      btn.classList.add("bg-white", "text-zinc-950", "shadow-xs", "font-bold");

      extraCount = parseInt(btn.getAttribute("data-count") || "0", 10);
      updatePrice();
    });
  });

  // Form submit
  const orderForm = document.getElementById("order-inquiry-form") as HTMLFormElement;
  const successState = document.getElementById("form-success-state");
  const resetBtn = document.getElementById("form-reset-btn");
  const submitBtn = document.getElementById("submit-form-btn");

  if (orderForm && successState) {
    orderForm.addEventListener("submit", (e) => {
      e.preventDefault();
      if (submitBtn) {
        submitBtn.setAttribute("disabled", "true");
        submitBtn.classList.add("opacity-70");
      }

      setTimeout(() => {
        orderForm.classList.add("hidden");
        successState.classList.remove("hidden");
        successState.scrollIntoView({ behavior: "smooth", block: "center" });
      }, 400);
    });
  }

  if (resetBtn && orderForm && successState) {
    resetBtn.addEventListener("click", () => {
      orderForm.reset();
      extraCount = 0;
      extraBtnOptions.forEach((b, idx) => {
        if (idx === 0) {
          b.classList.add("bg-white", "text-zinc-950", "shadow-xs", "font-bold");
          b.classList.remove("text-zinc-500", "font-medium");
        } else {
          b.classList.remove("bg-white", "text-zinc-950", "shadow-xs", "font-bold");
          b.classList.add("text-zinc-500", "font-medium");
        }
      });
      updatePrice();
      orderForm.classList.remove("hidden");
      successState.classList.add("hidden");
      if (submitBtn) {
        submitBtn.removeAttribute("disabled");
        submitBtn.classList.remove("opacity-70");
      }
    });
  }
</script>
